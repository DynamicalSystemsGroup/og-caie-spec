@prefix ogc: <https://w3id.org/og-caie/> .
@prefix ogm: <https://w3id.org/og-caie/model#> .
@prefix rul: <https://w3id.org/og-caie/rulings#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Z's block-by-block and wire-by-wire validation of the model (concern C-30,
# ruling R-48, sheet 07-09). One row per validated part kind or wire, named
# as in model/og-caie.model.ttl; scripts/render.py renders sheet 05 from the
# model graph and reads the ticks here, so regeneration never loses them.
# A validated name that no longer exists in the model is reported by the
# tests as stale.

ogm:validation-SponsorOrganization a ogc:Validation ; ogc:validates "SponsorOrganization" ; ogc:validatedBy rul:Z ; ogc:validatedOn "2026-09-06"^^xsd:date ; ogc:via "walkthrough popup, block 1 of 11" .
ogm:validation-acceptanceSeam a ogc:Validation ; ogc:validates "acceptanceSeam" ; ogc:validatedBy rul:Z ; ogc:validatedOn "2026-09-06"^^xsd:date .
