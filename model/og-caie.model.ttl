elmt:OGCAIE__ContractingProcess
    a sysml:ActionDefinition ;
    sysml:declaredName "ContractingProcess" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::ContractingProcess" .

elmt:OGCAIE__ContractingProcess___400
    a sysml:Documentation ;
    sysml:body """ The contracting lifecycle: each step citing its own canon
           under one agreement (sheet 10-22): the SEBoK's business or
           mission analysis and account of proposals, ISO/IEC/IEEE 15288's agreement
           processes for the agreement itself, ISO 9000's contract, the
           29119-2 test environment and completion report, SEVOCAB's
           acceptance (rulings R-32, R-50). One
           nested model (ruling R-33): the fulfil step is a black box typed
           by the EvaluationProcess, whose inputs are what the contract
           pinned and whose outputs are what the delivery carries; its
           definition below is the drill-down, and it conforms to that
           interface by typing. The flows say which item goes where. """ ;
    sysml:owner elmt:OGCAIE__ContractingProcess ;
    sysml:qualifiedName "OGCAIE::ContractingProcess::@0" .

elmt:OGCAIE__ContractingProcess___4010
    a sysml:SuccessionAsUsage ;
    ogm:first elmt:OGCAIE__ContractingProcess__agree ;
    ogm:then elmt:OGCAIE__ContractingProcess__access ;
    sysml:owner elmt:OGCAIE__ContractingProcess ;
    sysml:qualifiedName "OGCAIE::ContractingProcess::@10" ;
    sysx:relatedFeature expr:OGCAIE__ContractingProcess___4010_pend0, expr:OGCAIE__ContractingProcess___4010_pend1 ;
    sysx:sourceText "succession first agree then access;" .

