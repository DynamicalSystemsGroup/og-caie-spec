    sysml:isConjugated "true"^^xsd:boolean ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::proposalIn" ;
    sysml:type elmt:OGCAIE__ProposalWrite .

