elmt:OGCAIE__ReportApproval___400
    a sysml:Documentation ;
    sysml:body """ A domain expert's approval of the final report's contents
           after the machine verdict: correct construction is not enough
           (walkthrough, R-49). Pinned within the evaluation. """ ;
    sysml:owner elmt:OGCAIE__ReportApproval ;
    sysml:qualifiedName "OGCAIE::ReportApproval::@0" .

