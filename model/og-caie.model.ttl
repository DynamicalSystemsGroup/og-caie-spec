    a sysml:PortUsage ;
    sysml:declaredName "missionOut" ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::missionOut" ;
    sysml:type elmt:OGCAIE__MissionWrite .

elmt:OGCAIE__SponsorOrganization__needOut
    a sysml:PortUsage ;
    sysml:declaredName "needOut" ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::needOut" ;
    sysml:type elmt:OGCAIE__NeedWrite .

