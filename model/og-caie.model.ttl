    sysml:qualifiedName "OGCAIE::SponsorOrganization::statementOfWorkOut" ;
    sysml:type elmt:OGCAIE__StatementOfWorkWrite .

elmt:OGCAIE__SponsorSignatory
    a sysml:PartDefinition ;
    sysml:declaredName "SponsorSignatory" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::SponsorSignatory" ;
    sysml:specializes elmt:OGCAIE__Person .

elmt:OGCAIE__SponsorSignatory___400
    a sysml:Documentation ;
    sysml:body """ The sponsor's signatory: a named person acting on behalf of the
           sponsor organization, the acquirer's authorized representative in
           SEVOCAB's acceptance (sheet 10-06, R-50). Signs the agreement,
           declares the sponsor's user interest, approves the requirement
           set, and accepts the delivery. The worked example's county health
           officer. """ ;
    sysml:owner elmt:OGCAIE__SponsorSignatory ;
    sysml:qualifiedName "OGCAIE::SponsorSignatory::@0" .

elmt:OGCAIE__SponsorSignatory__acceptanceOut
    a sysml:PortUsage ;
    sysml:declaredName "acceptanceOut" ;
    sysml:owner elmt:OGCAIE__SponsorSignatory ;
    sysml:qualifiedName "OGCAIE::SponsorSignatory::acceptanceOut" ;
    sysml:type elmt:OGCAIE__AcceptanceWrite .

elmt:OGCAIE__SponsorSignatory__agreementOut
    a sysml:PortUsage ;
    sysml:declaredName "agreementOut" ;
    sysml:owner elmt:OGCAIE__SponsorSignatory ;
    sysml:qualifiedName "OGCAIE::SponsorSignatory::agreementOut" ;
    sysml:type elmt:OGCAIE__AgreementWrite .

elmt:OGCAIE__SponsorSignatory__requirementSetApprovalOut
