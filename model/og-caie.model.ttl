elmt:OGCAIE__StatementOfWork___400
    a sysml:Documentation ;
    sysml:body """ The sponsor's scope-of-work decisions under the contract (SEVOCAB
           statement of work): for each affected population, interview or
           representation. A boundary item between the contract and its
           fulfilment (ruling R-40): decided with the agreement, consumed by
           the scope step. Pinned at the contract. """ ;
    sysml:owner elmt:OGCAIE__StatementOfWork ;
    sysml:qualifiedName "OGCAIE::StatementOfWork::@0" .

elmt:OGCAIE__StatementOfWork__engagement
    a sysml:AttributeUsage ;
    sysml:declaredName "engagement" ;
    sysml:lowerBound expr:OGCAIE__StatementOfWork__engagement_plowerBound ;
    sysml:owner elmt:OGCAIE__StatementOfWork ;
    sysml:qualifiedName "OGCAIE::StatementOfWork::engagement" ;
    sysml:type elmt:OGCAIE__Engagement ;
    sysml:upperBound expr:OGCAIE__StatementOfWork__engagement_pupperBound .

elmt:OGCAIE__StatementOfWork__id
    a sysml:AttributeUsage ;
