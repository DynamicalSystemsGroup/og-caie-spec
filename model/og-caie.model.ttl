elmt:OGCAIE__ServiceAgreement
    a sysml:ItemDefinition ;
    sysml:declaredName "ServiceAgreement" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::ServiceAgreement" .

elmt:OGCAIE__ServiceAgreement___400
    a sysml:Documentation ;
    sysml:body """ The contract (ISO 9000:2026 3.3.13) between the sponsor
           organization and the testing organization to perform OG-CAIE
           as a service, signed by the sponsor and by the testing
           organization's account executive (rulings R-21, R-23). """ ;
    sysml:owner elmt:OGCAIE__ServiceAgreement ;
    sysml:qualifiedName "OGCAIE::ServiceAgreement::@0" .

elmt:OGCAIE__ServiceAgreement__id
    a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__ServiceAgreement ;
    sysml:qualifiedName "OGCAIE::ServiceAgreement::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__Session
    a sysml:ItemDefinition ;
    sysml:declaredName "Session" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::Session" .

elmt:OGCAIE__Session___400
    a sysml:Documentation ;
    sysml:body """ One operator paired with the test item; its ordered turns
           form a trajectory (NIST AI 700-2; IEC 60050-351; R-13). """ ;
    sysml:owner elmt:OGCAIE__Session ;
    sysml:qualifiedName "OGCAIE::Session::@0" .

elmt:OGCAIE__Session__id
    a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__Session ;
    sysml:qualifiedName "OGCAIE::Session::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__SponsorOrganization
    a sysml:PartDefinition ;
    sysml:declaredName "SponsorOrganization" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization" ;
    sysml:specializes elmt:OGCAIE__Organization .

elmt:OGCAIE__SponsorOrganization___400
    a sysml:Documentation ;
    sysml:body """ The customer (ISO 9000:2026 3.9.1): states the need,
           receives the proposal, commissions the evaluation under the
           service agreement, receives the delivery through the account
           executive and accepts it (R-32). May or may not be the
           accountable organization; the record says. """ ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::@0" .

elmt:OGCAIE__SponsorOrganization__acceptanceOut
    a sysml:PortUsage ;
    sysml:declaredName "acceptanceOut" ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::acceptanceOut" ;
    sysml:type elmt:OGCAIE__AcceptanceWrite .

