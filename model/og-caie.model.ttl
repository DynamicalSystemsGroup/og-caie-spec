elmt:OGCAIE__ConformanceVerdict___400
    a sysml:Documentation ;
    sysml:body """ The conformance checker's verdict on the record: correctly
           constructed to the shapes, traceable in both directions and
           covered (walkthrough, R-49; sheet 10-41, R-50). Conformance is a
           prerequisite for compiling the final report. Pinned within the
           evaluation. """ ;
    sysml:owner elmt:OGCAIE__ConformanceVerdict ;
    sysml:qualifiedName "OGCAIE::ConformanceVerdict::@0" .

