    sysml:type elmt:OGCAIE__StakeholderInput .

elmt:OGCAIE__StakeholderInput___400
    a sysml:Documentation ;
    sysml:body """ What an interviewed affected population said. Optional:
           populations not interviewed are represented by the domain
           expert, and the record names who represents them (R-21). """ ;
    sysml:owner elmt:OGCAIE__StakeholderInput ;
    sysml:qualifiedName "OGCAIE::StakeholderInput::@0" .

elmt:OGCAIE__StakeholderInput__id
    a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__StakeholderInput ;
    sysml:qualifiedName "OGCAIE::StakeholderInput::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__Strategy
    a sysml:ItemDefinition ;
    sysml:declaredName "Strategy" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::Strategy" .

elmt:OGCAIE__Strategy___400
    a sysml:Documentation ;
    sysml:body """ A test strategy: a state feedback policy choosing the next
           probe from the trajectory so far (R-13). Optional. """ ;
    sysml:owner elmt:OGCAIE__Strategy ;
    sysml:qualifiedName "OGCAIE::Strategy::@0" .

elmt:OGCAIE__Strategy__id
    a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__Strategy ;
    sysml:qualifiedName "OGCAIE::Strategy::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__Sufficiency
    a sysml:EnumerationDefinition ;
    sysml:declaredName "Sufficiency" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::Sufficiency" .

elmt:OGCAIE__Sufficiency___400
    a sysml:Documentation ;
    sysml:body """ Hawkins et al. 2011, section 3.3; ISA 500 paragraph 5(f):
           the measure of the quantity of evidence. """ ;
    sysml:owner elmt:OGCAIE__Sufficiency ;
    sysml:qualifiedName "OGCAIE::Sufficiency::@0" .

elmt:OGCAIE__Sufficiency__insufficient
    a sysml:EnumerationUsage ;
    sysml:declaredName "insufficient" ;
    sysml:owner elmt:OGCAIE__Sufficiency ;
    sysml:qualifiedName "OGCAIE::Sufficiency::insufficient" .

elmt:OGCAIE__Sufficiency__sufficient
    a sysml:EnumerationUsage ;
    sysml:declaredName "sufficient" ;
    sysml:owner elmt:OGCAIE__Sufficiency ;
    sysml:qualifiedName "OGCAIE::Sufficiency::sufficient" .

elmt:OGCAIE__TestItem
    a sysml:PartDefinition ;
    sysml:declaredName "TestItem" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::TestItem" ;
    sysml:specializes elmt:OGCAIE__Machine .

elmt:OGCAIE__TestItemAccess
    a sysml:ItemDefinition ;
    sysml:declaredName "TestItemAccess" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::TestItemAccess" .

elmt:OGCAIE__TestItemAccess___400
    a sysml:Documentation ;
    sysml:body """ The accountable organization's grant of access to the test
           item, with the version to be tested. """ ;
    sysml:owner elmt:OGCAIE__TestItemAccess ;
    sysml:qualifiedName "OGCAIE::TestItemAccess::@0" .

elmt:OGCAIE__TestItemAccess__id
    a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__TestItemAccess ;
    sysml:qualifiedName "OGCAIE::TestItemAccess::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__TestItem___400
    a sysml:Documentation ;
    sysml:body """ The test item (SEVOCAB; the prose says system under test,
           ruling R-19): a black box that is given probes and produces
           responses. Provided by the accountable organization, inside
           the record, outside the testing organization's responsibility. """ ;
    sysml:owner elmt:OGCAIE__TestItem ;
    sysml:qualifiedName "OGCAIE::TestItem::@0" .

elmt:OGCAIE__TestItem__probesIn
    a sysml:PortUsage ;
    sysml:declaredName "probesIn" ;
    sysml:isConjugated "true"^^xsd:boolean ;
    sysml:owner elmt:OGCAIE__TestItem ;
    sysml:qualifiedName "OGCAIE::TestItem::probesIn" ;
    sysml:type elmt:OGCAIE__ProbeWrite .

elmt:OGCAIE__TestItem__responseOut
    a sysml:PortUsage ;
    sysml:declaredName "responseOut" ;
    sysml:owner elmt:OGCAIE__TestItem ;
    sysml:qualifiedName "OGCAIE::TestItem::responseOut" ;
    sysml:type elmt:OGCAIE__ResponseWrite .

elmt:OGCAIE__TestPlan
    a sysml:ItemDefinition ;
    sysml:declaredName "TestPlan" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::TestPlan" .

elmt:OGCAIE__TestPlan___400
    a sysml:Documentation ;
    sysml:body """ SEVOCAB test plan: objectives (criteria) and means (probes
           or a test strategy), fixed before any session (R-12, R-13). """ ;
    sysml:owner elmt:OGCAIE__TestPlan ;
    sysml:qualifiedName "OGCAIE::TestPlan::@0" .

elmt:OGCAIE__TestPlan__id
    a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__TestPlan ;
    sysml:qualifiedName "OGCAIE::TestPlan::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__TestingOrganization
    a sysml:PartDefinition ;
    sysml:declaredName "TestingOrganization" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::TestingOrganization" ;
    sysml:specializes elmt:OGCAIE__Organization .

elmt:OGCAIE__TestingOrganization___400
    a sysml:Documentation ;
    sysml:body """ The provider (ISO 9000:2026 3.1.9): performs the evaluation
           as a service. Holds exactly one account executive, one team of
           one or more domain experts and one or more operators (all three
           are roles within it, ruling R-23), and the four machines. Independent of the accountable
           organization, with no user interest in the test item, it is a
           third party (ISO/IEC 17000 4.5); the record states which. """ ;
    sysml:owner elmt:OGCAIE__TestingOrganization ;
    sysml:qualifiedName "OGCAIE::TestingOrganization::@0" .

elmt:OGCAIE__TestingOrganization__accountExecutive
    a sysml:PartUsage ;
    sysml:declaredName "accountExecutive" ;
    sysml:owner elmt:OGCAIE__TestingOrganization ;
    sysml:qualifiedName "OGCAIE::TestingOrganization::accountExecutive" ;
    sysml:type elmt:OGCAIE__AccountExecutive ;
    sysml:upperBound expr:OGCAIE__TestingOrganization__accountExecutive_pupperBound .

elmt:OGCAIE__TestingOrganization__conformanceChecker
    a sysml:PartUsage ;
    sysml:declaredName "conformanceChecker" ;
    sysml:owner elmt:OGCAIE__TestingOrganization ;
    sysml:qualifiedName "OGCAIE::TestingOrganization::conformanceChecker" ;
    sysml:type elmt:OGCAIE__ConformanceChecker .

elmt:OGCAIE__TestingOrganization__coverageCalculator
    a sysml:PartUsage ;
    sysml:declaredName "coverageCalculator" ;
    sysml:owner elmt:OGCAIE__TestingOrganization ;
    sysml:qualifiedName "OGCAIE::TestingOrganization::coverageCalculator" ;
    sysml:type elmt:OGCAIE__CoverageCalculator .

elmt:OGCAIE__TestingOrganization__independentOfAccountable
    a sysml:AttributeUsage ;
    sysml:declaredName "independentOfAccountable" ;
    sysml:owner elmt:OGCAIE__TestingOrganization ;
    sysml:qualifiedName "OGCAIE::TestingOrganization::independentOfAccountable" ;
    sysml:type "ScalarValues::Boolean" .

elmt:OGCAIE__TestingOrganization__probeDeriver
    a sysml:PartUsage ;
    sysml:declaredName "probeDeriver" ;
    sysml:owner elmt:OGCAIE__TestingOrganization ;
    sysml:qualifiedName "OGCAIE::TestingOrganization::probeDeriver" ;
    sysml:type elmt:OGCAIE__ProbeDeriver .

