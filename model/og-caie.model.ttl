    a sysml:PortUsage ;
    sysml:declaredName "agreementOut" ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::agreementOut" ;
    sysml:type elmt:OGCAIE__AgreementWrite .

elmt:OGCAIE__SponsorOrganization__deliveryIn
    a sysml:PortUsage ;
    sysml:declaredName "deliveryIn" ;
    sysml:isConjugated "true"^^xsd:boolean ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::deliveryIn" ;
    sysml:type elmt:OGCAIE__DeliveryWrite .

elmt:OGCAIE__SponsorOrganization__isAccountable
    a sysml:AttributeUsage ;
    sysml:declaredName "isAccountable" ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::isAccountable" ;
