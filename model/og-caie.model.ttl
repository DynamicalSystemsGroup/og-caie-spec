    a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__StakeholderInputWrite ;
    sysml:qualifiedName "OGCAIE::StakeholderInputWrite::i" ;
    sysml:type elmt:OGCAIE__StakeholderInput .

elmt:OGCAIE__StakeholderInput___400
    a sysml:Documentation ;
    sysml:body """ What an interviewed affected population said. Optional:
           every population is spoken for by a member of the team, from
           its interview when there was one, and the record names who
           (R-21, R-49, sheet 10-13). """ ;
    sysml:owner elmt:OGCAIE__StakeholderInput ;
    sysml:qualifiedName "OGCAIE::StakeholderInput::@0" .

elmt:OGCAIE__StakeholderInput__id
    a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__StakeholderInput ;
    sysml:qualifiedName "OGCAIE::StakeholderInput::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__StakeholderRepresentation
    a sysml:ItemDefinition ;
    ogm:realizes epo:StakeholderRepresentation ;
    sysml:declaredName "StakeholderRepresentation" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::StakeholderRepresentation" .

elmt:OGCAIE__StakeholderRepresentation___400
    a sysml:Documentation ;
    sysml:body """ What a representative says on behalf of an affected
           population, built from its interview when there was one:
           representation is always present for a named population, the
           interview layer is optional and feeds it (walkthrough B3, R-49).
           Pinned within the evaluation. """ ;
    sysml:owner elmt:OGCAIE__StakeholderRepresentation ;
    sysml:qualifiedName "OGCAIE::StakeholderRepresentation::@0" .

elmt:OGCAIE__StakeholderRepresentation__id
    a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__StakeholderRepresentation ;
    sysml:qualifiedName "OGCAIE::StakeholderRepresentation::id" ;
    sysml:type "ScalarValues::String" .

