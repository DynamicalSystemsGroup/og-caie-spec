elmt:OGCAIE__EvaluationTeam___400
    a sysml:Documentation ;
    sysml:body """ The evaluation team (refined from ISO 9000:2026 3.12.7 audit
           team): at least one domain expert and at least one evaluation
           operator, distinct actor categories (rulings R-10, R-23). """ ;
    sysml:owner elmt:OGCAIE__EvaluationTeam ;
    sysml:qualifiedName "OGCAIE::EvaluationTeam::@0" .

