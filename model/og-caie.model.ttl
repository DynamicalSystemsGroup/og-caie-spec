    ogm:then elmt:OGCAIE__EvaluationProcess__declareRequirements ;
    sysml:owner elmt:OGCAIE__EvaluationProcess ;
    sysml:qualifiedName "OGCAIE::EvaluationProcess::@14" ;
    sysx:relatedFeature expr:OGCAIE__EvaluationProcess___4014_pend0, expr:OGCAIE__EvaluationProcess___4014_pend1 ;
    sysx:sourceText "succession first scope then declareRequirements;" .

