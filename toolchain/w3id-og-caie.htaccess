# Proposed redirect rules for https://w3id.org/og-caie/ (sheet 10-35, R-50).
# The pull request filed by Z at perma-id/w3id.org is authoritative; this file
# says what each IRI is meant to serve so a reader can see it before the
# request merges. Work proceeds on the assumption that it does.
#
# Namespaces (every IRI this specification authors):
#   https://w3id.org/og-caie/                the site (GitHub Pages)
#   https://w3id.org/og-caie/terms#<term>    the glossary (vocabulary/og-caie.ttl)
#   https://w3id.org/og-caie/epo#<class>     the Evaluation Process Ontology (vocabulary/epo.ttl)
#   https://w3id.org/og-caie/sources#<slug>  the source register (sources/sources.ttl)
#   https://w3id.org/og-caie/rulings#<id>    the rulings and concerns (rulings/adjudications.ttl)
#   https://w3id.org/og-caie/model#          the derived ends of the model graph (ogm:)
#   https://w3id.org/og-caie/evaluation/measles#  the measles evaluation's record
#   https://w3id.org/og-caie/<Shape>         the shapes (shapes/*.ttl) and the glossary scheme, under the root
#
# A Turtle request negotiates to the raw file on the main branch; anything
# else lands on the page that renders the same graph.

RewriteEngine On

# The vocabularies, by content negotiation
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^og-caie/terms$ https://raw.githubusercontent.com/DynamicalSystemsGroup/og-caie-spec/main/vocabulary/og-caie.ttl [R=303,L]
RewriteRule ^og-caie/terms$ https://dynamicalsystemsgroup.github.io/og-caie-spec/docs/glossary [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^og-caie/epo$ https://raw.githubusercontent.com/DynamicalSystemsGroup/og-caie-spec/main/vocabulary/epo.ttl [R=303,L]
RewriteRule ^og-caie/epo$ https://dynamicalsystemsgroup.github.io/og-caie-spec/docs/evaluation [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^og-caie/sources$ https://raw.githubusercontent.com/DynamicalSystemsGroup/og-caie-spec/main/sources/sources.ttl [R=303,L]
RewriteRule ^og-caie/sources$ https://dynamicalsystemsgroup.github.io/og-caie-spec/docs/appendix-works-cited [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^og-caie/rulings$ https://raw.githubusercontent.com/DynamicalSystemsGroup/og-caie-spec/main/rulings/adjudications.ttl [R=303,L]
RewriteRule ^og-caie/rulings$ https://dynamicalsystemsgroup.github.io/og-caie-spec/docs/rulings [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^og-caie/model$ https://raw.githubusercontent.com/DynamicalSystemsGroup/og-caie-spec/main/model/og-caie.model.ttl [R=303,L]
RewriteRule ^og-caie/model$ https://dynamicalsystemsgroup.github.io/og-caie-spec/docs/model [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^og-caie/evaluation/measles$ https://raw.githubusercontent.com/DynamicalSystemsGroup/og-caie-spec/main/track/measles-evaluation.ttl [R=303,L]
RewriteRule ^og-caie/evaluation/measles$ https://dynamicalsystemsgroup.github.io/og-caie-spec/docs/guarantees [R=303,L]

# The root: the site
RewriteRule ^og-caie/?$ https://dynamicalsystemsgroup.github.io/og-caie-spec/ [R=303,L]
RewriteRule ^og-caie/(.*)$ https://dynamicalsystemsgroup.github.io/og-caie-spec/$1 [R=303,L]
