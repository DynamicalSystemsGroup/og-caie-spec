@prefix epo:  <https://w3id.org/og-caie/epo#> .
@prefix src:  <https://w3id.org/og-caie/sources#> .
@prefix rul:  <https://w3id.org/og-caie/rulings#> .
@prefix ogc:  <https://w3id.org/og-caie/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# The Evaluation Process Ontology, minimal form: handle classes for the
# things the seven steps produce, each a subclass of a PROV-O or EARL class,
# with no new semantics. Import, don't mint. The DSO is referenced, never
# imported. Prior art: DynamicalSystemsGroup/caie-epo-prototype (June 2026).

epo: a owl:Ontology ;
    rdfs:label "OG-CAIE Evaluation Process Ontology (EPO), minimal handles" ;
    rdfs:comment "Assembles PROV-O and EARL. A coined term (ruling R-09): the domain-independent standard operating procedure whose record, when it conforms to shapes/epo.shapes.ttl, shows the process was followed and lets coverage be computed." .

# ---- the six steps of the evaluation (rulings R-21, R-32: agree moved to the
# contracting lifecycle). Each step cites the process step it
# matches in the canon (ruling R-31): the INCOSE/ISO 15288 processes as SEBoK
# describes them, the ISO/IEC/IEEE 29119-2 test processes as SEVOCAB defines
# them, and ISO/IEC 17000's functions (selection, determination, review,
# decision and attestation). The steps are operationalized, not invented.
epo:EpoStep a owl:Class ; rdfs:label "EPO step" .
epo:scope a epo:EpoStep ; rdfs:label "1 scope: interview or represent the affected populations; build or select the DSO release; declare the operational environment" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ; ogc:locator "Stakeholder Needs and Requirements, p. 549 (Stakeholder Needs Definition, Concept Definition)" ; ogc:pdfPage 549 ; ogc:quote "Stakeholder Needs Definition, the second process in Concept Definition, explores what capabilities are needed by various stakeholders for the system-of-interest (SoI) to accomplish the mission." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "Annex A, A.2 Selection (the functional approach)" ] .
epo:declareRequirements a epo:EpoStep ; rdfs:label "2 declare the requirement set (operational envelope): requirements, acceptance criteria, weights; the domain expert assesses its appropriateness" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ; ogc:locator "System Requirements Definition, Process for Generating System Requirements, p. 558" ; ogc:pdfPage 558 ; ogc:quote "The System Requirement Definition activities begin with the transformation of the integrated set of needs into a set of requirements for the SoI. These requirements must be appropriate to the level that the SoI exists within the system architecture and communicate \"what\" the SoI must do to meet the needs, avoiding requirements that state implementation of \"how\" to achieve the design realization of the physical SoI." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sebok-2-14 ; ogc:locator "System Requirements Definition, p. 559" ; ogc:pdfPage 559 ; ogc:quote "A detailed analysis of a single need statement may result in multiple requirements expressing what the system must do to meet it, including definition of measurable performance criteria (INCOSE NRM 2022)." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "system requirements specification (SyRS), p. 422 (ISO/IEC/IEEE 29148:2018, 4.1.29)" ; ogc:pdfPage 422 ; ogc:quote "structured collection of the requirements (functions, performance, design constraints, and attributes) of the system and its operational environments and external interfaces" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "5.1 specified requirement" ; ogc:quote "need or expectation that is stated" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-09): the requirement set is what the test item must do, never how; SEBoK's own first activity of System Requirements Definition, the needs of step 1 transformed into requirements with measurable criteria." .
epo:plan a epo:EpoStep ; rdfs:label "3 plan: the test plan, its probes or strategy, consistency-checked and approved" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test strategy and planning process, p. 439 (ISO/IEC/IEEE 29119-2:2021, 3.51)" ; ogc:pdfPage 439 ; ogc:quote "test management process used to design the test strategy, complete test planning, and create and maintain test plans" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "test design and implementation process, p. 433 (ISO/IEC/IEEE 29119-2:2021, 3.32)" ; ogc:pdfPage 433 ; ogc:quote "test process for deriving and specifying test cases and test procedures" ; ogc:quoteStatus "machine" ] .
epo:execute a epo:EpoStep ; rdfs:label "4 execute: sessions of turns against the test item; responses; evidence collected under the plan" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test execution process, p. 435 (ISO/IEC/IEEE 29119-2:2021, 3.40)" ; ogc:pdfPage 435 ; ogc:quote "dynamic test process for executing test procedures created in the test design and implementation process in the prepared test environment and recording the results" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "6.2 testing" ; ogc:quote "determination of one or more characteristics of an object of conformity assessment, according to a procedure" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "Annex A, A.3 Determination (the functional approach)" ] .
epo:determineAndAttest a epo:EpoStep ; rdfs:label "5 determine and attest: determinations on evidence; attestations by the domain expert" ;
    ogc:canonical [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "7.2 decision" ; ogc:quote "conclusion, based on the results of review, that fulfilment of specified requirements has or has not been demonstrated" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "7.3 attestation" ;
                    ogc:quote "issue of a statement, based on a decision, that fulfilment of specified requirements has been demonstrated" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "7.1 review" ; ogc:quote "consideration of the suitability, adequacy and effectiveness of selection and determination activities, and the results of these activities, with regard to fulfilment of specified requirements by an object of conformity assessment" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "evaluation, p. 155 (ISO/IEC 25001:2014, 4.1)" ; ogc:pdfPage 155 ; ogc:quote "systematic determination of the extent to which an entity meets its specified criteria" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "Annex A, A.4 Review, decision and attestation (the functional approach)" ] .
epo:report a epo:EpoStep ; rdfs:label "6 report: coverage and performance computed; recommendation written; handed to the account executive for delivery" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test completion process, p. 433 (ISO/IEC/IEEE 29119-2:2021, 3.25)" ; ogc:pdfPage 433 ; ogc:quote "test management process that aims to ensure that useful test assets are made available for later use, test environments are left in a satisfactory condition, and the results of testing are recorded and communicated to relevant stakeholders" ; ogc:quoteStatus "machine" ] .

# ---- the contracting lifecycle (ruling R-32): contracting through delivery,
# the outer cycle the evaluation sits inside. Its actors are the parties; its
# steps are the ISO/IEC/IEEE 15288 agreement processes as SEBoK describes
# them, ISO/IEC 17000's access, scheme and acceptance, ISO 9000's contract,
# and the ISO/IEC/IEEE 29119-2 test environment and completion report. What
# it pins is the first layer of assumptions: the parties, the object, the
# specified requirements' frame and the methodology (ogc:pinnedAt epo:contract).
epo:ContractingStep a owl:Class ; rdfs:label "contracting lifecycle step" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ; ogc:locator "Stakeholder Needs (Acquisition and Supply), p. 353" ; ogc:pdfPage 353 ; ogc:quote "These needs and requirements are expressed in agreements between acquirers and suppliers." ; ogc:quoteStatus "machine" ] .
epo:need a epo:ContractingStep ; rdfs:label "C1 need: the sponsor states its mission and obligations towards the affected populations, the problem, and what success would look like" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ; ogc:locator "Business or Mission Analysis, p. 543" ; ogc:pdfPage 543 ; ogc:quote "The purpose of Business or Mission Analysis is to understand a mission or market problem, threat, or opportunity, and to establish the goals, objectives and measures of success of a potential solution class." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.5.1 requirement" ; ogc:quote "need or expectation that is stated, generally implied or obligatory" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-11.png" ] .
epo:propose a epo:ContractingStep ; rdfs:label "C2 propose: the sponsor seeks the service and the testing organization responds" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ; ogc:locator "Enterprise Systems Engineering, contract products and services, p. 935" ; ogc:pdfPage 935 ; ogc:quote "Contract products and services often demand tailor-made system/service solutions which are typically specified by a single customer to whom the solution is provided. The supplier responds with proposed solutions." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "proposal, p. 329 (ISO/IEC/IEEE 24765:2014, SEVOCAB tag 24765c)" ; ogc:pdfPage 329 ; ogc:quote "supplier's offer to provide a system or service, usually including benefits, costs, risks, opportunities, and other factors applicable to decisions" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "request for proposal (RFP), p. 350 (ISO/IEC/IEEE 24765:2017)" ; ogc:pdfPage 350 ; ogc:quote "document used by the acquirer as the means to announce its intention to potential bidders to acquire a specified system, software product, or software service" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.10 access" ; ogc:quote "opportunity for an applicant to obtain a conformity assessment service from a body under a conformity assessment scheme" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-09): the customer specifies, the supplier responds with a proposal; the supplier's definition (SEBoK p. 352) backs the testing organization's role, not this step." .
epo:agree a epo:ContractingStep ; rdfs:label "C3 agree: the service agreement fixes the counterparties, the test item, the requirements' frame and the method" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ; ogc:locator "Acquisition and Supply, p. 353 (INCOSE 2012, the acquisition process)" ; ogc:pdfPage 353 ; ogc:quote "The acquisition process includes activities to identify, select, and reach commercial agreements with a product or service supplier." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.3.13" ; ogc:quote "binding agreement" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-38.png" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.9 conformity assessment scheme" ; ogc:quote "set of rules and procedures that describes the objects of conformity assessment, identifies the specified requirements and provides the methodology for performing conformity assessment" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] .
epo:access a epo:ContractingStep ; rdfs:label "C4 access: the accountable organization provides the test item and the test environment" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test environment and data management process, p. 434 (ISO/IEC/IEEE 29119-2:2021, 3.37)" ; ogc:pdfPage 434 ; ogc:quote "test process for establishing and maintaining a required test environment and corresponding test data" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "test environment, p. 434 (ISO/IEC/IEEE 29119-2:2021, 3.34)" ; ogc:pdfPage 434 ; ogc:quote "environment containing facilities, hardware, software, firmware, and procedures needed to conduct a test" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "test item transmittal report, p. 435 (ISO/IEC/IEEE 24765:2017)" ; ogc:pdfPage 435 ; ogc:quote "document identifying test items" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.2 object of conformity assessment" ; ogc:quote "entity to which specified requirements apply" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-09): the 29119-2 process whose output is the prepared test environment that step 4's test execution process presupposes; the environment itself is a thing and stays a neighbour." .
epo:deliver a epo:ContractingStep ; rdfs:label "C5 deliver: the account executive delivers the report and the recommendation to the sponsor" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test completion report, p. 433 (ISO/IEC/IEEE 29119-2:2021, 3.26)" ; ogc:pdfPage 433 ; ogc:quote "report that provides a summary of the testing that was performed" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "delivery, p. 120 (ISO/IEC/IEEE 24765:2017)" ; ogc:pdfPage 120 ; ogc:quote "release of a system or component to its customer or intended user" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "7.3 attestation, Note 1 (fragment of the note)" ; ogc:quote "is intended to convey the assurance that the specified requirements have been fulfilled" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] .
epo:acceptDelivery a epo:ContractingStep ; rdfs:label "C6 accept: the sponsor accepts the delivery as performance of the agreement" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "acceptance, p. 4 (ISO/IEC/IEEE 24748-5:2017, 3.1)" ; ogc:pdfPage 4 ; ogc:quote "action by an authorized representative of the acquirer by which the acquirer assumes ownership of products as partial or complete performance of an agreement" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sebok-2-14 ; ogc:locator "Acceptance Criteria (glossary), p. 1437 (INCOSE 2011, Section 6.1.15)" ; ogc:pdfPage 1437 ; ogc:quote "The procurement specification, in the context of the overall agreement, should clearly state the criteria by which the acquirer will accept delivery from the supplier." ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-09): ISO/IEC 17000 9.6 acceptance is the recognition of a result between bodies, not the sponsor accepting performance; it left this step." .
epo:Layer a owl:Class ; rdfs:label "the layer at which an item is pinned" .
epo:contract a epo:Layer ; rdfs:label "pinned at the contract: axiomatic boundary conditions the evaluation takes as given and must document" .
epo:evaluation a epo:Layer ; rdfs:label "pinned within the evaluation: declared and recorded by the evaluation team under the process" .
ogc:pinnedAt a owl:ObjectProperty ; rdfs:range epo:Layer ; rdfs:comment "on an item class: which layer fixes it (R-32)" .

# ---- parties and roles (rulings R-21, R-23)
epo:Population a owl:Class ; ogc:pinnedAt epo:contract ; rdfs:subClassOf prov:Agent ; rdfs:label "affected population: a population of actors affected by the test item (ISO 9000:2026 3.1.4 interested party), interviewed or represented" .
epo:Role a owl:Class ; rdfs:subClassOf prov:Role ; rdfs:label "a party's role in one evaluation" .
epo:sponsorRole a epo:Role ; rdfs:label "sponsor organization (ISO 9000:2026 customer): commissions the evaluation and receives the delivery" .
epo:testingOrganizationRole a epo:Role ; rdfs:label "testing organization (ISO 9000:2026 provider): performs the evaluation as a service" .
epo:accountableOrganizationRole a epo:Role ; rdfs:label "accountable organization (ISO/IEC 17000 first party): provides the test item" .
epo:accountExecutiveRole a epo:Role ; rdfs:label "account executive: signs the agreement for the testing organization and delivers the report; never judges" .
epo:domainExpertRole a epo:Role ; rdfs:label "domain expert: DSO, appropriateness, plan approval, determinations, attestations; represents populations not interviewed" .
epo:evaluationOperatorRole a epo:Role ; rdfs:label "evaluation operator: requirement set, plan, sessions, evidence, determinations, recommendation" .
epo:role a owl:ObjectProperty ; rdfs:domain prov:Agent ; rdfs:range epo:Role ; rdfs:comment "convenience handle: the role an agent fills in this record (the PROV form is a qualified association; one property keeps the shapes readable)" .
epo:isAccountable a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:comment "on the sponsor: whether it is also the organization accountable for the test item (R-21)" .
epo:independentOfAccountable a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:comment "on the testing organization: independent of the accountable organization with no user interest in the test item (ISO/IEC 17000 4.5, 5.4)" .
epo:representedBy a owl:ObjectProperty ; rdfs:domain epo:Population ; rdfs:range prov:Person ; rdfs:comment "the domain expert who represents a population that was not interviewed (R-21)" .

# ---- things (prov:Entity)
epo:Mission a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "mission: the sponsor's purpose and its obligations towards the affected populations (ISO 9000:2026 3.4.11; R-37), the context the contract answers to" .
epo:StatementOfWork a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "statement of work: the sponsor's scope-of-work decisions under the contract, here one engagement decision per affected population (SEVOCAB statement of work; R-40)" .
epo:EngagementDecision a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "engagement decision: for one affected population, interview or representation (R-40)" .
epo:Engagement a owl:Class ; rdfs:label "how an affected population is engaged" .
epo:interview a epo:Engagement ; rdfs:label "interviewed: its stakeholder needs documented as input" .
epo:representation a epo:Engagement ; rdfs:label "represented by the domain expert" .
epo:Need a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "need: the sponsor's stated mission problem and measures of success (ISO 9000:2026 requirement: need or expectation that is stated)" .
epo:Proposal a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "proposal: the testing organization's response to the sponsor's need, offering the service" .
epo:Acceptance a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "acceptance: the sponsor's acceptance of the delivery as performance of the agreement" .
epo:ServiceAgreement a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "service agreement: the contract (ISO 9000:2026 3.3.13) to perform OG-CAIE as a service, signed by the sponsor and the account executive (R-21, R-23)" .
epo:TestItemAccess a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "test-item access: the accountable organization's grant of access to the versioned test item" .
epo:StakeholderInput a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:evaluation ; rdfs:label "stakeholder input: what an interviewed population said" .
epo:Delivery a owl:Class ; rdfs:subClassOf prov:Entity ; ogc:pinnedAt epo:contract ; rdfs:label "delivery: the report and the recommendation handed to the sponsor by the account executive (R-24)" .
epo:DsoRelease a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "DSO release" .
epo:RequirementSet a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "requirement set (operational envelope): the requirements one system under test must meet in one operational environment (R-14)" .
epo:Requirement a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "requirement" .
epo:AcceptanceCriterion a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity, earl:TestCriterion ; rdfs:label "acceptance criterion" .
epo:TestPlan a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "test plan (objectives: criteria; means: probes, or a strategy that chooses them)" .
epo:Strategy a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Plan, prov:Entity ; rdfs:label "test strategy (SEVOCAB 29119-2): a state feedback policy that chooses the next probe from the trajectory so far, grounded in the DSO (R-13)" .
epo:Trajectory a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "trajectory: the ordered prompt-response pairs of a session, the observable realization (IEC 60050-351 351-41-10, refined; R-13)" .
epo:Probe a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "probe" .
epo:Response a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "response: what the system under test produced at one turn (the actual result)" .
epo:Evidence a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "evidence: collected material (a response, a trajectory, or several) bearing on one criterion's expected result, under the test plan (R-18, R-20); the domain of a determination" .
epo:Determination a owl:Class ; rdfs:subClassOf earl:Assertion, prov:Activity ; rdfs:label "determination (ISO 9000:2026 3.11.1; the paper's judgment): the ruling on one or more evidence items that a criterion's expected result was met, not met, or cannot be told (R-20); the codomain of evidence" .
epo:Report a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "report" .
epo:Recommendation a owl:Class ; ogc:pinnedAt epo:evaluation ; rdfs:subClassOf prov:Entity ; rdfs:label "recommendation" .

# ---- doings (prov:Activity), two of them also EARL assertions
epo:ProbeDerivation a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "probe derivation" .
epo:ConsistencyCheck a owl:Class ; rdfs:subClassOf earl:Assertion, prov:Activity ; rdfs:label "automatic consistency check of a probe" .
epo:Session a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "session (NIST AI 700-2): one tester, one system under test, a sequence of turns; the test execution" .
epo:Turn a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "turn: one probe applied within a session, producing one response" .
epo:TestSuite a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "test suite (SEVOCAB 29119-1): a set of sessions run together, e.g. a robustness battery (R-18)" .
epo:Attestation a owl:Class ; rdfs:subClassOf earl:Assertion, prov:Activity ; rdfs:label "attestation" .
epo:AppropriatenessAssessment a owl:Class ; rdfs:subClassOf earl:Assertion, prov:Activity ; rdfs:label "appropriateness assessment: the domain expert's judgment that the requirement set is appropriate for the populations and the environment (R-08, R-21)" .
epo:PlanApproval a owl:Class ; rdfs:subClassOf earl:Assertion, prov:Activity ; rdfs:label "plan approval: the domain expert's approval of a test plan (R-21)" .
epo:CoverageComputation a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "coverage computation" .

# ---- properties
epo:version a owl:DatatypeProperty ; rdfs:domain epo:DsoRelease ; rdfs:range xsd:string .
epo:approvedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasAttributedTo ; rdfs:domain epo:DsoRelease ; rdfs:range prov:Person .
epo:environment a owl:DatatypeProperty ; rdfs:domain epo:RequirementSet ; rdfs:range xsd:string ; rdfs:comment "the operational environment (SEVOCAB), stated" .
epo:systemUnderTest a owl:ObjectProperty ; rdfs:domain epo:RequirementSet ; rdfs:range earl:TestSubject ; rdfs:comment "the one system this envelope binds: THIS system in THIS environment must meet THESE requirements (R-14)" .
epo:partOf a owl:ObjectProperty ; rdfs:domain epo:Requirement ; rdfs:range epo:RequirementSet .
epo:text a owl:DatatypeProperty ; rdfs:range xsd:string .
epo:weight a owl:DatatypeProperty ; rdfs:domain epo:AcceptanceCriterion ; rdfs:range xsd:decimal ; rdfs:comment "deployment sensitivity (ruling R-05)" .
epo:minPassRate a owl:DatatypeProperty ; rdfs:domain epo:AcceptanceCriterion ; rdfs:range xsd:decimal .
epo:expectedResult a owl:DatatypeProperty ; rdfs:domain epo:AcceptanceCriterion ; rdfs:range xsd:string ; rdfs:comment "SEVOCAB expected results: the observable predicted behavior that would show the criterion met (ruling R-12)" .
epo:objective a owl:ObjectProperty ; rdfs:domain epo:TestPlan ; rdfs:range epo:AcceptanceCriterion ; rdfs:comment "SEVOCAB test plan: the test objectives to be achieved" .
epo:means a owl:ObjectProperty ; rdfs:domain epo:TestPlan ; rdfs:comment "SEVOCAB test plan: the means for achieving them; a Probe or a Strategy (R-13)" .
epo:inSession a owl:ObjectProperty ; rdfs:domain epo:Turn ; rdfs:range epo:Session .
epo:turnIndex a owl:DatatypeProperty ; rdfs:domain epo:Turn ; rdfs:range xsd:integer ; rdfs:comment "1-based position in the session's trajectory" .
epo:policy a owl:DatatypeProperty ; rdfs:domain epo:Strategy ; rdfs:range xsd:string ; rdfs:comment "the rule that maps the trajectory so far to the next probe; may name a person's exploratory testing" .
epo:groundedIn a owl:ObjectProperty ; rdfs:domain epo:Strategy ; rdfs:range epo:DsoRelease .
epo:turns a owl:DatatypeProperty ; rdfs:domain epo:Trajectory ; rdfs:range xsd:integer .
epo:underPlan a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:domain epo:Evidence ; rdfs:range epo:TestPlan ; rdfs:comment "the test plan an evidence item was collected under (R-18)" .
epo:bearsOn a owl:ObjectProperty ; rdfs:domain epo:Evidence ; rdfs:range epo:AcceptanceCriterion ; rdfs:comment "the criterion whose expected result this evidence item bears on (R-18, R-20)" .
epo:inSuite a owl:ObjectProperty ; rdfs:domain epo:Session ; rdfs:range epo:TestSuite .
epo:exercises a owl:ObjectProperty ; rdfs:domain epo:Probe ; rdfs:range epo:AcceptanceCriterion .
epo:derivedFromDso a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:domain epo:Probe ; rdfs:range epo:DsoRelease .
epo:appropriateness a owl:ObjectProperty ; rdfs:range epo:AppropriatenessValue ; rdfs:comment "on an attestation (the declared context) or an appropriateness assessment (the requirement set)" .
epo:sufficiency a owl:ObjectProperty ; rdfs:domain epo:Attestation ; rdfs:range epo:SufficiencyValue .
epo:step a owl:ObjectProperty ; rdfs:range epo:EpoStep .
epo:coverage a owl:DatatypeProperty ; rdfs:domain epo:Report ; rdfs:range xsd:decimal .
epo:passRate a owl:DatatypeProperty ; rdfs:domain epo:Report ; rdfs:range xsd:decimal .
epo:failRate a owl:DatatypeProperty ; rdfs:domain epo:Report ; rdfs:range xsd:decimal .
epo:cantTellRate a owl:DatatypeProperty ; rdfs:domain epo:Report ; rdfs:range xsd:decimal .
epo:targetsGuardrail a owl:DatatypeProperty ; rdfs:domain epo:Recommendation ; rdfs:range xsd:string .
epo:signedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasAttributedTo ; rdfs:domain epo:ServiceAgreement ; rdfs:range prov:Agent .
epo:underAgreement a owl:ObjectProperty ; rdfs:domain epo:RequirementSet ; rdfs:range epo:ServiceAgreement ; rdfs:comment "the requirement set is agreed under the service agreement (R-21)" .
epo:grantsAccessTo a owl:ObjectProperty ; rdfs:domain epo:TestItemAccess ; rdfs:range earl:TestSubject .
epo:approves a owl:ObjectProperty ; rdfs:domain epo:PlanApproval ; rdfs:range epo:TestPlan .
epo:deliveredTo a owl:ObjectProperty ; rdfs:domain epo:Delivery ; rdfs:range prov:Organization .
epo:accepts a owl:ObjectProperty ; rdfs:domain epo:Acceptance ; rdfs:range epo:Delivery .
epo:respondsTo a owl:ObjectProperty ; rdfs:domain epo:Proposal ; rdfs:range epo:Need .
epo:regards a owl:ObjectProperty ; rdfs:domain epo:Mission ; rdfs:range epo:Population ; rdfs:comment "the affected populations the mission holds obligations towards (R-37)" .
epo:underMission a owl:ObjectProperty ; rdfs:domain epo:Need ; rdfs:range epo:Mission .
epo:decides a owl:ObjectProperty ; rdfs:domain epo:StatementOfWork ; rdfs:range epo:EngagementDecision .
epo:population a owl:ObjectProperty ; rdfs:domain epo:EngagementDecision ; rdfs:range epo:Population .
epo:engagement a owl:ObjectProperty ; rdfs:domain epo:EngagementDecision ; rdfs:range epo:Engagement ; rdfs:comment "interview or representation (R-40)" .

# ---- the two judgment values (Hawkins et al. 2011; ruling R-08)
epo:AppropriatenessValue a owl:Class .
epo:appropriate a epo:AppropriatenessValue ; rdfs:label "the declared context was appropriate for this judgment" .
epo:inappropriate a epo:AppropriatenessValue .
epo:SufficiencyValue a owl:Class .
epo:sufficient a epo:SufficiencyValue ; rdfs:label "the evidence is enough to support the claim" .
epo:insufficient a epo:SufficiencyValue .
