@prefix ogc:  <https://w3id.org/og-caie/> .
@prefix term: <https://w3id.org/og-caie/terms#> .
@prefix src:  <https://w3id.org/og-caie/sources#> .
@prefix rul:  <https://w3id.org/og-caie/rulings#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The OG-CAIE glossary. Terms are used, not owned: each term cites exactly one
# canonical definition from the highest-ranked source that defines it
# (ISO 9000:2026, then SEVOCAB, then NIST AI 700-2, then W3C for binding
# only), with a verbatim quote and a locator. skos:definition is the
# narrative reading: plain language, no citations.
# ogc:class is adopted (used as the source defines it), refined (a typed
# anchor plus an altLabel keeping the source's word) or coined (exactly
# four). A quote shorter than the source's whole entry or paragraph says so in
# its locator: "(fragment ...)" or "(first sentence ...)" (sheet 10).
# ogc:quoteStatus: machine (located in the snapshot by the tests),
# authors (the bridge's own definitions, in crosswalk.ttl),
# human (verified by a named person on a date), pending (transcribed from a
# screenshot or a browsing platform; awaiting a named verification).

ogc:Glossary a skos:ConceptScheme ;
    skos:prefLabel "OG-CAIE glossary"@en .

# ------------------------------------------------------------ ISO 9000:2026

term:requirement a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "requirement"@en ;
    skos:definition "Something the system must do, or a condition it must meet, to be fit for its purpose. Broad requirements are decomposed into acceptance criteria that can be checked one at a time."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.5.1" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-11.png" ;
                    ogc:quote "need or expectation that is stated, generally implied or obligatory" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    skos:narrower term:acceptance-criteria ;
    skos:narrower term:guardrail ;
    skos:narrower term:operational-envelope ;
    skos:related term:conformity ;
    skos:related term:expected-results ;
    ogc:binding "sysml RequirementDefinition; epo:Requirement" .

term:conformity a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "conformity"@en ;
    skos:definition "Fulfilment of a requirement, in the ISO sense: the system under test conforms to an acceptance criterion when its response fulfils it, as a named person attests. For the machine-checked shape of the record itself, see conformance."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.5.9" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-13.png" ;
                    ogc:quote "fulfilment of a requirement" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-16: conformity is fulfilment of a requirement (ISO 9000:2026). Its deprecated synonym conformance is reclaimed, deliberately, for the special case of a record correctly constructed to the EPO's shapes." ;
    prov:wasDerivedFrom rul:R-16 ;
    skos:narrower term:conformance ;
    skos:related term:requirement ;
    skos:related term:attestation ;
    ogc:binding "earl:outcome earl:passed on an attestation: the system fulfilled the criterion" .

term:conformance a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "conformance"@en ;
    skos:altLabel "correct construction"@en ; skos:altLabel "correctness by construction"@en ;
    skos:definition "The record is correctly constructed: it satisfies every rule the Evaluation Process Ontology's shapes state about how an evaluation must be recorded. A mechanical yes or no, produced by machine. If the record conforms, the process was followed, its data is shaped, its required fields are filled, and coverage can be computed. A special case of conformity: fulfilment of the record-keeping requirements."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.5.9 conformity, Note 1" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-13.png" ;
                    ogc:quote "The term \"conformance\" is synonymous but deprecated." ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:w3c-shacl ; ogc:locator "Section 3.5 Conformance Checking" ;
                  ogc:quote "A focus node conforms to a shape if and only if the set of result of the validation of the focus node against the shape is empty and no failure has been reported by it." ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-16: ISO 9000:2026 deprecates this word as a synonym of conformity; this specification reclaims it on purpose, and says so, not as a synonym but for a special case: the correctly constructed record, whose conformance is fulfilment of the EPO's record-keeping requirements and so a conformity in its own right. Two reasons. It separates fulfilling a requirement of the system (conformity, attested by a person) from satisfying the record-keeping requirements of the EPO (conformance, checked by machine). And it avoids SHACL's own word for the check, validation, which by this specification's split is verification." ;
    prov:wasDerivedFrom rul:R-16 ;
    skos:broader term:conformity ;
    skos:related term:verification ;
    skos:related term:evaluation-record ;
    ogc:binding "sh:conforms true on the validation report of the record against shapes/epo.shapes.ttl; sysml part def ConformanceChecker" .

term:objective-evidence a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:altLabel "evidence"@en ;
    skos:prefLabel "objective evidence"@en ;
    skos:related term:record ;
    skos:definition "Data that supports the existence or truth of something. Here, what is collected as the basis for a determination: a response at one turn, a session's trajectory, or several of them rolled up over a test suite, as in a robustness battery. Each evidence item bears on one acceptance criterion's expected result and is bound to the test plan it was collected under. Evidence is the domain; the determination made on it, passed, failed or cannot tell, is the codomain. On its own evidence verifies nothing; a determination rules on it and an attestation judges it."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.8.6" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-21.png" ;
                    ogc:quote "data supporting the existence or verity of something" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "objective evidence, p. 277" ; ogc:pdfPage 277 ;
                  ogc:quote "data supporting the existence or verity of something" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Rulings R-18 and R-20: evidence exists at probe, session or suite level and maps to an expected result; it is the domain, and the determination on it is the codomain." ;
    prov:wasDerivedFrom rul:R-18 ;
    prov:wasDerivedFrom rul:R-20 ;
    skos:related term:determination ;
    skos:related term:sufficiency ;
    skos:related term:session ;
    skos:related term:trajectory ;
    ogc:binding "epo:Evidence (bears on one criterion, under a test plan) derived from epo:Response or epo:Trajectory" .

term:determination a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "determination"@en ;
    skos:altLabel "judgment"@en ;
    skos:definition "The ruling, made on one or more evidence items, that a criterion's expected result was met, was not met, or cannot be told. It is the ruling made on evidence, recorded with an EARL outcome of passed, failed or cannot tell, made by machine or by a named person, and it is what an attestation aggregates for a criterion."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.1" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-29.png" ;
                    ogc:quote "activity to find out one or more characteristics and their characteristic values" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Sheet 10-24 (R-50): in ISO/IEC 17000's terms this ruling is the decision (7.2) that fulfilment has or has not been demonstrated; 17000's determination (6.1, testing 6.2) is the fact-finding this specification calls the execute step. The ISO 9000 genus is kept as the anchor, the shift stated here and on step 5." ;
    prov:wasDerivedFrom rul:R-50 ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "test result, p. 438" ; ogc:pdfPage 438 ;
                  ogc:quote "indication of whether a specific test case has passed or failed, i.e. if the actual results correspond to the expected results or if deviations were observed" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-20 ;
    skos:related term:objective-evidence ;
    skos:related term:outcome ;
    skos:related term:attestation ;
    skos:related term:test ;
    ogc:binding "epo:Determination, an earl:Assertion and prov:Activity; earl:outcome passed, failed or cantTell; sysml item def Determination" .

term:test-suite a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "test suite"@en ;
    skos:altLabel "battery"@en ; skos:altLabel "robustness battery"@en ;
    skos:definition "A set of sessions run together, for example replicate sessions of one strategy, or the varied sessions of a sensitivity test or robustness battery. Evidence rolled up over a suite is evidence at the third level, above probe and session."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test suite, p. 439" ; ogc:pdfPage 439 ;
                    ogc:quote "set of test cases or test procedures" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "robustness, p. 363 (ISO/IEC 25059:2023)" ; ogc:pdfPage 363 ;
                  ogc:quote "degree to which an AI system can maintain its level of functional correctness under any circumstances" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-18 ;
    skos:related term:session ;
    skos:related term:repeatability ;
    ogc:binding "epo:TestSuite, a prov:Activity grouping epo:Session activities" .

term:verification a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "verification"@en ;
    skos:definition "Confirming with objective evidence that specified requirements were fulfilled. Applied to the evaluation itself: did it exercise what it declared, and was its declared process followed. Both are mechanical checks over the record."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.12" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-32.png" ;
                    ogc:quote "confirmation, through the provision of objective evidence, that specified requirements have been fulfilled" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "verification, p. 470" ; ogc:pdfPage 470 ;
                  ogc:quote "confirmation, through the provision of objective evidence, that specified requirements have been fulfilled" ; ogc:quoteStatus "machine" ] ;
    skos:related term:conformance ;
    skos:related term:validation ;
    ogc:binding "SHACL shapes S0-S9 over the record and M1-M5 over the model graph (machine); SCI requirements tagged machine" .

term:validation a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "validation"@en ;
    skos:definition "Confirming with objective evidence that the requirements for a specific intended use were fulfilled. Applied to the evaluation itself: was it aimed at the right problem and is the evidence enough. Both are human judgments, recorded in the attestation."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.14" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-32.png" ;
                    ogc:quote "confirmation, through the provision of objective evidence, that the requirements for a specific intended use or application have been fulfilled" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "validation, p. 464" ; ogc:pdfPage 464 ;
                  ogc:quote "confirmation, through the provision of objective evidence, that the requirements for a specific intended use or application have been fulfilled" ; ogc:quoteStatus "machine" ] ;
    skos:related term:verification ;
    skos:related term:attestation ;
    skos:related term:appropriateness ;
    ogc:binding "epo:Attestation (human); SCI requirements tagged human" .

term:test a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "test"@en ;
    skos:definition "Finding out whether requirements for a specific intended use are met. A session, in which probes are run turn by turn against the system under test, is a test; the evidence its turns yield feeds the attestations."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.13" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-32.png" ;
                    ogc:quote "determination according to requirements for a specific intended use or application" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "test execution, p. 434" ; ogc:pdfPage 434 ;
                  ogc:quote "process of running a test on the test item, producing actual results" ; ogc:quoteStatus "machine" ] ;
    skos:narrower term:session ;
    skos:related term:determination ;
    skos:related term:test-item ;
    ogc:binding "epo:Session with its epo:Turn activities (test execution; each turn's epo:Response is the actual result)" .

term:record a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "record"@en ;
    skos:definition "A document stating results achieved or giving evidence of activities performed: any document that records what was done or what was found, in the most general sense the standard gives the word. The evaluation record is its special case here, the record of one evaluation; the DSO release, the test plan and the report are records too, each in its own right."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.8.12" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-23.png" ;
                    ogc:quote "document stating results achieved or providing evidence of activities performed" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-48 (sheet 07-03): record is the abstract term and evaluation record its specialization, by subclassing; the narrower relation below says so." ;
    prov:wasDerivedFrom rul:R-48 ;
    skos:narrower term:evaluation-record ;
    skos:related term:objective-evidence ;
    ogc:binding "prov:Bundle; any prov:Entity of the record" .

term:stakeholder a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "stakeholder"@en ;
    skos:altLabel "interested party"@en ;
    skos:definition "A person or organization that can affect, be affected by, or believe itself affected by a decision or activity. The parties (the sponsor, the testing organization, the test item provider), the people who act for them, and the affected populations are the stakeholders named in this specification; customers and providers are kinds of interested party in the standard's own examples."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.4" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-02.png" ;
                    ogc:quote "person or organization that can affect, be affected by, or perceive itself to be affected by a decision or activity" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "stakeholder, p. 403" ; ogc:pdfPage 403 ;
                  ogc:quote "individual or organization having a right, share, claim, or interest in a system or in its possession of characteristics that meet their needs and expectations" ; ogc:quoteStatus "machine" ] ;
    skos:narrower term:customer ;
    skos:narrower term:provider ;
    skos:related term:organization ;
    skos:related term:mission ;
    skos:related term:test-item-customer ;
    skos:related term:statement-of-work ;
    ogc:binding "sysml part defs SponsorOrganization, TestingOrganization, AccountableOrganization, AffectedPopulation and the actor parts within the testing organization; prov:Person, prov:Organization" .

term:performance a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "performance"@en ;
    skos:definition "A measurable result. Here: how the system did on what was exercised, reported as the pass, fail and cannot-tell fractions of the covered criteria. Never merged with coverage."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.7.3" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-17.png" ;
                    ogc:quote "measurable result" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    skos:related term:test-coverage ;
    skos:related term:measurement-uncertainty ;
    ogc:binding "epo:Report passRate, failRate, cantTellRate" .

term:technical-expert a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "technical expert"@en ;
    skos:altLabel "domain expert"@en ; skos:altLabel "subject matter expert"@en ;
    skos:definition "A person who provides specific knowledge or expertise to the evaluation team. Two kinds sit on the team. The domain expert is expert in the Domain-Specific Ontology: they supply or approve its release, attest that it is appropriate for the case being evaluated (this system under test, these requirements, this operational environment), and may be consulted on interpreting evidence. The evaluation operator is expert in performing the tests the Evaluation Process Ontology specifies, conditioned on the DSO, and in assembling the evidence."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.12.9" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-34.png" ;
                    ogc:quote "person who provides specific knowledge or expertise to the audit team" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.12.9 Note 2 (transcribed from the 2015 edition's 3.13.16, awaiting Z's tick against the screenshot)" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-34.png" ;
                  ogc:quote "A technical expert does not act as an auditor in the audit team." ; ogc:quoteStatus "pending" ] ;
    ogc:scopeNote "Ruling R-10: the ISO entry is marked <audit>; here the team is an evaluation team, not an audit team, and both the domain expert and the evaluation operator are technical experts on it (R-23 names the second). Assessors of the assessment are out of scope (R-11). Sheet 10-25 (R-50): the standard's Note 2 keeps the technical expert from acting as an auditor; here not all technical experts attest, but every attestation comes from a relevant role, the domain expert, so the term specializes the standard's. Z: \"not all technical experts attest but all attestation must come from relevant roles, in this case a technical expert.\"" ;
    prov:wasDerivedFrom rul:R-10 ; prov:wasDerivedFrom rul:R-50 ;
    skos:narrower term:evaluation-operator ;
    skos:related term:evaluation-team ;
    skos:related term:domain-specific-ontology ;
    ogc:binding "sysml part defs DomainExpert and EvaluationOperator; prov:Person" .

term:acceptance-criteria a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "acceptance criteria"@en ;
    skos:altLabel "acceptance criterion"@en ;
    skos:definition "A specific, checkable condition a response must meet for a requirement to count as satisfied. The unit that coverage is measured over: each criterion either traces to an attested outcome or it does not."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "acceptance criteria, p. 4" ; ogc:pdfPage 4 ;
                    ogc:quote "criteria that a system or component is required to satisfy to be accepted by a user, customer, or other authorized entity" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:incose-gtwr-v4 ; ogc:locator "C7 Verifiable, p. 2" ; ogc:pdfPage 2 ;
                  ogc:quote "The requirement statement is structured and worded such that its realization can be verified to the approving authority's satisfaction." ; ogc:quoteStatus "machine" ] ;
    skos:broader term:requirement ;
    skos:related term:expected-results ;
    skos:related term:test-coverage ;
    skos:related term:test-plan ;
    ogc:binding "epo:AcceptanceCriterion; sysml item def AcceptanceCriterion (weight, minPassRate)" .

term:requirements-traceability a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "requirements traceability"@en ;
    skos:definition "The documented path linking what was required to how it was tested and what was found, so a coverage claim can be checked by anyone holding the record."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "requirements traceability, p. 352" ; ogc:pdfPage 352 ;
                    ogc:quote "identification and documentation of the derivation path (upward) and allocation/ flow-down path (downward) of requirements in the requirements set" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.5.11 traceability" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-13.png" ;
                  ogc:quote "ability to trace the history, application or location of an object" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:jcgm-200-2012 ; ogc:locator "2.41 metrological traceability, p. 45" ; ogc:pdfPage 45 ;
                  ogc:quote "property of a measurement result whereby the result can be related to a reference through a documented unbroken chain of calibrations, each contributing to the measurement uncertainty" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-15: requirements traceability and metrological traceability are kept distinct, but they are in principle the same idea at different levels of abstraction once both are done computationally over knowledge graphs. Here computational instruments measure computational systems, so the metrological sense still applies: the chain from a reported number back to the record is an unbroken documented chain, and the pass rate it reaches carries a measurement uncertainty." ;
    prov:wasDerivedFrom rul:R-15 ;
    skos:related term:evaluation-record ;
    skos:related term:test-coverage ;
    ogc:binding "the chain requirement, acceptance criterion, test plan, probe, turn, evidence, attestation in the record; queries/traceback.rq" .

term:test-coverage a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "test coverage"@en ;
    skos:altLabel "coverage"@en ;
    skos:definition "How much of the declared acceptance criteria the evaluation actually reached, as a share weighted by deployment sensitivity. It says how much was evaluated, not how well the system did."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test coverage, p. 433" ; ogc:pdfPage 433 ;
                    ogc:quote "degree, expressed as a percentage, to which specified test coverage items have been exercised by a test case or test cases" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-01: coverage relates requirements to the abstract tests that cover them. The acceptance criterion is the coverage item and the probe is the test case; the concrete applications of a probe during a case produce evidence, which is rolled up by attestation. Coverage counts criteria with an attested outcome; it does not count evidence." ;
    prov:wasDerivedFrom rul:R-01 ;
    skos:related term:acceptance-criteria ;
    skos:related term:performance ;
    skos:related term:risk-based-testing ;
    skos:related term:requirements-traceability ;
    skos:related term:deployment-sensitivity ;
    ogc:binding "queries/coverage.rq; epo:Report coverage" .

term:test-case a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "test case"@en ;
    skos:definition "Inputs, execution conditions and expected results developed for a particular objective. The abstract test; a probe is a test case tied to the criteria it exercises."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test case, p. 432" ; ogc:pdfPage 432 ;
                    ogc:quote "set of test inputs, execution conditions, and expected results developed for a particular objective, such as to exercise a particular program path or to verify compliance with a specific requirement" ; ogc:quoteStatus "machine" ] ;
    skos:narrower term:probe ;
    skos:related term:scenario ;
    skos:related term:expected-results ;
    ogc:binding "epo:Probe" .

term:test-item a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "test item"@en ;
    skos:altLabel "system under test"@en ; skos:altLabel "SUT"@en ; skos:altLabel "test object"@en ; skos:altLabel "application"@en ; skos:altLabel "system of interest"@en ;
    skos:definition "The deployed AI system being evaluated, taken as a black box: only what it is given and what it produces are recorded. The prose calls it the system under test; the standard headword is test item."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test item, p. 435 (ISO/IEC/IEEE 29119-2:2021)" ; ogc:pdfPage 435 ;
                    ogc:quote "work product to be tested" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "system-of-interest (SOI), p. 423 (ISO/IEC/IEEE 15288:2023)" ; ogc:pdfPage 423 ;
                  ogc:quote "system whose life cycle is under consideration" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:nist-ai-700-2 ; ogc:locator "Appendix A, Application, p. 16 (fragment of the entry)" ; ogc:pdfPage 23 ;
                  ogc:quote "A generative artificial intelligence-based system to which NIST is given API access to test." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "system under test (SUT), p. 423 (ISO/IEC 14756:1999)" ; ogc:pdfPage 423 ;
                  ogc:quote "parts of the CBSS to be tested" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "artificial intelligence-based system, p. 28 (ISO/IEC TR 29119-11:2020)" ; ogc:pdfPage 28 ;
                  ogc:quote "system including one or more components implementing artificial intelligence" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.2 object of conformity assessment" ;
                  ogc:quote "entity to which specified requirements apply" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-19: the only standard definition of the phrase system under test is a 1999 performance-measurement one (ISO/IEC 14756), so the headword is test item (29119-2), from the same family as test case, test plan and test strategy; the systems-engineering reading is system-of-interest (15288) and the AI-evaluation reading is NIST's application. The phrase system under test stays in prose and in the model as the alternative label." ;
    prov:wasDerivedFrom rul:R-19 ;
    skos:related term:test-item-provider ;
    skos:related term:test-item-customer ;
    skos:related term:operational-envelope ;
    skos:related term:non-deterministic-system ;
    skos:related term:test ;
    ogc:binding "sysml part def TestItem; earl:TestSubject and prov:SoftwareAgent; epo:systemUnderTest on the requirement set" .

term:operational-environment a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "operational environment"@en ;
    skos:altLabel "operating environment"@en ;
    skos:definition "The conditions and assumptions about the deployment setting under which acceptable behavior is defined: who uses the system, for what, and what is out of scope."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "operational environment, p. 282" ; ogc:pdfPage 282 ;
                    ogc:quote "physical context, setting, and circumstances used to support the in-service operation of a system" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-02 ;
    skos:related term:operational-envelope ;
    ogc:binding "epo:RequirementSet declares it; sysml item def RequirementSet" .

term:scenario a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "scenario"@en ;
    skos:definition "A step-by-step description of a situation the system is put through: the user, their circumstances, and what they ask. A scenario becomes a probe once it is tied to the criteria it exercises."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "scenario, p. 369" ; ogc:pdfPage 369 ;
                    ogc:quote "step-by-step description of a series of events that occur concurrently or sequentially" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:nist-ai-700-2 ; ogc:locator "Appendix A, Scenario, p. 17 (first sentence of the entry)" ; ogc:pdfPage 24 ;
                  ogc:quote "The context in which structured AI evaluation activities are performed." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "test scenario, p. 438 (ISO/IEC TR 29119-11:2020, testing of AI-based systems)" ; ogc:pdfPage 438 ;
                  ogc:quote "situation or setting for a test item used as the basis for generating test cases" ; ogc:quoteStatus "machine" ] ;
    skos:related term:probe ;
    skos:related term:test-case ;
    ogc:binding "epo:Probe carries the scenario text" .

term:risk-based-testing a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "risk-based testing"@en ;
    skos:definition "Testing in which what is tested, and how much, is chosen according to analyzed risk. Deployment sensitivity is the weight that makes coverage reflect consequence."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "risk-based testing, p. 362" ; ogc:pdfPage 362 ;
                    ogc:quote "testing in which the management, selection, prioritization, and use of testing activities and resources are consciously based on corresponding types and levels of analyzed risk" ; ogc:quoteStatus "machine" ] ;
    skos:related term:deployment-sensitivity ;
    skos:related term:test-coverage ;
    ogc:binding "epo:weight on AcceptanceCriterion" .

term:evaluation a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation"@en ;
    skos:altLabel "AI evaluation"@en ;
    skos:definition "Systematically determining how far something meets its specified criteria. An OG-CAIE evaluation determines, for a declared requirement set, which criteria the system under test met, and reports coverage and performance separately."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "evaluation, p. 155" ; ogc:pdfPage 155 ;
                    ogc:quote "systematic determination of the extent to which an entity meets its specified criteria" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:nist-ai-100-1 ; ogc:locator "Section 3, p. 35" ; ogc:pdfPage 40 ;
                  ogc:quote "Test, Evaluation, Verification, and Validation (TEVV) tasks are performed throughout the AI lifecycle." ; ogc:quoteStatus "machine" ] ;
    skos:narrower term:contextual-ai-evaluation ;
    skos:related term:evaluation-team ;
    skos:related term:monitoring ;
    ogc:binding "sysml part def OgCaieEvaluation; action def EvaluationProcess" .

term:test-plan a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "test plan"@en ;
    skos:definition "The statement, made before any test runs, of what the evaluation will test and how: which acceptance criteria are its objectives, which probes are its means, and what each probe is expected to show. Derived from the requirement set and the Domain-Specific Ontology in step three; every attestation is bound to the plan that produced its evidence."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test plan, p. 437" ; ogc:pdfPage 437 ;
                    ogc:quote "detailed description of test objectives to be achieved and the means and schedule for achieving them, organized to coordinate testing activities for some test item or set of test items" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-12 ;
    skos:related term:test-strategy ;
    skos:related term:probe ;
    skos:related term:acceptance-criteria ;
    ogc:binding "epo:TestPlan, a prov:Entity; sysml item def TestPlan" .

term:expected-results a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "expected results"@en ;
    skos:altLabel "expected result"@en ;
    skos:definition "What the system under test should observably do if it meets an acceptance criterion under the probe's conditions. Stated on the criterion before testing, so the criterion is defined in terms of evidence a test can collect, and the attestation is a judgment that the actual result did or did not correspond."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "expected results, p. 160" ; ogc:pdfPage 160 ;
                    ogc:quote "observable predicted behavior of the test item under specified conditions based on its specification or another source" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-12 ;
    skos:related term:acceptance-criteria ;
    skos:related term:outcome ;
    skos:related term:requirement ;
    skos:related term:test-case ;
    ogc:binding "epo:expectedResult on AcceptanceCriterion; sysml attribute expectedResultStated" .

term:session a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "session"@en ;
    skos:definition "One pairing of one tester with one system under test, in which a sequence of turns is run. Sessions are stateful: what the system says at a later turn depends on everything said before, so evidence belongs to its session, not only to its probe."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:nist-ai-700-2 ; ogc:locator "Appendix A, Session, p. 17 (first sentence of the entry)" ; ogc:pdfPage 24 ;
                    ogc:quote "A single unit of ARIA testing, consisting of a pairing of one tester and one application." ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-13 ;
    skos:broader term:test ;
    skos:related term:dialogue ;
    skos:related term:trajectory ;
    skos:related term:test-suite ;
    skos:related term:objective-evidence ;
    ogc:binding "epo:Session, a prov:Activity (the test execution); sysml item def Session" .

term:dialogue a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "dialogue"@en ;
    skos:altLabel "conversation"@en ; skos:altLabel "dialog"@en ;
    skos:definition "The ordered prompts to, and responses by, the system under test within one session. Its recorded form is the trajectory."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "dialog, p. 129 (ISO TR 25060:2023, 2.4)" ; ogc:pdfPage 129 ;
                    ogc:quote "interaction between a user and an interactive system as a sequence of user actions (inputs) and system responses (outputs) in order to achieve a goal" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:nist-ai-700-2 ; ogc:locator "Appendix A, Dialogue, p. 16 (first sentence of the entry)" ; ogc:pdfPage 23 ;
                  ogc:quote "A set of prompts to, and responses by, an application." ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Sheet 10-45 (R-51): SEVOCAB defines dialog (synonym dialogue) as the user's interaction with an interactive system, the sense used here, so it takes the canonical; NIST's AI-evaluation wording stays beside it." ;
    prov:wasDerivedFrom rul:R-51 ;
    prov:wasDerivedFrom rul:R-13 ;
    skos:related term:trajectory ;
    skos:related term:session ;
    ogc:binding "epo:Trajectory holds the dialogue as ordered turns" .

term:trajectory a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:altLabel "realization"@en ; skos:altLabel "history"@en ;
    skos:prefLabel "trajectory"@en ;
    skos:definition "The recorded sequence of prompt and response pairs of a session, in order. The system's internal state is never observed; the trajectory is the observable realization, and plays the role a time series of measurements plays in system identification. A small change early in a trajectory can change everything after it."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iec-60050-351 ; ogc:locator "351-41-10 trajectory" ;
                    ogc:quote "representation of the solution x(t) of the state equation as connecting line of the ends of the vector x(t) in state space with time as parameter" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iec-60050-351 ; ogc:locator "351-41-08 state variable, Note 1" ;
                  ogc:quote "In case of discrete-time variables the describing equations are xi+1 = f (xi, ui) state equation vi = g (xi, ui) output equation" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-13: the IEC trajectory runs through the hidden state x; what the record holds is the input-output realization, which specializes it to what is observable." ;
    prov:wasDerivedFrom rul:R-13 ;
    skos:related term:dialogue ;
    skos:related term:session ;
    skos:related term:test-strategy ;
    skos:related term:objective-evidence ;
    ogc:binding "epo:Trajectory, a prov:Entity generated by a Session; ordered epo:Turn activities" .

term:test-strategy a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "test strategy"@en ;
    skos:altLabel "state feedback policy"@en ; skos:altLabel "semantic state feedback"@en ; skos:altLabel "strategy"@en ;
    skos:definition "The part of a test plan that decides which probe comes next from the trajectory so far, grounded in the Domain-Specific Ontology, rather than listing probes in advance. It closes a loop: the system's outputs feed back into the choice of the next input. A human red teamer following their own judgment is one such strategy; a written policy is another."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test strategy, p. 439" ; ogc:pdfPage 439 ;
                    ogc:quote "part of the test plan that describes the approach to testing for a specific project, test level, or test type" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iec-60050-351 ; ogc:locator "351-47-29 output-feedback control" ;
                  ogc:quote "closed-loop control with feedback of the measured output variables only" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iec-60050-351 ; ogc:locator "351-47-31 observer" ;
                  ogc:quote "system for complete reconstruction of the state of a controlled system from measured input and output variables, using a model of the controlled system" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "exploratory testing, p. 161 (fragment of the entry)" ; ogc:pdfPage 161 ;
                  ogc:quote "type of unscripted experience-based testing in which the tester spontaneously designs and executes tests based on the tester's existing relevant knowledge, prior exploration of the test item (including the results of previous tests)" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-13: anchored to output feedback because the record only ever holds outputs; the memory operator with the DSO as model is the observer. Semantic state feedback is the authors' framing, kept as an alternative label." ;
    prov:wasDerivedFrom rul:R-13 ;
    skos:related term:test-plan ;
    skos:related term:trajectory ;
    skos:related term:red-teaming ;
    ogc:binding "epo:Strategy, a prov:Plan; a TestPlan's means alongside listed probes" .

term:non-deterministic-system a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "non-deterministic system"@en ;
    skos:altLabel "nondeterministic system"@en ;
    skos:definition "A system that, given the same inputs and starting state, will not always produce the same outputs. The system under test is one, which is why a single probe is weak evidence and why pass rates are estimated over replicate sessions."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "non-deterministic system, p. 272 (ISO/IEC TR 29119-11:2020, testing of AI-based systems)" ; ogc:pdfPage 272 ;
                    ogc:quote "system which, given a particular set of inputs and starting state, will not always produce the same set of outputs and final state" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "probabilistic system, p. 311" ; ogc:pdfPage 311 ;
                  ogc:quote "system whose behavior is described in terms of probabilities, such that its outputs cannot be perfectly predicted" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-13: the sensitivity the authors describe, a small change of input producing a large change of output especially when a trajectory is continued, is stated here in prose; no term is coined for it." ;
    prov:wasDerivedFrom rul:R-13 ;
    skos:related term:test-item ;
    skos:related term:repeatability ;
    ogc:binding "sysml part def TestItem; earl:TestSubject" .

term:repeatability a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "repeatability"@en ;
    skos:definition "How closely results agree when the same measurement is repeated under the same conditions: same system version, same procedure, same operator or policy, same session protocol, over a short period. Replicate sessions under repeatability conditions are what turn a probe into a pass rate."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "repeatability (of results of measurements), p. 348 (ISO/IEC TR 14143-3:2003, 3.8; ISO/IEC 25021:2012, 4.15)" ; ogc:pdfPage 348 ;
                    ogc:quote "closeness of the agreement between the results of successive measurements of the same measurand carried out under the same conditions of measurement" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:jcgm-200-2012 ; ogc:locator "2.21 measurement repeatability, p. 40" ; ogc:pdfPage 40 ;
                  ogc:quote "measurement precision under a set of repeatability conditions of measurement" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Sheet 10-45 (R-51): SEVOCAB defines repeatability of results of measurements, so it takes the canonical by the precedence rule; JCGM 200's definition, the earlier canonical, stays beside it." ;
    prov:wasDerivedFrom rul:R-51 ;
    ogc:seeAlso [ ogc:cites src:jcgm-200-2012 ; ogc:locator "2.20 repeatability condition of measurement, p. 39" ; ogc:pdfPage 39 ;
                  ogc:quote "condition of measurement, out of a set of conditions that includes the same measurement procedure, same operators, same measuring system, same operating conditions and same location, and replicate measurements on the same or similar objects over a short period of time" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:nist-tn-1297 ; ogc:locator "Appendix D.1.1.2, p. 14 (the same words as SEVOCAB's)" ; ogc:pdfPage 19 ;
                  ogc:quote "closeness of the agreement between the results of successive measurements of the same measurand carried out under the same conditions of measurement" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-13 ;
    skos:related term:reproducibility ;
    skos:related term:non-deterministic-system ;
    skos:related term:measurement-uncertainty ;
    skos:related term:test-suite ;
    ogc:binding "replicate epo:Session activities under one Strategy against one SUT version; minPassRate on the criterion" .

term:reproducibility a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "reproducibility"@en ;
    skos:definition "How closely results agree when the measurement is repeated under changed conditions: different operators, different sessions, a different evaluation team. Two evaluations that share a requirement set and a DSO release are comparable to the extent their results reproduce."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "reproducibility (of results of measurements), p. 349 (ISO/IEC TR 14143-3:2003, 3.9; ISO/IEC 25021:2012, 4.16)" ; ogc:pdfPage 349 ;
                    ogc:quote "closeness of the agreement between the results of measurements of the same measurand carried out under changed conditions of measurement" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:jcgm-200-2012 ; ogc:locator "2.25 measurement reproducibility, p. 41" ; ogc:pdfPage 41 ;
                  ogc:quote "measurement precision under reproducibility conditions of measurement" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Sheet 10-45 (R-51): SEVOCAB defines reproducibility of results of measurements, so it takes the canonical; JCGM 200 stays beside it." ;
    prov:wasDerivedFrom rul:R-51 ;
    ogc:seeAlso [ ogc:cites src:jcgm-200-2012 ; ogc:locator "2.24 reproducibility condition of measurement, p. 40" ; ogc:pdfPage 40 ;
                  ogc:quote "condition of measurement, out of a set of conditions that includes different locations, operators, measuring systems, and replicate measurements on the same or similar objects" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:nist-tn-1297 ; ogc:locator "Appendix D.1.1.3, p. 14 (the same words as SEVOCAB's)" ; ogc:pdfPage 19 ;
                  ogc:quote "closeness of the agreement between the results of measurements of the same measurand carried out under changed conditions of measurement" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-13 ;
    skos:related term:repeatability ;
    ogc:binding "the record's fixed frame: requirement set, DSO release, test plan, session protocol" .

term:measurement-uncertainty a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "measurement uncertainty"@en ;
    skos:altLabel "uncertainty"@en ;
    skos:definition "A non-negative number that says how dispersed the values attributed to a measured quantity are. A probe pass rate estimated from replicate sessions carries one; coverage, counted exactly over the record, does not."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:jcgm-200-2012 ; ogc:locator "2.26 measurement uncertainty, p. 41" ; ogc:pdfPage 41 ;
                    ogc:quote "non-negative parameter characterizing the dispersion of the quantity values being attributed to a measurand, based on the information used" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-13 ;
    skos:related term:repeatability ;
    skos:related term:performance ;
    ogc:binding "epo:Report passRate carries an uncertainty when estimated from replicates; coverage does not" .

# ------------------------------------------------------------ NIST AI 700-2

term:red-teaming a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "red teaming"@en ;
    skos:definition "A testing level in which human testers probe the system adversarially to see whether it stays within its guardrails. One way to run the probes in step four."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:nist-ai-700-2 ; ogc:locator "Appendix A, Red teaming, p. 17" ; ogc:pdfPage 24 ;
                    ogc:quote "Testing level which evaluates whether applications adhere to guardrails in response to adversarial prompting or stress testing by human testers." ; ogc:quoteStatus "machine" ] ;
    skos:related term:test-strategy ;
    skos:related term:evaluation-operator ;
    skos:related term:guardrail ;
    ogc:binding "sysml part def EvaluationOperator (red teamer); epo:Session with a prov:Person in the evaluation operator role" .

term:guardrail a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "guardrail"@en ;
    skos:definition "A requirement on the system stating what may be shared with a user and what must be withheld. Recommendations at the end of an evaluation typically propose changes to guardrails."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:nist-ai-700-2 ; ogc:locator "Appendix A, Guardrail, p. 17 (first sentence of the entry)" ; ogc:pdfPage 24 ;
                    ogc:quote "An application requirement specifying both 1) permitted information that can be shared with a user, and 2) prohibited information that should be withheld from a user." ; ogc:quoteStatus "machine" ] ;
    skos:broader term:requirement ;
    skos:related term:red-teaming ;
    ogc:binding "epo:Recommendation targets a guardrail" .

# ------------------------------------- sources ranked 5 to 8 (ordinal, sheet 10-46)

term:attestation a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "attestation"@en ;
    skos:altLabel "annotation"@en ;
    skos:definition "The recorded judgment of a named person that links one acceptance criterion to the evidence reviewed and records an outcome, together with the judgments of appropriateness of the declared context and sufficiency of the evidence."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "7.3" ;
                    ogc:quote "issue of a statement, based on a decision, that fulfilment of specified requirements has been demonstrated" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Sheet 10-23 (R-50): ISO/IEC 17000's attestation is the positive statement that fulfilment has been demonstrated, the negative case being a decision (7.2). This specification extends it: with EARL, an attestation records passed, failed or cannot tell, conditioned on specific evidence, and a new attestation may supersede an old one when more evidence is secured. Z: \"scope note states the extension and we're explicitly using EARL so you can attest pass/fail/cannot tell. these are conditioned on specific evidence, new attestations can supercede old attestations if more evidence is secured\"." ;
    prov:wasDerivedFrom rul:R-50 ;
    skos:related term:determination ;
    skos:related term:appropriateness ;
    skos:related term:sufficiency ;
    skos:related term:validation ;
    skos:related term:conformity ;
    skos:related term:outcome ;
    ogc:binding "epo:Attestation, an earl:Assertion and a prov:Activity; aggregates the determinations for a criterion, each bound to its evidence and through it to the test plan" .

term:appropriateness a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "appropriateness"@en ;
    skos:definition "The expert judgment that the declared context (operational environment, requirement set and Domain-Specific Ontology) was the right frame for the judgment being made. Not whether the system passed, and not whether there was enough evidence."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:hawkins-2011 ; ogc:locator "Section 3.2 Asserted context, p. 7" ; ogc:pdfPage 7 ;
                    ogc:quote "it is being asserted that the context is appropriate for the argument elements to which it applies" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:isa-500 ; ogc:locator "paragraph 5(b) (fragment of the paragraph)" ; ogc:pdfPage 2 ;
                  ogc:quote "The measure of the quality of audit evidence; that is, its relevance and its reliability" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.2 review" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-30.png" ;
                  ogc:quote "determination of the suitability, adequacy or effectiveness of an object to achieve established objectives" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    prov:wasDerivedFrom rul:R-08 ;
    skos:related term:attestation ;
    skos:related term:sufficiency ;
    skos:related term:validation ;
    ogc:binding "epo:appropriateness on Attestation; sysml enum Appropriateness" .

term:sufficiency a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "sufficiency"@en ;
    skos:definition "The expert judgment that the evidence gathered is enough to support the claim being made. A quantity judgment, distinct from appropriateness. A judgment with no evidence cannot record a pass or a fail."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:hawkins-2011 ; ogc:locator "Section 3.3 Asserted solution, p. 10" ; ogc:pdfPage 10 ;
                    ogc:quote "it is being asserted that the evidence put forward is sufficient to support the claim" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:isa-500 ; ogc:locator "paragraph 5(f) (first sentence of the paragraph)" ; ogc:pdfPage 2 ;
                  ogc:quote "The measure of the quantity of audit evidence." ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-08 ;
    skos:related term:attestation ;
    skos:related term:appropriateness ;
    skos:related term:objective-evidence ;
    ogc:binding "epo:sufficiency on Attestation; sysml enum Sufficiency; closure rule in shape S6" .

term:ontology a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "ontology"@en ;
    skos:definition "A shared, formal vocabulary for a domain, precise enough that a computer can check whether a body of data follows its rules."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "ontology, p. 280 (ISO/IEC/IEEE 24641:2023, 3.1.23)" ; ogc:pdfPage 280 ;
                    ogc:quote "logical structure of the terms used to describe a domain of knowledge, including both the definitions of the applicable terms and their relationships" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:gruber-1993 ; ogc:locator "Section 1, p. 2 (author copy)" ; ogc:pdfPage 2 ;
                  ogc:quote "An ontology is an explicit specification of a conceptualization." ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Sheet 10-45 (R-51): the SEVOCAB check of 2026-09-07 found ontology defined there, so it takes the canonical by the precedence rule; Gruber's definition, the earlier canonical, stays beside it." ;
    prov:wasDerivedFrom rul:R-51 ;
    skos:narrower term:domain-specific-ontology ;
    skos:narrower term:evaluation-process-ontology ;
    skos:related term:knowledge-graph ;
    ogc:binding "OWL/RDFS vocabulary plus SHACL shapes" .

term:knowledge-graph a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "knowledge graph"@en ;
    skos:definition "The body of domain facts, expressed in an ontology's vocabulary, that answers are judged against. It conforms to the ontology and may hold more context than the ontology alone."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:hogan-2021 ; ogc:locator "Section 1, p. 2 (arXiv v3)" ; ogc:pdfPage 2 ;
                    ogc:quote "a graph of data intended to accumulate and convey knowledge of the real world, whose nodes represent entities of interest and whose edges represent relations between these entities" ; ogc:quoteStatus "machine" ] ;
    skos:narrower term:authoritative-reference ;
    skos:related term:ontology ;
    ogc:binding "an RDF data graph conforming to the DSO" .

term:outcome a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "outcome"@en ;
    skos:definition "The result recorded for a judgment: passed, failed or cannot tell, the three EARL values the record uses (EARL also allows inapplicable and untested). Not binary on purpose."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test result, p. 438" ; ogc:pdfPage 438 ;
                    ogc:quote "indication of whether a specific test case has passed or failed, i.e. if the actual results correspond to the expected results or if deviations were observed" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:w3c-earl ; ogc:locator "Section 2.7 OutcomeValue Class" ;
                    ogc:quote "a value or expression that describes a resulting condition from carrying out the test" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-06): the canonical definition is SEVOCAB's test result; EARL supplies the binding, not the definition." ;
    ogc:seeAlso [ ogc:cites src:nist-ai-700-2 ; ogc:locator "Section 3.1 Validity Risk Assessment, p. 5 (one of the four annotation values, a fragment)" ; ogc:pdfPage 12 ;
                  ogc:quote "Unable to Determine" ; ogc:quoteStatus "machine" ] ;
    skos:related term:determination ;
    skos:related term:attestation ;
    skos:related term:expected-results ;
    ogc:binding "earl:outcome with earl:passed, earl:failed, earl:cantTell, earl:inapplicable, earl:untested; sysml enum Outcome" .

# ------------------------------------------------------------------ refined

term:probe a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "probe"@en ;
    skos:altLabel "test case (SEVOCAB, tied to criteria)"@en ; skos:altLabel "prompt"@en ; skos:altLabel "task"@en ;
    skos:definition "A scenario tied to the acceptance criteria it exercises, derived from the Domain-Specific Ontology and checked for consistency before use, applied at one turn of a session. Its run yields one prompt and response pair; the response collected is evidence bearing on those criteria. A test plan may list its probes or choose them by a test strategy as the trajectory unfolds."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "test case, p. 432 (fragment of the entry)" ; ogc:pdfPage 432 ;
                    ogc:quote "set of test inputs, execution conditions, and expected results developed for a particular objective" ; ogc:quoteStatus "machine" ] ;
    skos:broader term:test-case ;
    skos:related term:scenario ;
    skos:related term:test-plan ;
    ogc:binding "epo:Probe, a prov:Entity; sysml item def Probe" .

term:deployment-sensitivity a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "deployment sensitivity"@en ;
    skos:altLabel "risk weight"@en ; skos:altLabel "weight"@en ;
    skos:definition "The weight each acceptance criterion carries, set by the consequence of the system getting it wrong in this deployment. Coverage is computed against these weights so it reflects consequence rather than count."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "risk-based testing, p. 362 (fragment of the entry)" ; ogc:pdfPage 362 ;
                    ogc:quote "prioritization, and use of testing activities and resources are consciously based on corresponding types and levels of analyzed risk" ; ogc:quoteStatus "machine" ] ;
    prov:wasDerivedFrom rul:R-05 ;
    skos:related term:risk-based-testing ;
    skos:related term:test-coverage ;
    ogc:binding "epo:weight; sysml attribute weight on AcceptanceCriterion" .

term:evaluation-record a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation record"@en ;
    skos:altLabel "record (ISO 9000:2026 3.8.12, of one evaluation)"@en ; skos:altLabel "test log"@en ;
    skos:definition "The record of one evaluation, bound by the Evaluation Process Ontology: the DSO release, the requirement set, the test plan, the probes, the sessions and their trajectories, the evidence, the attestations, the report and the recommendations, with who did what and when. The EPO determines what must be present for requirements traceability in both directions and for coverage, and makes all three checkable by machine; a conformant record therefore provides both traceability directions and coverage."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.8.12 record" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-23.png" ;
                    ogc:quote "document stating results achieved or providing evidence of activities performed" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "test log, p. 436" ; ogc:pdfPage 436 ;
                  ogc:quote "chronological record of relevant details about the execution of tests" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-17. Downward: requirement to acceptance criteria to test plan to probes (shapes S2, S3). Upward: attestation to evidence to turn to probe to criterion to requirement (shapes S6, S8; queries/traceback.rq). Coverage: the weighted share of criteria with an attested outcome (shape S7; queries/coverage.rq)." ;
    prov:wasDerivedFrom rul:R-17 ;
    skos:broader term:record ;
    skos:related term:requirements-traceability ;
    skos:related term:conformance ;
    skos:related term:evaluation-process-ontology ;
    ogc:binding "track/measles-run.ttl; a prov:Bundle" .

term:operational-envelope a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "operational envelope"@en ;
    skos:altLabel "requirement set"@en ;
    skos:definition "The requirements this system under test must meet in this operational environment, with their acceptance criteria and weights, declared before any probe is run. It refines the idea of a requirement by adding specificity: the same system in a different environment, or a different system in the same environment, gets a different envelope. That is what makes the evaluation contextual, and what separates it from a benchmark; the nearest practice is that of safety-critical systems. Coverage is measured over the envelope and only over it."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.5.1 requirement" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-11.png" ;
                    ogc:quote "need or expectation that is stated, generally implied or obligatory" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Rulings R-03 and R-14: a house label for the requirement set bound to one system under test in one operational environment; not a coinage. Two evaluations are comparable only when they share an envelope." ;
    prov:wasDerivedFrom rul:R-03 ;
    prov:wasDerivedFrom rul:R-14 ;
    skos:broader term:requirement ;
    skos:related term:operational-environment ;
    skos:related term:test-item ;
    ogc:binding "epo:RequirementSet with epo:environment and epo:systemUnderTest; sysml item def RequirementSet" .

term:authoritative-reference a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "authoritative reference"@en ;
    skos:altLabel "source of truth"@en ; skos:altLabel "knowledge graph (as the reference for one evaluation)"@en ;
    skos:definition "The knowledge graph, populated with the facts of the situation and conforming to the Domain-Specific Ontology, against which responses are judged."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "corresponds" ;
    ogc:canonical [ ogc:cites src:hogan-2021 ; ogc:locator "Section 1, p. 2 (arXiv v3) (fragment of the entry)" ; ogc:pdfPage 2 ;
                    ogc:quote "a graph of data intended to accumulate and convey knowledge of the real world" ; ogc:quoteStatus "machine" ] ;
    skos:broader term:knowledge-graph ;
    skos:related term:domain-specific-ontology ;
    ogc:binding "an RDF data graph that conforms to the DSO release" .

# ------------------------------------------------------------------- coined

term:domain-specific-ontology a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "Domain-Specific Ontology"@en ;
    skos:altLabel "DSO"@en ;
    skos:definition "The vocabulary and relations of the problem domain, imported from an existing ontology or supplied by domain experts, that equip one evaluation with the concepts it needs. A domain expert supplies or approves the release used. It changes when the domain changes."@en ;
    ogc:class "coined" ;
    ogc:coinedBy "Zargham and Hollek, for this specification (ruling R-47, sheet 06-10)" ;
    prov:wasDerivedFrom rul:R-09 ;
    skos:broader term:ontology ;
    skos:related term:authoritative-reference ;
    skos:related term:technical-expert ;
    skos:related term:og-caie ;
    ogc:binding "epo:DsoRelease (version, approvedBy); sysml item def DsoRelease" .

term:evaluation-process-ontology a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "Evaluation Process Ontology"@en ;
    skos:altLabel "EPO"@en ;
    skos:definition "The reusable, domain-independent description of how a rigorous evaluation is run: the standard operating procedure whose six steps, performed inside the contracting lifecycle, make a coverage claim checkable when followed. It assumes a Domain-Specific Ontology is in place and does not change across domains."@en ;
    ogc:class "coined" ;
    ogc:coinedBy "Zargham and Hollek, for this specification (ruling R-47, sheet 06-10)" ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "test process, p. 438 (ISO/IEC/IEEE 29119-2:2021, 3.55)" ; ogc:pdfPage 438 ;
                  ogc:quote "set of testing activities performed to achieve a test objective" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sebok-2-14 ; ogc:locator "Applying Life Cycle Processes, p. 444 (ISO/IEC/IEEE 24748-2 on 15288)" ; ogc:pdfPage 444 ;
                  ogc:quote "Each of the four process groups (Agreement Processes, Organizational Project-Enabling Processes, Technical Management Processes, and Technical Processes) can be used to establish a common understanding in a project." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.1 conformity assessment, Note 3" ;
                  ogc:quote "Conformity assessment is explained in Annex A as a series of functions. Activities contributing to any of these functions can be described as conformity assessment activities." ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Rulings R-31 and R-32: the steps are not invented. Each step in vocabulary/epo.ttl cites the process step it matches: the contracting lifecycle (need, propose, agree, access, deliver, accept) matches the ISO/IEC/IEEE 15288 agreement processes, ISO/IEC 17000 access, scheme and acceptance, ISO 9000 contract and the 29119-2 test environment and completion report; scope and declare requirements match the ISO/IEC/IEEE 15288 acquisition, stakeholder needs definition and system requirements definition processes as SEBoK describes them; plan, execute and report match the ISO/IEC/IEEE 29119-2 test strategy and planning, test execution and test completion processes as SEVOCAB defines them; determine and attest matches ISO/IEC 17000's review, decision and attestation. The EPO operationalizes those steps as executable checks." ;
    prov:wasDerivedFrom rul:R-09 ; prov:wasDerivedFrom rul:R-31 ;
    skos:broader term:ontology ;
    skos:related term:og-caie ;
    skos:related term:evaluation-record ;
    ogc:binding "vocabulary/epo.ttl; sysml action def EvaluationProcess" .

term:contextual-ai-evaluation a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "Contextual AI Evaluation"@en ;
    skos:altLabel "CAIE"@en ;
    skos:definition "The evaluation of a deployed AI system against the needs of a specific domain and deployment context, judged by people who know that domain. The class of evaluation this specification is for; OG-CAIE is the way it is performed here."@en ;
    ogc:class "coined" ;
    ogc:coinedBy "Zargham and Hollek, for this specification (ruling R-47, sheet 06-10)" ;
    prov:wasDerivedFrom rul:R-29 ;
    skos:broader term:evaluation ;
    skos:narrower term:og-caie ;
    ogc:binding "the scope of the specification; no node of its own" .

term:og-caie a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "OG-CAIE"@en ;
    skos:altLabel "Ontology-Grounded Contextual AI Evaluation"@en ;
    skos:definition "Contextual AI Evaluation performed with the method this specification sets out: the Evaluation Process Ontology, the same six steps for every domain inside a contracting lifecycle, applied with a Domain-Specific Ontology supplied or approved by the domain's experts, leaving a record anyone can check for conformance, traceability and coverage."@en ;
    ogc:class "coined" ;
    ogc:coinedBy "Zargham and Hollek, for this specification (ruling R-47, sheet 06-10)" ;
    prov:wasDerivedFrom rul:R-09 ; prov:wasDerivedFrom rul:R-29 ;
    skos:broader term:contextual-ai-evaluation ;
    skos:related term:evaluation-process-ontology ;
    skos:related term:domain-specific-ontology ;
    ogc:binding "sysml package OGCAIE; part def OgCaieEvaluation" .

# ---------------------------------------------------------------------------
# Parties to the evaluation (rulings R-21, R-23; concerns C-24, C-25, C-26)
# ---------------------------------------------------------------------------

term:organization a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "organization"@en ;
    skos:definition "A person or group of people with its own functions, responsibilities and authorities. Three organizations are parties to every OG-CAIE evaluation: the sponsor organization that commissions it, the testing organization that performs it (the evaluation service provider), and the test item provider accountable for the AI system under test. Any two of them may be the same organization, and the record says whether they are."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.1" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-01.png" ;
                    ogc:quote "person or group of people that has its own functions with responsibilities, authorities and relationships to achieve its objectives" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    prov:wasDerivedFrom rul:R-21 ;
    skos:narrower term:provider ;
    skos:related term:customer ;
    skos:related term:stakeholder ;
    ogc:binding "sysml part def Organization; prov:Organization" .

term:customer a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "customer"@en ;
    skos:definition "A person or organization that receives a product or a service. Two products change hands around an OG-CAIE evaluation, so there are two customers: the evaluation customer, the sponsor, receives the evaluation as a service; the test item customer receives the AI system under test, as the sponsor sometimes does and as the affected populations do when they use it. The two may be the same organization, and the record says whether they are."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.9.1" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-24.png" ;
                    ogc:quote "person or organization that can or does receive a product or a service that is intended for or required by this person or organization" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-21 named the sponsor organization the customer; the tbox audit (sheet 08, on Z's instruction) keeps customer as ISO 9000's genus and makes its two specializations explicit as narrower terms: evaluation customer (the sponsor) and test item customer." ;
    prov:wasDerivedFrom rul:R-21 ;
    skos:broader term:stakeholder ;
    skos:narrower term:evaluation-customer ;
    skos:narrower term:test-item-customer ;
    skos:related term:organization ;
    skos:related term:provider ;
    ogc:binding "epo:CustomerRole, the genus of epo:EvaluationCustomerRole and epo:TestItemCustomerRole; sysml part def Organization" .

term:provider a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "provider"@en ;
    skos:altLabel "supplier"@en ; skos:altLabel "contractor"@en ;
    skos:definition "An organization that provides a product or a service. Two products change hands around an OG-CAIE evaluation, so there are two providers: the evaluation service provider, the testing organization, provides the evaluation as a service; the test item provider provides, and is accountable for, the AI system under test. They are different organizations when the evaluation is independent, and the record states that fact rather than assuming it."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.9" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-03.png" ;
                    ogc:quote "organization that provides a product or a service" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-21 named the testing organization the provider; the tbox audit (sheet 08, on Z's instruction) keeps provider as ISO 9000's genus and makes its two specializations explicit as narrower terms: evaluation service provider (the testing organization) and test item provider (the accountable organization). ISO 9000:2026 3.1.9 Note 2 says a provider in a contractual situation is sometimes called a contractor, hence the altLabel." ;
    prov:wasDerivedFrom rul:R-21 ;
    skos:broader term:organization ;
    skos:broader term:stakeholder ;
    skos:narrower term:evaluation-service-provider ;
    skos:narrower term:test-item-provider ;
    skos:related term:customer ;
    ogc:binding "epo:ProviderRole, the genus of epo:EvaluationServiceProviderRole and epo:TestItemProviderRole; sysml part def Organization" .

term:evaluation-service-provider a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation service provider"@en ;
    skos:related term:test-item-provider ;
    skos:altLabel "testing organization"@en ; skos:altLabel "provider (ISO 9000:2026 3.1.9, of the evaluation)"@en ;
    skos:definition "The organization that provides the evaluation as a service: the testing organization. Its authorized representative signs the contract and delivers the report, its evaluation team does the work, and its machines keep the record. When it is independent of the test item provider and has no user interest in the test item, its activity is third-party in ISO/IEC 17000's sense; the record states that independence as a fact."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.9 provider" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-03.png" ;
                    ogc:quote "organization that provides a product or a service" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.5 third-party conformity assessment activity" ;
                  ogc:quote "conformity assessment activity that is performed by a person or organization that is independent of the provider of the object of conformity assessment and has no user interest in the object" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.6 conformity assessment body" ] ;
    ogc:scopeNote "Tbox audit (sheet 08, on Z's instruction): the provider of the evaluation service, distinguished explicitly from the provider of the AI system under test. Ruling R-21 introduced the party under the headword provider." ;
    prov:wasDerivedFrom rul:R-21 ; prov:wasDerivedFrom rul:R-48 ;
    skos:broader term:provider ;
    skos:related term:evaluation-customer ; skos:related term:third-party-conformity-assessment-activity ; skos:related term:evaluation-team ; skos:related term:account-executive ; skos:related term:contract ;
    ogc:binding "epo:EvaluationServiceProviderRole; epo:testingOrganizationRole on the service agreement; sysml part def TestingOrganization" .

term:test-item-provider a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "test item provider"@en ;
    skos:altLabel "accountable organization"@en ; skos:altLabel "provider (ISO 9000:2026 3.1.9, of the test item)"@en ;
    skos:definition "The organization that provides, and is accountable for, the AI system under test: its vendor or its operator. It is a party to every evaluation because it grants access to the test item, but it does not perform the evaluation unless it is also the sponsor and the testing organization, and the record says so. In ISO/IEC 17000's terms it is the first party."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.9 provider" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-03.png" ;
                    ogc:quote "organization that provides a product or a service" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.3 first-party conformity assessment activity" ;
                  ogc:quote "conformity assessment activity that is performed by the person or organization that provides or that is the object of conformity assessment" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.2 object of conformity assessment" ;
                  ogc:quote "entity to which specified requirements apply" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Sheet 09 (block B4) and the tbox audit (sheet 08): the headword accountable organization becomes test item provider, kept as the alternative label; it specializes ISO 9000's provider, with ISO/IEC 17000's first party as the neighbour. Ruling R-48 (07-06) asked whether accountable organization was the right headword; ruling R-49 (block B2) records the renaming." ;
    prov:wasDerivedFrom rul:R-21 ; prov:wasDerivedFrom rul:R-48 ; prov:wasDerivedFrom rul:R-49 ;
    skos:broader term:provider ;
    skos:related term:test-item ; skos:related term:first-party-conformity-assessment-activity ; skos:related term:test-item-customer ; skos:related term:evaluation-service-provider ;
    ogc:binding "epo:TestItemProviderRole; epo:accountableOrganizationRole on the test-item access; sysml part def AccountableOrganization" .

term:evaluation-customer a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation customer"@en ;
    skos:altLabel "sponsor organization"@en ; skos:altLabel "sponsor"@en ; skos:altLabel "customer (ISO 9000:2026 3.9.1, of the evaluation)"@en ;
    skos:definition "The organization that receives the evaluation as a service: the sponsor. It states its mission and its need, agrees the requirement set with the testing organization under a contract, decides the statement of work, and receives and accepts the report and the recommendation. It may also be the test item customer, and it may commission the evaluation on behalf of affected populations who are, or who are affected by, the test item's customers."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.9.1 customer" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-24.png" ;
                    ogc:quote "person or organization that can or does receive a product or a service that is intended for or required by this person or organization" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.4 second-party conformity assessment activity" ;
                  ogc:quote "conformity assessment activity that is performed by a person or organization that has a user interest in the object of conformity assessment" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Tbox audit (sheet 08, on Z's instruction): the customer of the evaluation service, distinguished explicitly from the customer of the AI system under test. Ruling R-21 introduced the party under the headword customer. When the sponsor is not the test item provider, its position is that of a second party in ISO/IEC 17000's sense." ;
    prov:wasDerivedFrom rul:R-21 ; prov:wasDerivedFrom rul:R-48 ;
    skos:broader term:customer ;
    skos:related term:test-item-customer ; skos:related term:evaluation-service-provider ; skos:related term:second-party-conformity-assessment-activity ; skos:related term:mission ; skos:related term:statement-of-work ; skos:related term:contract ;
    ogc:binding "epo:EvaluationCustomerRole; epo:sponsorRole on the service agreement, the statement of work, the delivery and the acceptance; epo:actsOnBehalfOf the affected populations; sysml part def SponsorOrganization" .

term:test-item-customer a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:altLabel "user of the test item"@en ; skos:altLabel "customer (ISO 9000:2026 3.9.1, of the test item)"@en ;
    skos:prefLabel "test item customer"@en ;
    skos:definition "A person or organization that receives the AI system under test as a product or a service: its users, and the organization that deploys it. An affected population is a test item customer when it uses the system; other populations are affected indirectly, through other stakeholders' use. The sponsor is a test item customer when it is the deploying organization, and may commission the evaluation on behalf of the populations who are."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.9.1 customer" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-24.png" ;
                    ogc:quote "person or organization that can or does receive a product or a service that is intended for or required by this person or organization" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.4 interested party" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-02.png" ;
                  ogc:quote "person or organization that can affect, be affected by, or perceive itself to be affected by a decision or activity" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.4 second-party conformity assessment activity" ;
                  ogc:quote "conformity assessment activity that is performed by a person or organization that has a user interest in the object of conformity assessment" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Tbox audit (sheet 08, on Z's instruction): the customer of the AI system under test, distinguished explicitly from the customer of the evaluation. The affected populations of ruling R-21 are its customers or are affected through them; the record says which (epo:affectedAs)." ;
    prov:wasDerivedFrom rul:R-21 ; prov:wasDerivedFrom rul:R-48 ;
    skos:broader term:customer ;
    skos:related term:evaluation-customer ; skos:related term:test-item-provider ; skos:related term:stakeholder ; skos:related term:test-item ;
    ogc:binding "epo:TestItemCustomerRole; epo:testItemCustomerRole on the sponsor when it deploys the test item; epo:affectedAs epo:asCustomer on an affected population" .

term:first-party-conformity-assessment-activity a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "first-party conformity assessment activity"@en ;
    skos:altLabel "first party"@en ;
    skos:definition "Evaluation performed by the organization that provides or is accountable for the test item: the test item provider. In OG-CAIE the test item provider is a party to every evaluation, since it grants access to the test item, but it does not perform the evaluation unless it is also the sponsor and the testing organization, and the record says so."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.3 first-party conformity assessment activity" ;
                    ogc:quote "conformity assessment activity that is performed by the person or organization that provides or that is the object of conformity assessment" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-21: the organization accountable for the test item, whose headword is now test item provider (sheet 08). ISO/IEC 17000 4.3 Note 1: the first-, second- and third-party descriptors are not the legal identification of the parties to a contract; the contract here is between the sponsor and the testing organization. Concern C-25 asks whether the three party terms stay three adopted headwords." ;
    prov:wasDerivedFrom rul:R-21 ;
    skos:related term:test-item-provider ;
    skos:related term:second-party-conformity-assessment-activity ;
    skos:related term:third-party-conformity-assessment-activity ;
    ogc:binding "epo:accountableOrganizationRole on the test-item access (the first party is the test item provider); sysml part def AccountableOrganization" .

term:second-party-conformity-assessment-activity a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "second-party conformity assessment activity"@en ;
    skos:altLabel "second party"@en ;
    skos:definition "Evaluation performed by an organization with a user interest in the test item: a purchaser, a regulator, a deploying agency. The sponsor's own activity in commissioning and accepting an evaluation is second-party; the independent testing organization it commissions performs a third-party activity (sheet 10-08, R-50)."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.4 second-party conformity assessment activity" ;
                    ogc:quote "conformity assessment activity that is performed by a person or organization that has a user interest in the object of conformity assessment" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    prov:wasDerivedFrom rul:R-21 ;
    skos:related term:evaluation-customer ;
    skos:related term:first-party-conformity-assessment-activity ;
    skos:related term:third-party-conformity-assessment-activity ;
    ogc:binding "epo:sponsorRole when the sponsor is not the test item provider (record fact epo:isAccountable, S0)" .

term:third-party-conformity-assessment-activity a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "third-party conformity assessment activity"@en ;
    skos:altLabel "third party"@en ; skos:altLabel "independent testing"@en ;
    skos:definition "Evaluation performed by an organization independent of the provider of the test item and with no user interest in it, whoever commissions it (sheet 10-08, R-50). Independence of the testing organization from the test item provider is what makes an OG-CAIE result independent; the record states it as a fact about the parties rather than assuming it, and states separately whether the sponsor has a user interest."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.5 third-party conformity assessment activity" ;
                    ogc:quote "conformity assessment activity that is performed by a person or organization that is independent of the provider of the object of conformity assessment and has no user interest in the object" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    prov:wasDerivedFrom rul:R-21 ;
    skos:related term:evaluation-service-provider ;
    skos:related term:first-party-conformity-assessment-activity ;
    skos:related term:second-party-conformity-assessment-activity ;
    ogc:binding "epo:independentOfAccountable on the testing organization (record fact, S0)" .

term:contract a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "contract"@en ;
    skos:altLabel "service agreement"@en ; skos:altLabel "agreement"@en ;
    skos:definition "The binding agreement between the sponsor organization and the testing organization to perform OG-CAIE as a service. It is signed by the sponsor and by the testing organization's authorized representative, precedes the requirement set and follows the mission, the need and the proposal in the record."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.3.13" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-38.png" ;
                    ogc:quote "binding agreement" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-27 closed concern C-24: the 2026 wording (3.3.13) is the 2015 wording (3.4.7), captured as screenshot 38. Ruling R-21 calls the agreement a contract to perform the OG-CAIE as a service." ;
    prov:wasDerivedFrom rul:R-21 ;
    skos:related term:statement-of-work ;
    skos:related term:evaluation-customer ;
    skos:related term:evaluation-service-provider ;
    skos:related term:account-executive ;
    ogc:binding "sysml item def ServiceAgreement; epo:ServiceAgreement, signed by the sponsor and the authorized representative" .

term:evaluation-team a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation team"@en ;
    skos:related term:account-executive ;
    skos:altLabel "evaluators"@en ; skos:altLabel "team"@en ;
    skos:definition "The evaluators within the testing organization who jointly perform one evaluation: at least one domain expert and at least one evaluation operator, each an evaluator in the SQuaRE sense, the person who performs an evaluation. What ISO 9000 calls an audit team is the same shape of thing for an audit; the word audit is kept out of the headword because readers hear legal bearing in it that neither standard intends."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "evaluator, p. 157 (ISO/IEC 25000:2014, 4.18)" ; ogc:pdfPage 157 ;
                    ogc:quote "individual or organization that performs an evaluation" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.12.7" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-34.png" ;
                  ogc:quote "one or more persons conducting an audit, supported if needed by technical experts" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "assessment team, p. 30 (ISO/IEC 33001:2015, 3.2.10)" ; ogc:pdfPage 30 ;
                  ogc:quote "one or more individuals who jointly perform a process assessment" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-28 (concern C-31): anchored to the SQuaRE evaluator, the same family as the adopted term evaluation (ISO/IEC 25001), with ISO 9000:2026 audit team and SEVOCAB assessment team as the two neighbours. ISO 9000:2026 3.12.1 defines an audit as a systematic and independent process for obtaining evidence and evaluating it objectively, with no legal bearing; the connotation is the reader's, and it is avoided. Rulings R-10 and R-21: the technical experts are members, not support." ;
    prov:wasDerivedFrom rul:R-28 ;
    skos:related term:technical-expert ;
    skos:related term:evaluation-operator ;
    skos:related term:evaluation-service-provider ;
    skos:related term:evaluation ;
    ogc:binding "sysml part def EvaluationTeam inside TestingOrganization" .

term:evaluation-operator a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation operator"@en ;
    skos:altLabel "operator"@en ; skos:altLabel "tester"@en ; skos:altLabel "AI evaluation expert"@en ; skos:altLabel "red teamer"@en ;
    skos:definition "The technical expert who operates the evaluation: declares the requirement set with the sponsor, writes the test plan, administers the probes to the test item, collects the responses and the evidence per the plan, and drafts the report and the recommendation. The operator makes determinations but does not attest; attestation belongs to the domain expert. An abstract actor category, filled by a named person in each evaluation."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:nist-ai-700-2 ; ogc:locator "Appendix A, Tester, p. 17" ; ogc:pdfPage 24 ;
                    ogc:quote "Individual who interacts with an application within the ARIA test environment." ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ; ogc:locator "operator, p. 283 (ISO/IEC/IEEE 12207:2026, 3.1.40)" ; ogc:pdfPage 283 ;
                  ogc:quote "entity that performs the operation of a system" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-23: the operator and the domain expert are abstract actor categories in distinct EPO slots. Sheet 10-26 (R-50): SEVOCAB has no entry for tester (checked 2026-09-07) and its operator is the party operating the system of interest, so NIST AI 700-2's tester, the individual who interacts with the application under test, is the anchor, with the 12207 operator kept beside it as the word the headword carries. Replaces the label AI evaluation expert of ruling R-10, kept as an altLabel." ;
    prov:wasDerivedFrom rul:R-23 ; prov:wasDerivedFrom rul:R-50 ;
    skos:broader term:technical-expert ;
    skos:related term:evaluation-team ;
    skos:related term:red-teaming ;
    ogc:binding "sysml part def EvaluationOperator; epo:evaluationOperatorRole; prov:Person" .

term:account-executive a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "authorized representative"@en ;
    skos:altLabel "account executive"@en ; skos:altLabel "signatory"@en ;
    skos:definition "The person who signs the contract for the testing organization and delivers the report and the recommendation to the sponsor: the organization's interface with its contractual counterparties. The authorized representative is not responsible for the determinations in the report; those belong to the technical experts, and the representative makes no determination and no attestation. An abstract actor category, filled by exactly one named person in each evaluation."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "corresponds" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "acceptance, p. 4 (ISO/IEC/IEEE 24748-5:2017, 3.1) (fragment of the entry)" ; ogc:pdfPage 4 ;
                    ogc:quote "authorized representative of the acquirer" ; ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "4.3 first-party conformity assessment activity, Note 1 (the descriptors are not the legal identification of the parties to a contract)" ] ;
    ogc:scopeNote "Sheet 09 (block B1) and the tbox audit (sheet 08): the headword account executive becomes authorized representative, kept as the alternative label; SEVOCAB's acceptance entry names the authorized representative of the acquirer, and here the phrase is read for the provider's side, the person authorized to sign and deliver for the testing organization. The earlier anchor, ISO 9000:2026 3.1.3 top management, leaves. Concern C-26 (the anchor was provisional) is answered by this entry and closed by ruling R-49, which records the renaming. Z on the role: not responsible for the determination in the report; the interface for the organization with its contractual counterparties. The term's IRI keeps its former local name. Sheet 10-27 (R-50): authorized representatives exist per organization, so there are several in one evaluation; this term names the testing organization's, the acquirer's own is the sponsor's signatory (sheet 10-06), and no canonical definition is read reversed: SEVOCAB's phrase is cited as the standard's word for the role an organization's representative holds, whichever side signs. Z: \"there are multiple authorized representatives since they exist on a per organization basis; avoid reversal of canonical definitions\"." ;
    prov:wasDerivedFrom rul:R-23 ; prov:wasDerivedFrom rul:R-48 ; prov:wasDerivedFrom rul:R-49 ; prov:wasDerivedFrom rul:R-50 ;
    skos:related term:contract ; skos:related term:evaluation-service-provider ; skos:related term:evaluation-team ;
    ogc:binding "epo:AuthorizedRepresentativeRole; epo:accountExecutiveRole on the service agreement and the delivery; sysml part def AccountExecutive" .

term:monitoring a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "monitoring"@en ;
    skos:altLabel "surveillance (ISO/IEC 17000 8.1)"@en ; skos:altLabel "re-evaluation"@en ;
    skos:definition "Determining the status of a system at different stages or times. After an evaluation, a sponsor may require the test item provider to change the system per the findings and then require new testing to certify that the flagged issues were addressed; in conformity assessment that repeat is called surveillance. Observed in practice; not a step of the contracting lifecycle."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.3" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-30.png" ;
                    ogc:quote "determining the status of a system, a process or an activity" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ; ogc:locator "8.1 surveillance" ;
                  ogc:quote "systematic iteration of conformity assessment activities as a basis for maintaining the validity of the statement of conformity" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-36: the headword is ISO 9000's monitoring, the doctrine is ISO/IEC 17000's surveillance, kept as the alternative label with its clause so the concept stays mapped. Ruling R-35: narration in the Contracting chapter, outside the lifecycle." ;
    prov:wasDerivedFrom rul:R-36 ;
    skos:related term:evaluation ;
    ogc:binding "narration in docs/contracting.md; no node of the record" .

term:mission a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "mission"@en ;
    skos:altLabel "mandate"@en ; skos:altLabel "obligations to the affected populations"@en ;
    skos:definition "The sponsor organization's purpose for existing, as its top management expresses it, and with it the obligations and duties it holds towards the affected populations. Recorded before the need is stated, it is the context the contract answers to: what the sponsor owes the people the test item will serve. Pinned at the contract."@en ;
    ogc:class "refined" ;
    ogc:anchorRelation "specializes" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.4.11" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-10.png" ;
                    ogc:quote "organization's purpose for existing as expressed by top management" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ; ogc:locator "3.4.5 policy" ; ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-10.png" ;
                  ogc:quote "intentions and direction of an organization as formally expressed by its top management" ; ogc:quoteStatus "human" ; ogc:verifiedBy rul:Z ; ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:scopeNote "Ruling R-37: a seam of its own from the sponsor, feeding the contract. Sheet 10-30 (R-50): ISO 9000 says only the organization's purpose for existing; the obligations and duties towards the affected populations are this specification's addition, drawn out of that purpose as its relevant facets, not a separate idea. Z: \"be clear that these obligations toward affected populations would come from the organizations purpose. its not a separate idea, its drawing out the relevant facets\"." ;
    prov:wasDerivedFrom rul:R-37 ; prov:wasDerivedFrom rul:R-50 ;
    skos:related term:evaluation-customer ;
    skos:related term:stakeholder ;
    skos:related term:statement-of-work ;
    ogc:binding "sysml item def Mission, port def MissionWrite, seams missionSeam and missionToExecutiveSeam; epo:Mission with epo:regards the populations" .

term:statement-of-work a skos:Concept ; skos:inScheme ogc:Glossary ;
    skos:prefLabel "statement of work"@en ;
    skos:altLabel "SOW"@en ; skos:altLabel "scope of work"@en ;
    skos:definition "The sponsor's decisions about the work to be performed under the contract; here, for each affected population, whether it is interviewed, with its stakeholder needs documented as input, or represented by the domain expert. A scope-of-work judgment: representation is the common case, interviews are reserved for underrepresented stakeholders or underdocumented needs because of the effort they cost. Decided with the agreement, pinned at the contract, consumed by the scope step, and traceable either way."@en ;
    ogc:class "adopted" ;
    ogc:canonical [ ogc:cites src:sevocab ; ogc:locator "statement of work, p. 406" ; ogc:pdfPage 406 ;
                    ogc:quote "statement of the expected outcomes and outline of the work required to achieve the outcomes" ; ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-40: a boundary item between the contract and its fulfilment; the sponsor decides, per affected population, interview or representation; the record must show the decision and the evaluation must realize it." ;
    prov:wasDerivedFrom rul:R-40 ;
    skos:related term:contract ;
    skos:related term:mission ;
    skos:related term:stakeholder ;
    skos:related term:evaluation-customer ;
    ogc:binding "sysml item def StatementOfWork, port def StatementOfWorkWrite, seams statementOfWorkSeam and statementOfWorkToExecutiveSeam; epo:StatementOfWork with epo:decides engagement decisions" .

# ---------------------------------------------------------------------------
# The standards' own concepts, as SKOS mapping targets (tbox audit, sheet 08).
# One node per clause or entry a canonical citation names, in the src:
# namespace with its locator; a term maps to the clause its class and anchor
# say: adopted = exactMatch, specializes = broadMatch, corresponds =
# closeMatch, synonym = relatedMatch. Terms that share a clause meet here.
# Generated once from the canonical citations; maintained by hand.
# ---------------------------------------------------------------------------

src:gruber-1993_section-1 a ogc:SourceConcept ; ogc:cites src:gruber-1993 ; ogc:locator "Section 1, p. 2 (author copy)" ; rdfs:label "Gruber 1993 Section 1, p. 2 (author copy)" .
src:hawkins-2011_3.2 a ogc:SourceConcept ; ogc:cites src:hawkins-2011 ; ogc:locator "Section 3.2 Asserted context, p. 7" ; rdfs:label "Hawkins et al. 2011 Section 3.2 Asserted context, p. 7" .
src:hawkins-2011_3.3 a ogc:SourceConcept ; ogc:cites src:hawkins-2011 ; ogc:locator "Section 3.3 Asserted solution, p. 10" ; rdfs:label "Hawkins et al. 2011 Section 3.3 Asserted solution, p. 10" .
src:hogan-2021_section-1 a ogc:SourceConcept ; ogc:cites src:hogan-2021 ; ogc:locator "Section 1, p. 2 (arXiv v3)" ; rdfs:label "Hogan et al. 2021 Section 1, p. 2 (arXiv v3)" .
src:iec-60050-351_351-41-10 a ogc:SourceConcept ; ogc:cites src:iec-60050-351 ; ogc:locator "351-41-10 trajectory" ; rdfs:label "IEC 60050-351 351-41-10 trajectory" .
src:iso-9000-2026_3.1.1 a ogc:SourceConcept ; ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.1" ; rdfs:label "ISO 9000:2026 3.1.1" .
src:iso-9000-2026_3.1.4 a ogc:SourceConcept ; ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.4" ; rdfs:label "ISO 9000:2026 3.1.4" .
src:iso-9000-2026_3.1.9 a ogc:SourceConcept ; ogc:cites src:iso-9000-2026 ; ogc:locator "3.1.9 provider" ; rdfs:label "ISO 9000:2026 3.1.9 provider" .
src:iso-9000-2026_3.11.1 a ogc:SourceConcept ; ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.1" ; rdfs:label "ISO 9000:2026 3.11.1" .
src:iso-9000-2026_3.11.12 a ogc:SourceConcept ; ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.12" ; rdfs:label "ISO 9000:2026 3.11.12" .
src:iso-9000-2026_3.11.13 a ogc:SourceConcept ; ogc:cites src:iso-9000-2026 ; ogc:locator "3.11.13" ; rdfs:label "ISO 9000:2026 3.11.13" .
