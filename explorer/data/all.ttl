elmt:OGCAIE__Examples__MeaslesEvaluation___400 a sysml:Documentation ;
    sysml:body """ A public-health chatbot during a measles outbreak: a
               county public-health office sponsors the evaluation and its
               health officer signs, the chatbot's vendor provides the test
               item, Humane Intelligence performs it with Mala, Annie and
               Theo, and two populations are affected. """ ;
    sysml:owner elmt:OGCAIE__Examples__MeaslesEvaluation ;
    sysml:qualifiedName "OGCAIE::Examples::MeaslesEvaluation::@0" .

