    sysml:owner elmt:OGCAIE__ReportApprovalWrite ;
    sysml:qualifiedName "OGCAIE::ReportApprovalWrite::i" ;
    sysml:type elmt:OGCAIE__ReportApproval .

elmt:OGCAIE__ReportApproval___400 a sysml:Documentation ;
    sysml:body """ A domain expert's approval of the final report's contents
           after the machine verdict: correct construction is not enough
           (walkthrough, R-49). Pinned within the evaluation. """ ;
    sysml:owner elmt:OGCAIE__ReportApproval ;
    sysml:qualifiedName "OGCAIE::ReportApproval::@0" .

elmt:OGCAIE__ReportApproval__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__ReportApproval ;
    sysml:qualifiedName "OGCAIE::ReportApproval::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__ReportAssembler___400 a sysml:Documentation ;
    sysml:body """ Assembles the report from the record and the verdict on it,
           coverage and the outcome distribution recomputed inside it;
           anyone holding the record recomputes the same numbers
           (queries/coverage.rq). A draft may carry flagged gaps; a final
           report rests on a passed verdict and is then approved by a domain
           expert (walkthrough, R-49; sheet 10-41, R-50). """ ;
    sysml:owner elmt:OGCAIE__ReportAssembler ;
    sysml:qualifiedName "OGCAIE::ReportAssembler::@0" .

elmt:OGCAIE__ReportSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__ReportSeam ;
    sysml:qualifiedName "OGCAIE::ReportSeam::consumer" ;
    sysml:type elmt:OGCAIE__ReportWrite .

elmt:OGCAIE__ReportSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__ReportSeam ;
    sysml:qualifiedName "OGCAIE::ReportSeam::supplier" ;
    sysml:type elmt:OGCAIE__ReportWrite .

elmt:OGCAIE__ReportWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__ReportWrite ;
    sysml:qualifiedName "OGCAIE::ReportWrite::i" ;
    sysml:type elmt:OGCAIE__Report .

elmt:OGCAIE__Report___400 a sysml:Documentation ;
    sysml:body """ Coverage and performance, computed by machine over the record
           and reported together, never merged: the record's delivered
           export (sheet 10-02). A draft may carry flagged gaps in
           traceability or coverage; a final report rests on a passed
           verdict on the record (sheet 10-41, R-50). """ ;
    sysml:owner elmt:OGCAIE__Report ;
    sysml:qualifiedName "OGCAIE::Report::@0" .

elmt:OGCAIE__Report__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__Report ;
    sysml:qualifiedName "OGCAIE::Report::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__RepresentationSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__RepresentationSeam ;
    sysml:qualifiedName "OGCAIE::RepresentationSeam::consumer" ;
    sysml:type elmt:OGCAIE__RepresentationWrite .

elmt:OGCAIE__RepresentationSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__RepresentationSeam ;
    sysml:qualifiedName "OGCAIE::RepresentationSeam::supplier" ;
    sysml:type elmt:OGCAIE__RepresentationWrite .

elmt:OGCAIE__RepresentationWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__RepresentationWrite ;
    sysml:qualifiedName "OGCAIE::RepresentationWrite::i" ;
    sysml:type elmt:OGCAIE__StakeholderRepresentation .

elmt:OGCAIE__Representative___400 a sysml:Documentation ;
    sysml:body """ Speaks on behalf of an affected population, as the statement
           of work decided: every named population has one; any team member
           may be one, since speaking for a population is not a judgment on
           the test item (sheet 10-13); the population's interview, when it
           had one, feeds the representation (walkthrough B3, R-49). """ ;
    sysml:owner elmt:OGCAIE__Representative ;
    sysml:qualifiedName "OGCAIE::Representative::@0" .

elmt:OGCAIE__RequirementSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__RequirementSeam ;
    sysml:qualifiedName "OGCAIE::RequirementSeam::consumer" ;
    sysml:type elmt:OGCAIE__RequirementSetWrite .

elmt:OGCAIE__RequirementSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__RequirementSeam ;
    sysml:qualifiedName "OGCAIE::RequirementSeam::supplier" ;
    sysml:type elmt:OGCAIE__RequirementSetWrite .

elmt:OGCAIE__RequirementSetApprovalSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__RequirementSetApprovalSeam ;
    sysml:qualifiedName "OGCAIE::RequirementSetApprovalSeam::consumer" ;
    sysml:type elmt:OGCAIE__RequirementSetApprovalWrite .

elmt:OGCAIE__RequirementSetApprovalSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__RequirementSetApprovalSeam ;
    sysml:qualifiedName "OGCAIE::RequirementSetApprovalSeam::supplier" ;
    sysml:type elmt:OGCAIE__RequirementSetApprovalWrite .

elmt:OGCAIE__RequirementSetApprovalWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__RequirementSetApprovalWrite ;
    sysml:qualifiedName "OGCAIE::RequirementSetApprovalWrite::i" ;
    sysml:type elmt:OGCAIE__RequirementSetApproval .

elmt:OGCAIE__RequirementSetApproval___400 a sysml:Documentation ;
    sysml:body """ The sponsor's approval of the requirement set, made by its
           signatory, dated after the set and before any session (sheet
           10-01, R-50): the sponsor sees and approves what its test item is
           held to. Pinned within the evaluation. """ ;
    sysml:owner elmt:OGCAIE__RequirementSetApproval ;
    sysml:qualifiedName "OGCAIE::RequirementSetApproval::@0" .

elmt:OGCAIE__RequirementSetApproval__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__RequirementSetApproval ;
    sysml:qualifiedName "OGCAIE::RequirementSetApproval::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__RequirementSetWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__RequirementSetWrite ;
    sysml:qualifiedName "OGCAIE::RequirementSetWrite::i" ;
    sysml:type elmt:OGCAIE__RequirementSet .

elmt:OGCAIE__RequirementSet___400 a sysml:Documentation ;
    sysml:body """ The operational envelope (rulings R-03, R-14): the
           requirements THIS test item must meet in THIS operational
           environment, agreed under the service agreement. """ ;
    sysml:owner elmt:OGCAIE__RequirementSet ;
    sysml:qualifiedName "OGCAIE::RequirementSet::@0" .

elmt:OGCAIE__RequirementSet__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__RequirementSet ;
    sysml:qualifiedName "OGCAIE::RequirementSet::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__ResponseSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__ResponseSeam ;
    sysml:qualifiedName "OGCAIE::ResponseSeam::consumer" ;
    sysml:type elmt:OGCAIE__ResponseWrite .

elmt:OGCAIE__ResponseSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__ResponseSeam ;
    sysml:qualifiedName "OGCAIE::ResponseSeam::supplier" ;
    sysml:type elmt:OGCAIE__ResponseWrite .

elmt:OGCAIE__ResponseWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
