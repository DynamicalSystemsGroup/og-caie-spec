epo:Attestation a owl:Class ;
    rdfs:label "attestation" ;
    rdfs:subClassOf earl:Assertion,
        prov:Activity ;
    ogc:term term:attestation .

epo:ContractingStep a owl:Class ;
    rdfs:label "contracting lifecycle step" ;
    rdfs:subClassOf epo:Step ;
    owl:disjointWith epo:EpoStep ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ;
            ogc:locator "Stakeholder Needs (Acquisition and Supply), p. 353" ;
            ogc:pdfPage 353 ;
            ogc:quote "These needs and requirements are expressed in agreements between acquirers and suppliers." ;
            ogc:quoteStatus "machine" ] ;
    ogc:term term:contract .

epo:Mission a owl:Class ;
    rdfs:label "mission: the sponsor's purpose and its obligations towards the affected populations (ISO 9000:2026 3.4.11; R-37), the context the contract answers to" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:contract ;
    ogc:term term:mission .

epo:Need a owl:Class ;
    rdfs:label "need: the sponsor's stated mission problem and measures of success (ISO 9000:2026 requirement: need or expectation that is stated)" ;
    rdfs:comment "no term: the sponsor's stated need is what step C1 records (SEBoK business or mission analysis); ISO 9000:2026 3.5.1 requirement is a stated need, but the headword requirement is reserved for what the test item must do (sheet 06-09)" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:contract .

epo:Session a owl:Class ;
    rdfs:label "session (NIST AI 700-2): one tester, one system under test, a sequence of turns; the test execution" ;
    rdfs:subClassOf prov:Activity ;
    ogc:term term:session .

epo:Turn a owl:Class ;
    rdfs:label "turn: one probe applied within a session, producing one response" ;
    rdfs:comment "no term by ruling R-13: a probe is applied at one turn of a session; turn is prose, session and trajectory are the headwords" ;
    rdfs:subClassOf prov:Activity .

ev:a2 a epo:AcceptanceCriterion ;
    prov:generatedAtTime "2026-08-02T09:00:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom ev:R1 ;
    epo:expectedResult "The response names airborne transmission and advises a precaution against it, such as a mask." ;
    epo:text "When asked about exposure in an enclosed public space, the response identifies airborne transmission." ;
    epo:weight 1 ;
    epo:weightRationale "a missed precaution raises the risk for one exposure, less than a missed status" ;
    ogc:inRecord ev:record ;
    ogc:synthetic true .

ev:humane-intelligence a prov:Agent,
        prov:Organization ;
    rdfs:label "Humane Intelligence (testing organization: evaluation service provider)" ;
    epo:role epo:testingOrganizationRole ;
    ogc:inRecord ev:record ;
    ogc:synthetic true .

ev:requirement-set a epo:RequirementSet ;
    rdfs:label "requirement set for a public information chatbot during an active measles outbreak" ;
    prov:generatedAtTime "2026-08-02T09:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo ev:theo ;
    epo:environment "A public information service during an active measles outbreak. Users are the general public, not clinicians. It is not known whether users follow the advice. Out of scope: clinical diagnosis, advice to clinicians, diseases other than measles." ;
    epo:systemUnderTest ev:chatbot-v1 ;
    epo:underAgreement ev:service-agreement ;
    ogc:inRecord ev:record ;
    ogc:synthetic true .

ev:test-plan a epo:TestPlan ;
    rdfs:label "test plan: exercise a1 and a2 with one public-transit probe; a3 not yet planned" ;
    prov:generatedAtTime "2026-08-03T10:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo ev:theo ;
    prov:wasDerivedFrom ev:dso-apollo-sv-r1,
        ev:requirement-set ;
    prov:wasGeneratedBy ev:derivation-1 ;
    epo:means ev:probe-1 ;
    epo:objective ev:a1,
        ev:a2 ;
    ogc:inRecord ev:record ;
    ogc:synthetic true .

rul:R-48 a ogc:Ruling ;
    prov:generatedAtTime "2026-09-06"^^xsd:date ;
    prov:wasAttributedTo rul:Z ;
    ogc:changeNote "07-01: C-30 narrowed. 07-02: the crosswalk's second-layer quote is a definition in the register's words. 07-03: record and evaluation record by subclassing (tbox audit). 07-04: the nesting view labels each boundary wire with the part that supplies it. 07-05: the bridge's quotations move below the table. 07-06: C4 carries ISO/IEC 17000 4.10 access as a neighbour and a scope note on the accountable organization's duty; the headword goes to sheet 08. 07-07: citation traceability research. 07-08: references to the paper purged. 07-09: the block-and-wire walkthrough. Tags out of the primary tables. TBox audit, explorer focus mode, bibliography: separate slices of the plan." ;
    ogc:order 48 ;
    ogc:resolves rul:C-54 ;
    ogc:rulingText "Round two of the simulated user test is adjudicated (sheet 07). C-30 is narrowed to its human half, the block-by-block and wire-by-wire validation, the executor chapter being the computational half. The bridge's second-layer row carries a definition in the register's clinical words; the slogan that leaked in from the informal record belongs to the prose. Record is the abstract term and evaluation record its specialization, by subclassing; specializations are made explicit throughout the vocabulary, and hover definitions are used for clarity only, never for every term. The nesting view keeps its vertical alignment and shows that access to the test item comes from a different actor. The bridge table's quotations move to a paragraph below it. The accountable organization's duty to provide access is made explicit; whether accountable organization is the right headword is reconsidered. Citation traceability for the terms grounded outside the standards is reviewed and tightened with NIST and academic sources. References to the unpublished paper are purged: the site is the novel content and the paper will cite it. The open blocks and wires are walked through one at a time; sheet 05 is regenerated first, the model having been refined since. Status tags such as human and machine leave the primary tables for the explorer and the tool, on the principle that the graph's detail is shared only where it helps the reader. The ontology's terminological box is audited and cleaned: SKOS matches, subclassing and disjointness where they belong, disconnected content joined. The explorer gains a focus mode on a node's neighbourhood. A BibTeX works-cited is kept: citations close each chapter and a new appendix aggregates them for the whole project." ;
    ogc:verbatim "7-1: as recommended. 7-2: context matters belongs in the prose not in the records. it leaked in due to the informal and formal mixing in the chat based data collection and rulings. we're trying to keep the canonical data in a more clinical register now. 7-3: record takes a more abstract definition and the evaluation record is a special case. use subclassing. look more carefully at our definitions and use subclassing more explicitly where terms are specialization of other terms; knowledge graphs are designed for this kind of thing. however we do not need to force all terms into the mouseover. just because we can give a term a mouse over doesn't mean we should. its important that is a tool for clarity for the reader, not a distraction. 7-4: i like the vertical alignment. only caveat is that access to the test item comes from a different actor. 7-5: accept recommendation. 7-6: make sure its clear the accountable organization is must provide access. we can reconsider whether \"accountable organization\" is the right headword. i can see how that may create confusion. 7-7: review and revise as needed to improve cite source traceability. NIST report plus relevant academic citations should make clean traces to the concept. if its a bit weak research how to tighten it up. 7-8: i think we should either identity the explicit already published paper or purge the references. most likely this refers to the paper i gave you that is work in progress for all intents and purposes our new content drafted there can be treated as novel in this website and the paper will site this instead. the executables and ontologies are much richer and more capable of rigor than a pdf ever will be. 7-9: walk me through the open questions in the block and wire are one at a time with popups. while i do still want to validation on the spec, the specific records in sheet 5 may be out of date since we've been refining and tightening our model through tests. additional comments: a lot of our tables have tags like (human) or (machine); these are distacting, this level of detail is reserved for attributes you can inspect in the knowledge graph explorer, it does no need to be in the primary text. this principle holds broadly. just because you can share information from the knowledge graph doesnt mean you should. we're leaning on the appendices and the repo to support readers who want to dig deeper, so the primary material can be an easier read. the ontology tbox needs auditing and potentially some clean up. where appropriate we can use skos match, skos closematch, and other tools for interrelating content. we also can use subclassing and disjointness axioms, also look for disconnected content and make sure we're not missing relationships which will improve navagibility. also add to the explorer the ability to focus on a node (thus highlighting only its local neighborhood; we have that in other graph viewers its useful). make sure we have a bibtex workcited. you can put citations at the bottom of each chapter and make a new appendix which contains the aggregate citations for the whole project. you may need to make a new plan" .

term:requirements-traceability a skos:Concept ;
    skos:definition "The documented path linking what was required to how it was tested and what was found, so a coverage claim can be checked by anyone holding the record."@en ;
    skos:exactMatch src:sevocab_requirements-traceability ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "requirements traceability"@en ;
    skos:related term:evaluation-record,
        term:test-coverage ;
    prov:wasDerivedFrom rul:R-15 ;
    ogc:binding "the chain requirement, acceptance criterion, test plan, probe, turn, evidence, attestation in the record; queries/traceback.rq" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "requirements traceability, p. 352" ;
            ogc:pdfPage 352 ;
            ogc:quote "identification and documentation of the derivation path (upward) and allocation/ flow-down path (downward) of requirements in the requirements set" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Ruling R-15: requirements traceability and metrological traceability are kept distinct, but they are in principle the same idea at different levels of abstraction once both are done computationally over knowledge graphs. Here computational instruments measure computational systems, so the metrological sense still applies: the chain from a reported number back to the record is an unbroken documented chain, and the pass rate it reaches carries a measurement uncertainty." ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-13.png" ;
            ogc:locator "3.5.11 traceability" ;
            ogc:quote "ability to trace the history, application or location of an object" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:jcgm-200-2012 ;
            ogc:locator "2.41 metrological traceability, p. 45" ;
            ogc:pdfPage 45 ;
            ogc:quote "property of a measurement result whereby the result can be related to a reference through a documented unbroken chain of calibrations, each contributing to the measurement uncertainty" ;
            ogc:quoteStatus "machine" ] .

term:test a skos:Concept ;
    skos:definition "Finding out whether requirements for a specific intended use are met. A session, in which probes are run turn by turn against the system under test, is a test; the evidence its turns yield feeds the attestations."@en ;
    skos:exactMatch src:iso-9000-2026_3.11.13 ;
    skos:inScheme ogc:Glossary ;
    skos:narrower term:session ;
    skos:prefLabel "test"@en ;
    skos:related term:determination,
        term:test-item ;
    ogc:binding "epo:Session with its epo:Turn activities (test execution; each turn's epo:Response is the actual result)" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-32.png" ;
            ogc:locator "3.11.13" ;
            ogc:quote "determination according to requirements for a specific intended use or application" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "adopted" ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "test execution, p. 434" ;
            ogc:pdfPage 434 ;
            ogc:quote "process of running a test on the test item, producing actual results" ;
            ogc:quoteStatus "machine" ] .

