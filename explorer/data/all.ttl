    sysml:qualifiedName "OGCAIE::ContractingProcess::propose" .

epo:ServiceAgreement a owl:Class ;
    rdfs:label "service agreement: the contract (ISO 9000:2026 3.3.13) to perform OG-CAIE as a service, signed by the sponsor's signatory and the testing organization's authorized representative, each on behalf of their organization (R-21, R-23, R-50); accepts the proposal" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:contract ;
    ogc:term term:contract .

rul:R-13 a ogc:Ruling ;
    prov:generatedAtTime "2026-09-06"^^xsd:date ;
    prov:wasAttributedTo rul:Z ;
    ogc:changeNote "Sources: IEC 60050-351 (Electropedia, cite-only, quotes pending), JCGM 200:2012 (held locally), NIST TN 1297 (committed). Glossary: eight terms; probe and test narratives tightened to one turn and to the session. EPO: Session, Turn, Trajectory, Strategy (a prov:Plan), inSession, turnIndex, policy, groundedIn; a TestPlan's means is a Probe or a Strategy. Record: session-1 with turn-1 and trajectory-1 replace run-1. Shapes: S4-Session, S4-Turn, S3-Strategy; S5 evidence from a turn; S6 chain rule through the turn; S3 probe belongs to a plan directly or through a strategy. Counterexample attestation-off-turn (two-turn session under a strategy). Model: Session item, sessionId and turnIndex on Evidence, SCI-05 extended. Traceback query returns session and turn." ;
    ogc:order 13 ;
    ogc:resolves rul:C-14 ;
    ogc:rulingText "The eight-term package is adopted as proposed: session and dialogue (NIST); trajectory, with the output-feedback anchor for the policy (IEC 60050-351); test strategy (ISO/IEC/IEEE 29119-2); non-deterministic system (29119-11); repeatability, reproducibility and measurement uncertainty (VIM, NIST TN 1297). Session and Turn enter the record; a Strategy is a plan's means; the chain rule is extended accordingly." ;
    ogc:verbatim "Adopt the eight-term package as proposed: session, dialogue (NIST); trajectory, output-feedback anchor for the policy (IEC 60050-351); test strategy (29119-2); non-deterministic system (29119-11); repeatability, reproducibility, measurement uncertainty (VIM, NIST TN 1297). Session and Turn in the record; Strategy as a plan's means; chain rule extended." .

term:objective-evidence a skos:Concept ;
    skos:altLabel "evidence"@en ;
    skos:definition "Data that supports the existence or truth of something. Here, what is collected as the basis for a determination: a response at one turn, a session's trajectory, or several of them rolled up over a test suite, as in a robustness battery. Each evidence item bears on one acceptance criterion's expected result and is bound to the test plan it was collected under. Evidence is the domain; the determination made on it, passed, failed or cannot tell, is the codomain. On its own evidence verifies nothing; a determination rules on it and an attestation judges it."@en ;
    skos:exactMatch src:iso-9000-2026_3.8.6 ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "objective evidence"@en ;
    skos:related term:determination,
        term:record,
        term:session,
        term:sufficiency,
        term:trajectory ;
    prov:wasDerivedFrom rul:R-18,
        rul:R-20 ;
    ogc:binding "epo:Evidence (bears on one criterion, under a test plan) derived from epo:Response or epo:Trajectory" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-21.png" ;
            ogc:locator "3.8.6" ;
            ogc:quote "data supporting the existence or verity of something" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Rulings R-18 and R-20: evidence exists at probe, session or suite level and maps to an expected result; it is the domain, and the determination on it is the codomain." ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "objective evidence, p. 277" ;
            ogc:pdfPage 277 ;
            ogc:quote "data supporting the existence or verity of something" ;
            ogc:quoteStatus "machine" ] .

term:technical-expert a skos:Concept ;
    skos:altLabel "domain expert"@en,
        "subject matter expert"@en ;
    skos:definition "A person who provides specific knowledge or expertise to the evaluation team. Two kinds sit on the team. The domain expert is expert in the Domain-Specific Ontology: they supply or approve its release, attest that it is appropriate for the case being evaluated (this system under test, these requirements, this operational environment), and may be consulted on interpreting evidence. The evaluation operator is expert in performing the tests the Evaluation Process Ontology specifies, conditioned on the DSO, and in assembling the evidence."@en ;
    skos:exactMatch src:iso-9000-2026_3.12.9 ;
    skos:inScheme ogc:Glossary ;
    skos:narrower term:evaluation-operator ;
    skos:prefLabel "technical expert"@en ;
    skos:related term:domain-specific-ontology,
        term:evaluation-team ;
    prov:wasDerivedFrom rul:R-10 ;
    ogc:binding "sysml part defs DomainExpert and EvaluationOperator; prov:Person" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-34.png" ;
            ogc:locator "3.12.9" ;
            ogc:quote "person who provides specific knowledge or expertise to the audit team" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Ruling R-10: the ISO entry is marked <audit>; here the team is an evaluation team, not an audit team, and both the domain expert and the evaluation operator are technical experts on it (R-23 names the second). Assessors of the assessment are out of scope (R-11)." .

