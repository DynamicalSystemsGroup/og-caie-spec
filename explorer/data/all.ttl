ev:record a prov:Bundle,
        prov:Entity ;
    rdfs:label "the measles evaluation" ;
    skos:note "Synthetic case (ruling R-23). The persons named recognise the roles of real people at Humane Intelligence; no attestation, determination or signature in this record was made by them. The county health officer is invented. The case is a simplified synthetic walkthrough of the process." ;
    epo:independenceLevel epo:person ;
    ogc:synthetic true .

