term:evaluation-record a skos:Concept ;
    skos:altLabel "record (ISO 9000:2026 3.8.12, of one evaluation)"@en,
        "test log"@en ;
    skos:broadMatch src:iso-9000-2026_3.8.12 ;
    skos:broader term:record ;
    skos:definition "The record of one evaluation, bound by the Evaluation Process Ontology: the DSO release, the requirement set, the test plan, the probes, the sessions and their trajectories, the evidence, the attestations, the report and the recommendations, with who did what and when. The EPO determines what must be present for requirements traceability in both directions and for coverage, and makes all three checkable by machine; a conformant record therefore provides both traceability directions and coverage."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation record"@en ;
    skos:related term:conformance,
        term:evaluation-process-ontology,
        term:requirements-traceability ;
    prov:wasDerivedFrom rul:R-17 ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "track/measles-run.ttl; a prov:Bundle" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-23.png" ;
            ogc:locator "3.8.12 record" ;
            ogc:quote "document stating results achieved or providing evidence of activities performed" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Ruling R-17. Downward: requirement to acceptance criteria to test plan to probes (shapes S2, S3). Upward: attestation to evidence to turn to probe to criterion to requirement (shapes S6, S8; queries/traceback.rq). Coverage: the weighted share of criteria with an attested outcome (shape S7; queries/coverage.rq)." ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "test log, p. 436" ;
            ogc:pdfPage 436 ;
            ogc:quote "chronological record of relevant details about the execution of tests" ;
            ogc:quoteStatus "machine" ] .

term:sufficiency a skos:Concept ;
    skos:definition "The expert judgment that the evidence gathered is enough to support the claim being made. A quantity judgment, distinct from appropriateness. A judgment with no evidence cannot record a pass or a fail."@en ;
    skos:exactMatch src:hawkins-2011_3.3 ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "sufficiency"@en ;
    skos:related term:appropriateness,
        term:attestation,
        term:objective-evidence ;
    prov:wasDerivedFrom rul:R-08 ;
    ogc:binding "epo:sufficiency on Attestation; sysml enum Sufficiency; judgment rules in shape S6" ;
    ogc:canonical [ ogc:cites src:hawkins-2011 ;
            ogc:locator "Section 3.3 Asserted solution, p. 10" ;
            ogc:pdfPage 10 ;
            ogc:quote "it is being asserted that the evidence put forward is sufficient to support the claim" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Sheet 10-12 (R-50), in Z's words: sufficiency relates the evidence to the claim that a requirement is met or not: insufficient evidence implies cannot tell, sufficient evidence can give pass or fail. One failing response can suffice to show a criterion unmet in that instance; shape S6 holds the rule." ;
    ogc:seeAlso [ ogc:cites src:isa-500 ;
            ogc:locator "paragraph 5(f) (first sentence of the paragraph)" ;
            ogc:pdfPage 2 ;
            ogc:quote "The measure of the quantity of audit evidence." ;
            ogc:quoteStatus "machine" ] .

term:test-item-customer a skos:Concept ;
    skos:altLabel "customer (ISO 9000:2026 3.9.1, of the test item)"@en,
        "user of the test item"@en ;
    skos:broadMatch src:iso-9000-2026_3.9.1 ;
    skos:broader term:customer ;
    skos:definition "A person or organization that receives the AI system under test as a product or a service: its users, and the organization that deploys it. An affected population is a test item customer when it uses the system; other populations are affected indirectly, through other stakeholders' use. The sponsor is a test item customer when it is the deploying organization, and may commission the evaluation on behalf of the populations who are."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "test item customer"@en ;
    skos:related term:evaluation-customer,
        term:stakeholder,
        term:test-item,
        term:test-item-provider ;
    prov:wasDerivedFrom rul:R-21,
        rul:R-48 ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "epo:TestItemCustomerRole; epo:testItemCustomerRole on the sponsor when it deploys the test item; epo:affectedAs epo:asCustomer on an affected population" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-24.png" ;
            ogc:locator "3.9.1 customer" ;
            ogc:quote "person or organization that can or does receive a product or a service that is intended for or required by this person or organization" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Tbox audit (sheet 08, on Z's instruction): the customer of the AI system under test, distinguished explicitly from the customer of the evaluation. The affected populations of ruling R-21 are its customers or are affected through them; the record says which (epo:affectedAs)." ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-02.png" ;
            ogc:locator "3.1.4 interested party" ;
            ogc:quote "person or organization that can affect, be affected by, or perceive itself to be affected by a decision or activity" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.4 second-party conformity assessment activity" ;
            ogc:quote "conformity assessment activity that is performed by a person or organization that has a user interest in the object of conformity assessment" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

term:test-item-provider a skos:Concept ;
    skos:altLabel "accountable organization"@en,
        "provider (ISO 9000:2026 3.1.9, of the test item)"@en ;
    skos:broadMatch src:iso-9000-2026_3.1.9 ;
    skos:broader term:provider ;
    skos:definition "The organization that provides, and is accountable for, the AI system under test: its vendor or its operator. It is a party to every evaluation because it grants access to the test item, but it does not perform the evaluation unless it is also the sponsor and the testing organization, and the record says so. In ISO/IEC 17000's terms it is the first party."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "test item provider"@en ;
    skos:related term:evaluation-service-provider,
        term:first-party-conformity-assessment-activity,
        term:test-item,
        term:test-item-customer ;
    prov:wasDerivedFrom rul:R-21,
        rul:R-48,
        rul:R-49 ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "epo:TestItemProviderRole; epo:accountableOrganizationRole on the test-item access; sysml part def AccountableOrganization" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-03.png" ;
            ogc:locator "3.1.9 provider" ;
            ogc:quote "organization that provides a product or a service" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Sheet 09 (block B4) and the tbox audit (sheet 08): the headword accountable organization becomes test item provider, kept as the alternative label; it specializes ISO 9000's provider, with ISO/IEC 17000's first party as the neighbour. Ruling R-48 (07-06) asked whether accountable organization was the right headword; ruling R-49 (block B2) records the renaming." ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.3 first-party conformity assessment activity" ;
            ogc:quote "conformity assessment activity that is performed by the person or organization that provides or that is the object of conformity assessment" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.2 object of conformity assessment" ;
            ogc:quote "entity to which specified requirements apply" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

term:trajectory a skos:Concept ;
    skos:altLabel "history"@en,
        "realization"@en ;
    skos:broadMatch src:iec-60050-351_351-41-10 ;
    skos:definition "The recorded sequence of prompt and response pairs of a session, in order. The system's internal state is never observed; the trajectory is the observable realization, and plays the role a time series of measurements plays in system identification. A small change early in a trajectory can change everything after it."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "trajectory"@en ;
    skos:related term:dialogue,
        term:objective-evidence,
        term:session,
        term:test-strategy ;
    prov:wasDerivedFrom rul:R-13 ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "epo:Trajectory, a prov:Entity generated by a Session; ordered epo:Turn activities" ;
    ogc:canonical [ ogc:cites src:iec-60050-351 ;
            ogc:locator "351-41-10 trajectory" ;
            ogc:quote "representation of the solution x(t) of the state equation as connecting line of the ends of the vector x(t) in state space with time as parameter" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Ruling R-13: the IEC trajectory runs through the hidden state x; what the record holds is the input-output realization, which specializes it to what is observable." ;
    ogc:seeAlso [ ogc:cites src:iec-60050-351 ;
            ogc:locator "351-41-08 state variable, Note 1" ;
            ogc:quote "In case of discrete-time variables the describing equations are xi+1 = f (xi, ui) state equation vi = g (xi, ui) output equation" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

elmt:OGCAIE__AgreementWrite a sysml:PortDefinition ;
    sysml:declaredName "AgreementWrite" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::AgreementWrite" .

elmt:OGCAIE__ContractingProcess__need a sysml:ActionUsage ;
    ogm:realizes epo:need ;
    sysml:declaredName "need" ;
    sysml:owner elmt:OGCAIE__ContractingProcess ;
    sysml:qualifiedName "OGCAIE::ContractingProcess::need" .

elmt:OGCAIE__ContractingStep a sysml:EnumerationDefinition ;
    sysml:declaredName "ContractingStep" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::ContractingStep" .

elmt:OGCAIE__DeterminationWrite a sysml:PortDefinition ;
    sysml:declaredName "DeterminationWrite" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::DeterminationWrite" .

elmt:OGCAIE__EpoStep a sysml:EnumerationDefinition ;
    sysml:declaredName "EpoStep" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::EpoStep" .

elmt:OGCAIE__Examples__MeaslesEvaluation a sysml:PartDefinition ;
    sysml:declaredName "MeaslesEvaluation" ;
    sysml:owner elmt:OGCAIE__Examples ;
    sysml:qualifiedName "OGCAIE::Examples::MeaslesEvaluation" ;
    sysml:specializes elmt:OGCAIE__OgCaieEvaluation .

elmt:OGCAIE__Examples__MeaslesEvaluation___403 a sysml:PartUsage ;
    sysml:owner elmt:OGCAIE__Examples__MeaslesEvaluation ;
    sysml:qualifiedName "OGCAIE::Examples::MeaslesEvaluation::@3" ;
    sysml:redefines "testingOrg" .

elmt:OGCAIE__Machine a sysml:PartDefinition ;
    sysml:declaredName "Machine" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::Machine" ;
    sysml:specializes elmt:OGCAIE__Party .

elmt:OGCAIE__Mission a sysml:ItemDefinition ;
    ogm:realizes epo:Mission ;
    sysml:declaredName "Mission" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::Mission" .

elmt:OGCAIE__RecordWrite a sysml:PortDefinition ;
    sysml:declaredName "RecordWrite" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::RecordWrite" .

elmt:OGCAIE__Report a sysml:ItemDefinition ;
    ogm:realizes epo:Report ;
    sysml:declaredName "Report" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::Report" .

epo:Evidence a owl:Class ;
    rdfs:label "evidence: collected material (a response, a trajectory, or several) bearing on one criterion's expected result, under the test plan (R-18, R-20); the domain of a determination" ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith epo:Determination ;
    ogc:pinnedAt epo:evaluation ;
    ogc:term term:objective-evidence .

epo:Probe a owl:Class ;
    rdfs:label "probe" ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith epo:Response ;
    ogc:pinnedAt epo:evaluation ;
    ogc:term term:probe .

epo:RequirementSet a owl:Class ;
    rdfs:label "requirement set (operational envelope): the requirements one system under test must meet in one operational environment (R-14)" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:evaluation ;
    ogc:term term:operational-envelope .

src:scipy-2026-bof a prov:Entity,
        ogc:Source ;
    rdfs:label "Hollek and Zargham, Building Scientific Approaches to Generative AI, Birds-of-a-Feather session, SciPy 2026 (public event)" ;
    ogc:digest "sources/digests/scipy-2026-bof.md" ;
    ogc:kind "event" ;
    ogc:licenceNote "a public event on the conference record, cited as a fact about what was presented there; the definitions in the digest are the authors' own words as presented; the organization logos shown at the session are reproduced at assets/hi-dsg-collaboration.png with the organizations' agreement (ruling R-47, sheet 06-02)" ;
    ogc:posture "citeOnly" ;
    ogc:rank "internal" .

term:acceptance-criteria a skos:Concept ;
    skos:altLabel "acceptance criterion"@en ;
    skos:broader term:requirement ;
    skos:definition "A specific, checkable condition a response must meet for a requirement to count as satisfied. The unit that coverage is measured over: each criterion either traces to an attested outcome or it does not."@en ;
    skos:exactMatch src:sevocab_acceptance-criteria ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "acceptance criteria"@en ;
    skos:related term:expected-results,
        term:test-coverage,
        term:test-plan ;
    ogc:binding "epo:AcceptanceCriterion; sysml item def AcceptanceCriterion (weight, minPassRate)" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "acceptance criteria, p. 4" ;
            ogc:pdfPage 4 ;
            ogc:quote "criteria that a system or component is required to satisfy to be accepted by a user, customer, or other authorized entity" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" ;
    ogc:seeAlso [ ogc:cites src:incose-gtwr-v4 ;
            ogc:locator "C7 Verifiable, p. 2" ;
            ogc:pdfPage 2 ;
            ogc:quote "The requirement statement is structured and worded such that its realization can be verified to the approving authority's satisfaction." ;
            ogc:quoteStatus "machine" ] .

term:account-executive a skos:Concept ;
    skos:altLabel "account executive"@en,
        "signatory"@en ;
    skos:closeMatch src:sevocab_acceptance ;
    skos:definition "The person who signs the contract for the testing organization and delivers the report and the recommendation to the sponsor: the organization's interface with its contractual counterparties. The authorized representative is not responsible for the determinations in the report; those belong to the technical experts, and the representative makes no determination and no attestation. An abstract actor category, filled by exactly one named person in each evaluation."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "authorized representative"@en ;
    skos:related term:contract,
        term:evaluation-service-provider,
        term:evaluation-team ;
    prov:wasDerivedFrom rul:R-23,
        rul:R-48,
        rul:R-49 ;
    ogc:anchorRelation "corresponds" ;
    ogc:binding "epo:AuthorizedRepresentativeRole; epo:accountExecutiveRole on the service agreement and the delivery; sysml part def AccountExecutive" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "acceptance, p. 4 (ISO/IEC/IEEE 24748-5:2017, 3.1) (fragment of the entry)" ;
            ogc:pdfPage 4 ;
            ogc:quote "authorized representative of the acquirer" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Sheet 09 (block B1) and the tbox audit (sheet 08): the headword account executive becomes authorized representative, kept as the alternative label; SEVOCAB's acceptance entry names the authorized representative of the acquirer, and here the phrase is read for the provider's side, the person authorized to sign and deliver for the testing organization. The earlier anchor, ISO 9000:2026 3.1.3 top management, leaves. Concern C-26 (the anchor was provisional) is answered by this entry and closed by ruling R-49, which records the renaming. Z on the role: not responsible for the determination in the report; the interface for the organization with its contractual counterparties. The term's IRI keeps its former local name." ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.3 first-party conformity assessment activity, Note 1 (the descriptors are not the legal identification of the parties to a contract)" ] .

term:appropriateness a skos:Concept ;
    skos:definition "The expert judgment that the declared context (operational environment, requirement set and Domain-Specific Ontology) was the right frame for the judgment being made. Not whether the system passed, and not whether there was enough evidence."@en ;
    skos:exactMatch src:hawkins-2011_3.2 ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "appropriateness"@en ;
    skos:related term:attestation,
        term:sufficiency,
        term:validation ;
    prov:wasDerivedFrom rul:R-08 ;
    ogc:binding "epo:appropriateness on Attestation; sysml enum Appropriateness; judgment rules in shape S6" ;
    ogc:canonical [ ogc:cites src:hawkins-2011 ;
            ogc:locator "Section 3.2 Asserted context, p. 7" ;
            ogc:pdfPage 7 ;
            ogc:quote "it is being asserted that the context is appropriate for the argument elements to which it applies" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Sheet 10-12 (R-50), in Z's words: appropriateness covers the assumptions and the test planning: no amount of evidence helps if the plan, the strategy and their assumptions are not appropriate for what they aim to determine. Shape S6 allows an inappropriate context only a cannot-tell or inapplicable outcome." ;
    ogc:seeAlso [ ogc:cites src:isa-500 ;
            ogc:locator "paragraph 5(b) (fragment of the paragraph)" ;
            ogc:pdfPage 2 ;
            ogc:quote "The measure of the quality of audit evidence; that is, its relevance and its reliability" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-30.png" ;
            ogc:locator "3.11.2 review" ;
            ogc:quote "determination of the suitability, adequacy or effectiveness of an object to achieve established objectives" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

term:conformance a skos:Concept ;
    skos:altLabel "correct construction"@en,
        "correctness by construction"@en ;
    skos:broadMatch src:iso-9000-2026_3.5.9 ;
    skos:broader term:conformity ;
    skos:definition "The record is correctly constructed: it satisfies every rule the Evaluation Process Ontology's shapes state about how an evaluation must be recorded. A mechanical yes or no, produced by machine. If the record conforms, the process was followed, its data is shaped, its required fields are filled, and coverage can be computed. A special case of conformity: fulfilment of the record-keeping requirements."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "conformance"@en ;
    skos:related term:evaluation-record,
        term:verification ;
    prov:wasDerivedFrom rul:R-16 ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "sh:conforms true on the validation report of the record against shapes/epo.shapes.ttl; sysml part def ConformanceChecker" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-13.png" ;
            ogc:locator "3.5.9 conformity, Note 1" ;
            ogc:quote "The term \"conformance\" is synonymous but deprecated." ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Ruling R-16: ISO 9000:2026 deprecates this word as a synonym of conformity; this specification reclaims it on purpose, and says so, not as a synonym but for a special case: the correctly constructed record, whose conformance is fulfilment of the EPO's record-keeping requirements and so a conformity in its own right. Two reasons. It separates fulfilling a requirement of the system (conformity, attested by a person) from satisfying the record-keeping requirements of the EPO (conformance, checked by machine). And it avoids SHACL's own word for the check, validation, which by this specification's split is verification." ;
    ogc:seeAlso [ ogc:cites src:w3c-shacl ;
            ogc:locator "Section 3.5 Conformance Checking" ;
            ogc:quote "A focus node conforms to a shape if and only if the set of result of the validation of the focus node against the shape is empty and no failure has been reported by it." ;
            ogc:quoteStatus "machine" ] .

term:customer a skos:Concept ;
    skos:broader term:stakeholder ;
    skos:definition "A person or organization that receives a product or a service. Two products change hands around an OG-CAIE evaluation, so there are two customers: the evaluation customer, the sponsor, receives the evaluation as a service; the test item customer receives the AI system under test, as the sponsor sometimes does and as the affected populations do when they use it. The two may be the same organization, and the record says whether they are."@en ;
    skos:exactMatch src:iso-9000-2026_3.9.1 ;
    skos:inScheme ogc:Glossary ;
    skos:narrower term:evaluation-customer,
        term:test-item-customer ;
    skos:prefLabel "customer"@en ;
    skos:related term:organization,
        term:provider ;
    prov:wasDerivedFrom rul:R-21 ;
    ogc:binding "epo:CustomerRole, the genus of epo:EvaluationCustomerRole and epo:TestItemCustomerRole; sysml part def Organization" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-24.png" ;
            ogc:locator "3.9.1" ;
            ogc:quote "person or organization that can or does receive a product or a service that is intended for or required by this person or organization" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Ruling R-21 named the sponsor organization the customer; the tbox audit (sheet 08, on Z's instruction) keeps customer as ISO 9000's genus and makes its two specializations explicit as narrower terms: evaluation customer (the sponsor) and test item customer." .

term:determination a skos:Concept ;
    skos:altLabel "judgment"@en ;
    skos:definition "The ruling, made on one or more evidence items, that a criterion's expected result was met, was not met, or cannot be told. It is the ruling made on evidence, recorded with an EARL outcome of passed, failed or cannot tell, made by machine or by a named person, and it is what an attestation aggregates for a criterion."@en ;
    skos:exactMatch src:iso-9000-2026_3.11.1 ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "determination"@en ;
    skos:related term:attestation,
        term:objective-evidence,
        term:outcome,
        term:test ;
    prov:wasDerivedFrom rul:R-20 ;
    ogc:binding "epo:Determination, an earl:Assertion and prov:Activity; earl:outcome passed, failed or cantTell; sysml item def Determination" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-29.png" ;
            ogc:locator "3.11.1" ;
            ogc:quote "activity to find out one or more characteristics and their characteristic values" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "adopted" ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "test result, p. 438" ;
            ogc:pdfPage 438 ;
            ogc:quote "indication of whether a specific test case has passed or failed, i.e. if the actual results correspond to the expected results or if deviations were observed" ;
            ogc:quoteStatus "machine" ] .

term:evaluation-team a skos:Concept ;
    skos:altLabel "evaluators"@en,
        "team"@en ;
    skos:broadMatch src:sevocab_evaluator ;
    skos:definition "The evaluators within the testing organization who jointly perform one evaluation: at least one domain expert and at least one evaluation operator, each an evaluator in the SQuaRE sense, the person who performs an evaluation. What ISO 9000 calls an audit team is the same shape of thing for an audit; the word audit is kept out of the headword because readers hear legal bearing in it that neither standard intends."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation team"@en ;
    skos:related term:account-executive,
        term:evaluation,
        term:evaluation-operator,
        term:evaluation-service-provider,
        term:technical-expert ;
    prov:wasDerivedFrom rul:R-28 ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "sysml part def EvaluationTeam inside TestingOrganization" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "evaluator, p. 157 (ISO/IEC 25000:2014, 4.18)" ;
            ogc:pdfPage 157 ;
            ogc:quote "individual or organization that performs an evaluation" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Ruling R-28 (concern C-31): anchored to the SQuaRE evaluator, the same family as the adopted term evaluation (ISO/IEC 25001), with ISO 9000:2026 audit team and SEVOCAB assessment team as the two neighbours. ISO 9000:2026 3.12.1 defines an audit as a systematic and independent process for obtaining evidence and evaluating it objectively, with no legal bearing; the connotation is the reader's, and it is avoided. Rulings R-10 and R-21: the technical experts are members, not support." ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-34.png" ;
            ogc:locator "3.12.7" ;
            ogc:quote "one or more persons conducting an audit, supported if needed by technical experts" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:sevocab ;
            ogc:locator "assessment team, p. 30 (ISO/IEC 33001:2015, 3.2.10)" ;
            ogc:pdfPage 30 ;
            ogc:quote "one or more individuals who jointly perform a process assessment" ;
            ogc:quoteStatus "machine" ] .

term:mission a skos:Concept ;
    skos:altLabel "mandate"@en,
        "obligations to the affected populations"@en ;
    skos:definition "The sponsor organization's purpose for existing, as its top management expresses it, and with it the obligations and duties it holds towards the affected populations. Recorded before the need is stated, it is the context the contract answers to: what the sponsor owes the people the test item will serve. Pinned at the contract."@en ;
    skos:exactMatch src:iso-9000-2026_3.4.11 ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "mission"@en ;
    skos:related term:evaluation-customer,
        term:stakeholder,
        term:statement-of-work ;
    prov:wasDerivedFrom rul:R-37 ;
    ogc:binding "sysml item def Mission, port def MissionWrite, seams missionSeam and missionToExecutiveSeam; epo:Mission with epo:regards the populations" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-10.png" ;
            ogc:locator "3.4.11" ;
            ogc:quote "organization's purpose for existing as expressed by top management" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Ruling R-37: a seam of its own from the sponsor, feeding the contract; the obligations towards the affected populations are the sponsor's mission and policy in ISO 9000's words, not a coinage." ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-10.png" ;
            ogc:locator "3.4.5 policy" ;
            ogc:quote "intentions and direction of an organization as formally expressed by its top management" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

term:probe a skos:Concept ;
    skos:altLabel "prompt"@en,
        "task"@en,
        "test case (SEVOCAB, tied to criteria)"@en ;
    skos:broadMatch src:sevocab_test-case ;
    skos:broader term:test-case ;
    skos:definition "A scenario tied to the acceptance criteria it exercises, derived from the Domain-Specific Ontology and checked for consistency before use, applied at one turn of a session. Its run yields one prompt and response pair; the response collected is evidence bearing on those criteria. A test plan may list its probes or choose them by a test strategy as the trajectory unfolds."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "probe"@en ;
    skos:related term:scenario,
        term:test-plan ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "epo:Probe, a prov:Entity; sysml item def Probe" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "test case, p. 432 (fragment of the entry)" ;
            ogc:pdfPage 432 ;
            ogc:quote "set of test inputs, execution conditions, and expected results developed for a particular objective" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "refined" .

term:provider a skos:Concept ;
    skos:altLabel "contractor"@en,
        "supplier"@en ;
    skos:broader term:organization,
        term:stakeholder ;
    skos:definition "An organization that provides a product or a service. Two products change hands around an OG-CAIE evaluation, so there are two providers: the evaluation service provider, the testing organization, provides the evaluation as a service; the test item provider provides, and is accountable for, the AI system under test. They are different organizations when the evaluation is independent, and the record states that fact rather than assuming it."@en ;
    skos:exactMatch src:iso-9000-2026_3.1.9 ;
    skos:inScheme ogc:Glossary ;
    skos:narrower term:evaluation-service-provider,
        term:test-item-provider ;
    skos:prefLabel "provider"@en ;
    skos:related term:customer ;
    prov:wasDerivedFrom rul:R-21 ;
    ogc:binding "epo:ProviderRole, the genus of epo:EvaluationServiceProviderRole and epo:TestItemProviderRole; sysml part def Organization" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-03.png" ;
            ogc:locator "3.1.9" ;
            ogc:quote "organization that provides a product or a service" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Ruling R-21 named the testing organization the provider; the tbox audit (sheet 08, on Z's instruction) keeps provider as ISO 9000's genus and makes its two specializations explicit as narrower terms: evaluation service provider (the testing organization) and test item provider (the accountable organization). ISO 9000:2026 3.1.9 Note 2 says a provider in a contractual situation is sometimes called a contractor, hence the altLabel." .

term:session a skos:Concept ;
    skos:broader term:test ;
    skos:definition "One pairing of one tester with one system under test, in which a sequence of turns is run. Sessions are stateful: what the system says at a later turn depends on everything said before, so evidence belongs to its session, not only to its probe."@en ;
    skos:exactMatch src:nist-ai-700-2_session ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "session"@en ;
    skos:related term:dialogue,
        term:objective-evidence,
        term:test-suite,
        term:trajectory ;
    prov:wasDerivedFrom rul:R-13 ;
    ogc:binding "epo:Session, a prov:Activity (the test execution); sysml item def Session" ;
    ogc:canonical [ ogc:cites src:nist-ai-700-2 ;
            ogc:locator "Appendix A, Session, p. 17 (first sentence of the entry)" ;
            ogc:pdfPage 24 ;
            ogc:quote "A single unit of ARIA testing, consisting of a pairing of one tester and one application." ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" .

elmt:OGCAIE__ContractingProcess__access a sysml:ActionUsage ;
    ogm:realizes epo:access ;
    sysml:declaredName "access" ;
    sysml:owner elmt:OGCAIE__ContractingProcess ;
    sysml:qualifiedName "OGCAIE::ContractingProcess::access" .

elmt:OGCAIE__DomainExpert a sysml:PartDefinition ;
    sysml:declaredName "DomainExpert" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::DomainExpert" ;
    sysml:specializes elmt:OGCAIE__Person .

elmt:OGCAIE__ProbeWrite a sysml:PortDefinition ;
    sysml:declaredName "ProbeWrite" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::ProbeWrite" .

elmt:OGCAIE__ServiceAgreement a sysml:ItemDefinition ;
    ogm:realizes epo:ServiceAgreement ;
    sysml:declaredName "ServiceAgreement" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::ServiceAgreement" .

elmt:OGCAIE__StatementOfWork a sysml:ItemDefinition ;
    ogm:realizes epo:StatementOfWork ;
    sysml:declaredName "StatementOfWork" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::StatementOfWork" .

elmt:OGCAIE__TestingOrganization a sysml:PartDefinition ;
    sysml:declaredName "TestingOrganization" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::TestingOrganization" ;
    sysml:specializes elmt:OGCAIE__Organization .

epo:DsoRelease a owl:Class ;
    rdfs:label "DSO release" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:evaluation ;
    ogc:term term:domain-specific-ontology .

epo:TestItemAccess a owl:Class ;
    rdfs:label "test-item access: the test item provider's grant of access to the versioned test item under the agreement, for a period, under an instrument outside this agreement, in a named environment (sheet 10-04)" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:contract ;
    ogc:term term:test-item .

ev:chatbot-v1 a earl:TestSubject,
        prov:Agent,
        prov:SoftwareAgent ;
    rdfs:label "public-health chatbot" ;
    prov:actedOnBehalfOf ev:chatbot-vendor ;
    epo:version "v1" ;
    ogc:inRecord ev:record ;
    ogc:synthetic true .

rul:plan-walkthrough-2026-09-05 a prov:Activity ;
    rdfs:label "plan-mode walkthrough of the open concerns, 2026-09-05 (Claude Code AskUserQuestion popups; Z selected one option per concern)" ;
    prov:endedAtTime "2026-09-05"^^xsd:date ;
    prov:wasAssociatedWith rul:Z .

term:evaluation-customer a skos:Concept ;
    skos:altLabel "customer (ISO 9000:2026 3.9.1, of the evaluation)"@en,
        "sponsor"@en,
        "sponsor organization"@en ;
    skos:broadMatch src:iso-9000-2026_3.9.1 ;
    skos:broader term:customer ;
    skos:definition "The organization that receives the evaluation as a service: the sponsor. It states its mission and its need, agrees the requirement set with the testing organization under a contract, decides the statement of work, and receives and accepts the report and the recommendation. It may also be the test item customer, and it may commission the evaluation on behalf of affected populations who are, or who are affected by, the test item's customers."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation customer"@en ;
    skos:related term:contract,
        term:evaluation-service-provider,
        term:mission,
        term:second-party-conformity-assessment-activity,
        term:statement-of-work,
        term:test-item-customer ;
    prov:wasDerivedFrom rul:R-21,
        rul:R-48 ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "epo:EvaluationCustomerRole; epo:sponsorRole on the service agreement, the statement of work, the delivery and the acceptance; epo:actsOnBehalfOf the affected populations; sysml part def SponsorOrganization" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-24.png" ;
            ogc:locator "3.9.1 customer" ;
            ogc:quote "person or organization that can or does receive a product or a service that is intended for or required by this person or organization" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Tbox audit (sheet 08, on Z's instruction): the customer of the evaluation service, distinguished explicitly from the customer of the AI system under test. Ruling R-21 introduced the party under the headword customer. When the sponsor is not the test item provider, its position is that of a second party in ISO/IEC 17000's sense." ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.4 second-party conformity assessment activity" ;
            ogc:quote "conformity assessment activity that is performed by a person or organization that has a user interest in the object of conformity assessment" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

term:evaluation-service-provider a skos:Concept ;
    skos:altLabel "provider (ISO 9000:2026 3.1.9, of the evaluation)"@en,
        "testing organization"@en ;
    skos:broadMatch src:iso-9000-2026_3.1.9 ;
    skos:broader term:provider ;
    skos:definition "The organization that provides the evaluation as a service: the testing organization. Its authorized representative signs the contract and delivers the report, its evaluation team does the work, and its machines keep the record. When it is independent of the test item provider and has no user interest in the test item, its activity is third-party in ISO/IEC 17000's sense; the record states that independence as a fact."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "evaluation service provider"@en ;
    skos:related term:account-executive,
        term:contract,
        term:evaluation-customer,
        term:evaluation-team,
        term:test-item-provider,
        term:third-party-conformity-assessment-activity ;
    prov:wasDerivedFrom rul:R-21,
        rul:R-48 ;
    ogc:anchorRelation "specializes" ;
    ogc:binding "epo:EvaluationServiceProviderRole; epo:testingOrganizationRole on the service agreement; sysml part def TestingOrganization" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-03.png" ;
            ogc:locator "3.1.9 provider" ;
            ogc:quote "organization that provides a product or a service" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "refined" ;
    ogc:scopeNote "Tbox audit (sheet 08, on Z's instruction): the provider of the evaluation service, distinguished explicitly from the provider of the AI system under test. Ruling R-21 introduced the party under the headword provider." ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.5 third-party conformity assessment activity" ;
            ogc:quote "conformity assessment activity that is performed by a person or organization that is independent of the provider of the object of conformity assessment and has no user interest in the object" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.6 conformity assessment body" ] .

term:statement-of-work a skos:Concept ;
    skos:altLabel "SOW"@en,
        "scope of work"@en ;
    skos:definition "The sponsor's decisions about the work to be performed under the contract; here, for each affected population, whether it is interviewed, with its stakeholder needs documented as input, or represented by the domain expert. A scope-of-work judgment: representation is the common case, interviews are reserved for underrepresented stakeholders or underdocumented needs because of the effort they cost. Decided with the agreement, pinned at the contract, consumed by the scope step, and traceable either way."@en ;
    skos:exactMatch src:sevocab_statement-of-work ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "statement of work"@en ;
    skos:related term:contract,
        term:evaluation-customer,
        term:mission,
        term:stakeholder ;
    prov:wasDerivedFrom rul:R-40 ;
    ogc:binding "sysml item def StatementOfWork, port def StatementOfWorkWrite, seams statementOfWorkSeam and statementOfWorkToExecutiveSeam; epo:StatementOfWork with epo:decides engagement decisions" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "statement of work, p. 406" ;
            ogc:pdfPage 406 ;
            ogc:quote "statement of the expected outcomes and outline of the work required to achieve the outcomes" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Ruling R-40: a boundary item between the contract and its fulfilment; the sponsor decides, per affected population, interview or representation; the record must show the decision and the evaluation must realize it." .

term:test-item a skos:Concept ;
    skos:altLabel "SUT"@en,
        "application"@en,
        "system of interest"@en,
        "system under test"@en,
        "test object"@en ;
    skos:definition "The deployed AI system being evaluated, taken as a black box: only what it is given and what it produces are recorded. The prose calls it the system under test; the standard headword is test item."@en ;
    skos:exactMatch src:sevocab_test-item ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "test item"@en ;
    skos:related term:non-deterministic-system,
        term:operational-envelope,
        term:test,
        term:test-item-customer,
        term:test-item-provider ;
    prov:wasDerivedFrom rul:R-19 ;
    ogc:binding "sysml part def TestItem; earl:TestSubject and prov:SoftwareAgent; epo:systemUnderTest on the requirement set" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "test item, p. 435 (ISO/IEC/IEEE 29119-2:2021)" ;
            ogc:pdfPage 435 ;
            ogc:quote "work product to be tested" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Ruling R-19: the only standard definition of the phrase system under test is a 1999 performance-measurement one (ISO/IEC 14756), so the headword is test item (29119-2), from the same family as test case, test plan and test strategy; the systems-engineering reading is system-of-interest (15288) and the AI-evaluation reading is NIST's application. The phrase system under test stays in prose and in the model as the alternative label." ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "system-of-interest (SOI), p. 423 (ISO/IEC/IEEE 15288:2023)" ;
            ogc:pdfPage 423 ;
            ogc:quote "system whose life cycle is under consideration" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:nist-ai-700-2 ;
            ogc:locator "Appendix A, Application, p. 16 (fragment of the entry)" ;
            ogc:pdfPage 23 ;
            ogc:quote "A generative artificial intelligence-based system to which NIST is given API access to test." ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:sevocab ;
            ogc:locator "system under test (SUT), p. 423 (ISO/IEC 14756:1999)" ;
            ogc:pdfPage 423 ;
            ogc:quote "parts of the CBSS to be tested" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:sevocab ;
            ogc:locator "artificial intelligence-based system, p. 28 (ISO/IEC TR 29119-11:2020)" ;
            ogc:pdfPage 28 ;
            ogc:quote "system including one or more components implementing artificial intelligence" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.2 object of conformity assessment" ;
            ogc:quote "entity to which specified requirements apply" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

term:test-plan a skos:Concept ;
    skos:definition "The statement, made before any test runs, of what the evaluation will test and how: which acceptance criteria are its objectives, which probes are its means, and what each probe is expected to show. Derived from the requirement set and the Domain-Specific Ontology in step three; every attestation is bound to the plan that produced its evidence."@en ;
    skos:exactMatch src:sevocab_test-plan ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "test plan"@en ;
    skos:related term:acceptance-criteria,
        term:probe,
        term:test-strategy ;
    prov:wasDerivedFrom rul:R-12 ;
    ogc:binding "epo:TestPlan, a prov:Entity; sysml item def TestPlan" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "test plan, p. 437" ;
            ogc:pdfPage 437 ;
            ogc:quote "detailed description of test objectives to be achieved and the means and schedule for achieving them, organized to coordinate testing activities for some test item or set of test items" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" .

elmt:OGCAIE__EvaluationTeam__operator a sysml:PartUsage ;
    sysml:declaredName "operator" ;
    sysml:lowerBound expr:OGCAIE__EvaluationTeam__operator_plowerBound ;
    sysml:owner elmt:OGCAIE__EvaluationTeam ;
    sysml:qualifiedName "OGCAIE::EvaluationTeam::operator" ;
    sysml:type elmt:OGCAIE__EvaluationOperator ;
    sysml:upperBound expr:OGCAIE__EvaluationTeam__operator_pupperBound .

elmt:OGCAIE__SponsorOrganization a sysml:PartDefinition ;
    sysml:declaredName "SponsorOrganization" ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization" ;
    sysml:specializes elmt:OGCAIE__Organization .

rul:sheet-01-walkthrough-2026-09-06 a prov:Activity ;
    rdfs:label "row-by-row verification of the pending ISO quotes against Z's screenshots, 2026-09-06" ;
    prov:endedAtTime "2026-09-06"^^xsd:date ;
    prov:wasAssociatedWith rul:Z .

