    sysml:qualifiedName "OGCAIE::AcceptanceWrite::i" ;
    sysml:type elmt:OGCAIE__Acceptance .

elmt:OGCAIE__Acceptance___400 a sysml:Documentation ;
    sysml:body """ The sponsor's act on receipt of the deliverables, recognizing
           completion of the contract's obligations (ISO/IEC/IEEE 24748-5
           acceptance): the signatory's act on behalf of the sponsor. A
           correctly constructed record is necessary and not sufficient for
           it (sheet 10-03, R-50). Pinned at the contract. """ ;
    sysml:owner elmt:OGCAIE__Acceptance ;
    sysml:qualifiedName "OGCAIE::Acceptance::@0" .

elmt:OGCAIE__Acceptance__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__Acceptance ;
    sysml:qualifiedName "OGCAIE::Acceptance::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__AccessSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__AccessSeam ;
    sysml:qualifiedName "OGCAIE::AccessSeam::consumer" ;
    sysml:type elmt:OGCAIE__AccessWrite .

elmt:OGCAIE__AccessSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__AccessSeam ;
    sysml:qualifiedName "OGCAIE::AccessSeam::supplier" ;
    sysml:type elmt:OGCAIE__AccessWrite .

elmt:OGCAIE__AccessWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__AccessWrite ;
    sysml:qualifiedName "OGCAIE::AccessWrite::i" ;
    sysml:type elmt:OGCAIE__TestItemAccess .

elmt:OGCAIE__AccountExecutive___400 a sysml:Documentation ;
    sysml:body """ Signatory of the service agreement and legal representative
           of the testing organization (ruling R-23; headword authorized
           representative, R-49). Countersigns the agreement into the
           record, reads the record through its view, and delivers the
           report and the recommendation to the sponsor as one delivery
           (an activity of its own, R-24); answers the sponsor's need with
           the proposal and receives the acceptance (R-32). No evidence, determination or
           attestation port: the authorized representative is not
           responsible for the determinations in the report; it is the
           organization's interface with its contractual counterparties
           (sheet 09), and declares its independence of the test item
           provider (sheet 10-07). The worked example's Mala. """ ;
    sysml:owner elmt:OGCAIE__AccountExecutive ;
    sysml:qualifiedName "OGCAIE::AccountExecutive::@0" .

elmt:OGCAIE__AccountableOrganization___400 a sysml:Documentation ;
    sysml:body """ The organization that provides or is accountable for the
           test item: the first party in ISO/IEC 17000's sense (4.3). It
           grants access to the test item and is named in the record. """ ;
    sysml:owner elmt:OGCAIE__AccountableOrganization ;
    sysml:qualifiedName "OGCAIE::AccountableOrganization::@0" .

elmt:OGCAIE__AffectedPopulation___400 a sysml:Documentation ;
    sysml:body """ A population of actors affected by the test item (ISO
           9000:2026 3.1.4 interested party, ruling R-21): always spoken for
           by a representative on the team, and interviewed where the
           statement of work decided so, in which case its input feeds the
           representation and enters the record (series wiring, R-49). """ ;
    sysml:owner elmt:OGCAIE__AffectedPopulation ;
    sysml:qualifiedName "OGCAIE::AffectedPopulation::@0" .

