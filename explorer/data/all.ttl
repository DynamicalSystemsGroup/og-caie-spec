tr:SCI-05 a ogc:Trace ;
    rdfs:label "SCI-05 EvidenceFromNamedRuns" ;
    rdfs:comment "Every response comes from a numbered turn of a session against a versioned test item; every evidence item bears on one criterion's expected result under the plan." ;
