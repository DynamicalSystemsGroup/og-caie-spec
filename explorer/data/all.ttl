elmt:OGCAIE__Attestation___400 a sysml:Documentation ;
    sysml:body """ ISO/IEC 17000 7.3: a named domain expert's statement for one
           criterion, aggregating its determinations, with outcome,
           appropriateness and sufficiency (R-08, R-20, R-21). """ ;
    sysml:owner elmt:OGCAIE__Attestation ;
    sysml:qualifiedName "OGCAIE::Attestation::@0" .

