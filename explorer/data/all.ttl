    rdfs:label "the county health officer approves the requirement set on behalf of the county" ;
    prov:generatedAtTime "2026-08-02T11:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo ev:dana-okafor ;
    epo:approvesRequirementSet ev:requirement-set ;
    ogc:inRecord ev:record ;
