ogc:S6-Attestation a sh:NodeShape ;
    sh:property [ sh:class epo:AcceptanceCriterion ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path earl:test ],
        [ sh:class prov:Person ;
            sh:maxCount 1 ;
            sh:message "An attestation is made by one named person." ;
            sh:minCount 1 ;
            sh:path earl:assertedBy ],
        [ sh:hasValue earl:manual ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path earl:mode ],
        [ sh:in ( earl:passed earl:failed earl:cantTell earl:inapplicable ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ( earl:result earl:outcome ) ],
        [ sh:in ( epo:appropriate epo:inappropriate ) ;
            sh:maxCount 1 ;
            sh:message "Appropriateness of the declared context is judged (R-08)." ;
            sh:minCount 1 ;
            sh:path epo:appropriateness ],
        [ sh:in ( epo:sufficient epo:insufficient ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path epo:sufficiency ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path prov:endedAtTime ] ;
    sh:sparql [ sh:message "S6: the attesting person holds the domain expert role; the operator collects and determines, the authorized representative signs and delivers, only the domain expert attests (R-21, R-23)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this WHERE { $this earl:assertedBy ?p . FILTER NOT EXISTS { ?p epo:role epo:domainExpertRole } }
        """ ],
        [ sh:message "S6: an attestation is an item of the determine-and-attest step (the step is derived through the model graph, sheet 10-33)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE { FILTER NOT EXISTS { $this a ?cls . ?kind ogm:realizes ?cls . ?p sysml:type ?kind ; sysml:direction "out" ; sysml:owner ?act . ?act ogm:realizes epo:determineAndAttest } }
        """ ],
        [ sh:message "S6 chain rule (R-12, R-18, R-20): every determination an attestation aggregates tests the attested criterion, and every evidence item it rules on bears on that criterion under a plan that has it as an objective." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                { $this earl:test ?a ; prov:used ?d . ?d a epo:Determination . FILTER NOT EXISTS { ?d earl:test ?a } }
                UNION
                { $this earl:test ?a ; prov:used ?d . ?d a epo:Determination ; prov:used ?e . ?e a epo:Evidence .
                  FILTER NOT EXISTS { ?e epo:bearsOn ?a ; epo:underPlan ?plan . ?plan epo:objective ?a } }
            }
        """ ],
        [ sh:message "S6 closure rule: an attestation with outcome passed or failed must aggregate at least one determination that rules on evidence; with none it can only say cantTell." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this earl:result ?r . ?r earl:outcome ?o . FILTER(?o IN (earl:passed, earl:failed))
                FILTER NOT EXISTS { $this prov:used ?d . ?d a epo:Determination ; prov:used ?e . ?e a epo:Evidence }
            }
        """ ],
        [ sh:message "S6 judgment rules (sheet 10-12): passed or failed requires sufficient evidence; insufficient evidence implies cannot tell; an inappropriate context allows only cannot tell or inapplicable." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this ?value WHERE {
                { $this earl:result ?r ; epo:sufficiency ?s . ?r earl:outcome ?o .
                  FILTER(?o IN (earl:passed, earl:failed) && ?s = epo:insufficient) BIND("passed or failed on insufficient evidence" AS ?value) }
                UNION { $this earl:result ?r ; epo:sufficiency ?s . ?r earl:outcome ?o .
                        FILTER(?s = epo:insufficient && ?o != earl:cantTell) BIND("insufficient evidence without cannot tell" AS ?value) }
                UNION { $this earl:result ?r ; epo:appropriateness ?ap . ?r earl:outcome ?o .
                        FILTER(?ap = epo:inappropriate && ?o NOT IN (earl:cantTell, earl:inapplicable)) BIND("an inappropriate context with a verdict" AS ?value) }
            }
        """ ],
        [ sh:message "S6 no cherry-picking (sheet 10-14): an attestation uses every determination of the record on its criterion that ended before it, or names the determination it left out with epo:excludes and gives its epo:reason." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogc: <https://w3id.org/og-caie/>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this ?value WHERE {
                $this earl:test ?a ; prov:endedAtTime ?t1 ; ogc:inRecord ?rec .
                ?value a epo:Determination ; ogc:inRecord ?rec ; earl:test ?a ; prov:endedAtTime ?t0 . FILTER(?t0 <= ?t1)
                FILTER NOT EXISTS { $this prov:used ?value }
                FILTER NOT EXISTS { $this epo:excludes ?value ; epo:reason ?why }
            }
        """ ],
        [ sh:message "S6 order (sheet 10-19): an attestation ends no earlier than every determination it aggregates." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this ?value WHERE {
                $this prov:endedAtTime ?t1 ; prov:used ?value . ?value a epo:Determination ; prov:endedAtTime ?t0 .
                FILTER(?t0 > ?t1)
            }
        """ ] ;
    sh:targetClass epo:Attestation .

epo:IndependenceLevel a owl:Class ;
    rdfs:label "the level at which independence between the roles is required (sheet 10-15, R-50)" ;
    rdfs:comment "no term: three values on the record, each with its constraint in S0-Independence; the terms are the actor categories and third-party conformity assessment activity" .

epo:PlanApproval a owl:Class ;
    rdfs:label "plan approval: the domain expert's approval of a test plan (R-21)" ;
    rdfs:comment "no term: the domain expert's approval of the test plan (term test plan); SEVOCAB has no entry for the approval itself" ;
    rdfs:subClassOf earl:Assertion,
        prov:Activity .

epo:Recommendation a owl:Class ;
    rdfs:label "recommendation" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:evaluation ;
    ogc:term term:guardrail .

epo:ReportApproval a owl:Class ;
    rdfs:label "report approval: a domain expert's approval of the final report's contents after the machine verdict on the record (walkthrough, R-49; sheet 10-41); the approval owns the recommendation (sheet 10-11)" ;
    rdfs:comment "no term: the approval is the domain expert's act on the report; the report and the technical expert are the terms" ;
    rdfs:subClassOf earl:Assertion,
        prov:Activity ;
    ogc:pinnedAt epo:evaluation .

epo:Requirement a owl:Class ;
    rdfs:label "requirement" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:evaluation ;
    ogc:term term:requirement .

epo:Role a owl:Class ;
    rdfs:label "a role in one evaluation: a party's (an organization's) or an actor's (a person's within the testing organization)" ;
    rdfs:comment "no term of its own: prov:Role; the subclasses name the terms (party terms of R-21, actor categories of R-23)" ;
    rdfs:subClassOf prov:Role .

epo:StakeholderRepresentation a owl:Class ;
    rdfs:label "stakeholder representation: what a representative says on behalf of an affected population, built from its interview when there was one (walkthrough B3, R-49)" ;
    rdfs:subClassOf prov:Entity ;
    ogc:pinnedAt epo:evaluation ;
    ogc:term term:stakeholder .

epo:SufficiencyValue a owl:Class ;
    ogc:term term:sufficiency .

epo:appropriate a epo:AppropriatenessValue ;
    rdfs:label "the declared context was appropriate for this judgment" .

epo:text a owl:DatatypeProperty ;
    rdfs:range xsd:string .

epo:underAgreement a owl:ObjectProperty ;
    rdfs:comment "under the service agreement: the requirement set is agreed under it (R-21), and the statement of work, the access grant and the delivery are performed under it (sheet 10-05, R-50); no domain, since four kinds carry it" ;
    rdfs:range epo:ServiceAgreement .

