    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__ReportApprovalSeam ;
    sysml:qualifiedName "OGCAIE::ReportApprovalSeam::supplier" ;
    sysml:type elmt:OGCAIE__ReportApprovalWrite .

