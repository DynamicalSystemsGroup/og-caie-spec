    prov:endedAtTime "2026-08-02T10:00:00+00:00"^^xsd:dateTime ;
    prov:used ev:stakeholder-input-1 ;
    prov:wasAssociatedWith ev:annie ;
    epo:appropriateness epo:appropriate ;
