    ogm:first elmt:OGCAIE__ContractingProcess__agree ;
    ogm:then elmt:OGCAIE__ContractingProcess__access ;
    sysml:owner elmt:OGCAIE__ContractingProcess ;
    sysml:qualifiedName "OGCAIE::ContractingProcess::@10" ;
    sysx:relatedFeature expr:OGCAIE__ContractingProcess___4010_pend0,
        expr:OGCAIE__ContractingProcess___4010_pend1 ;
    sysx:sourceText "succession first agree then access;" .

elmt:OGCAIE__ContractingProcess___4011 a sysml:SuccessionAsUsage ;
    ogm:first elmt:OGCAIE__ContractingProcess__access ;
    ogm:then elmt:OGCAIE__ContractingProcess__fulfil ;
