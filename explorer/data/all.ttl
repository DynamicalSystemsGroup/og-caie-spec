# Every Turtle file of the repository in one default graph, the precondition of the shapes and the record queries (sheet 10-31); written by scripts/render_explorer.py.
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix elmt: <urn:sysmlv2:element:> .
@prefix epo: <https://w3id.org/og-caie/epo#> .
@prefix ev: <https://w3id.org/og-caie/evaluation/measles#> .
@prefix expr: <urn:opensysml:expr:> .
@prefix ogc: <https://w3id.org/og-caie/> .
@prefix ogm: <https://w3id.org/og-caie/model#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rul: <https://w3id.org/og-caie/rulings#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix src: <https://w3id.org/og-caie/sources#> .
@prefix sysml: <https://www.omg.org/spec/SysML#> .
@prefix sysx: <urn:opensysml:sysml:> .
@prefix term: <https://w3id.org/og-caie/terms#> .
@prefix tr: <https://w3id.org/og-caie/trace#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix xw: <https://w3id.org/og-caie/crosswalk#> .

ogc:S0-Independence a sh:NodeShape ;
    sh:sparql [ sh:message "S0 independence at the person level (sheet 10-15): the person who determines on evidence is not the operator of the session that evidence came from, unless a second determination on the same evidence by another person exists." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogc: <https://w3id.org/og-caie/>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this ?value WHERE {
                $this epo:independenceLevel epo:person .
                ?value a epo:Determination ; ogc:inRecord $this ; earl:assertedBy ?p ; prov:used ?e .
                ?p a prov:Person .
                ?e a epo:Evidence ; prov:wasDerivedFrom ?x . ?x prov:wasGeneratedBy/(epo:inSession)? ?s . ?s a epo:Session ; prov:wasAssociatedWith ?p .
                FILTER NOT EXISTS { ?d2 a epo:Determination ; ogc:inRecord $this ; prov:used ?e ; earl:assertedBy ?q . ?q a prov:Person . FILTER(?q != ?p) }
            }
        """ ],
        [ sh:message "S0 independence at the person level (sheet 10-15): the person who assesses the appropriateness of the requirement set is not attributed on the requirement set." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogc: <https://w3id.org/og-caie/>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this ?value WHERE {
                $this epo:independenceLevel epo:person .
                ?value a epo:AppropriatenessAssessment ; ogc:inRecord $this ; earl:subject ?rs ; earl:assertedBy ?p . ?rs prov:wasAttributedTo ?p .
            }
        """ ],
        [ sh:message "S0 independence at the department or organization level (sheet 10-15): the determiner and the operator of the session behind the evidence, and the assessor and the author of the requirement set, act on behalf of different units (prov:actedOnBehalfOf); at the organization level the units are organizations." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogc: <https://w3id.org/og-caie/>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this ?value WHERE {
                $this epo:independenceLevel ?level . FILTER(?level IN (epo:department, epo:organization))
                {
                    ?value a epo:Determination ; ogc:inRecord $this ; earl:assertedBy ?p ; prov:used ?e .
                    ?e a epo:Evidence ; prov:wasDerivedFrom ?x . ?x prov:wasGeneratedBy/(epo:inSession)? ?s . ?s a epo:Session ; prov:wasAssociatedWith ?q . ?q a prov:Person .
                }
                UNION
                {
                    ?value a epo:AppropriatenessAssessment ; ogc:inRecord $this ; earl:subject ?rs ; earl:assertedBy ?p . ?rs prov:wasAttributedTo ?q . ?q a prov:Person .
                }
                FILTER NOT EXISTS { ?p prov:actedOnBehalfOf ?u1 . ?q prov:actedOnBehalfOf ?u2 . FILTER(?u1 != ?u2) FILTER(?level = epo:department || EXISTS { ?u1 a prov:Organization . ?u2 a prov:Organization }) }
            }
        """ ] ;
    sh:targetClass prov:Bundle .

ogc:S0-Member a sh:NodeShape ;
    sh:sparql [ sh:message "S0: every entity, activity and agent of a record is a member of exactly one record, a prov:Bundle, through ogc:inRecord (sheet 10-31): an item outside every record would escape the constraints anchored on it." ;
            sh:select """
            PREFIX ogc: <https://w3id.org/og-caie/>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this a prov:Bundle }
                { FILTER NOT EXISTS { $this ogc:inRecord ?r . ?r a prov:Bundle } }
                UNION { $this ogc:inRecord ?r1 . $this ogc:inRecord ?r2 . FILTER(?r1 != ?r2) }
            }
        """ ] ;
    sh:targetClass prov:Activity,
        prov:Agent,
        prov:Entity .

ogc:S0-Record a sh:NodeShape ;
    sh:property [ sh:message "The record carries a label." ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:in ( epo:person epo:department epo:organization ) ;
            sh:maxCount 1 ;
            sh:message "The record states the level at which independence between the roles is required: person, department or organization (sheet 10-15)." ;
            sh:minCount 1 ;
            sh:path epo:independenceLevel ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "The synthetic tag is a boolean (sheet 10-43)." ;
            sh:path ogc:synthetic ] ;
    sh:targetClass prov:Bundle .

ogc:S0-Roles a sh:NodeShape ;
    sh:sparql [ sh:message "S0: a person holds at most one of the person roles: domain expert, evaluation operator, authorized representative, sponsor signatory (sheet 10-13; the disjointness axioms are on the role classes and do not reach persons)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            SELECT $this ?value WHERE {
                $this epo:role ?r1 ; epo:role ?value .
                FILTER(?r1 != ?value)
                FILTER(?r1 IN (epo:domainExpertRole, epo:evaluationOperatorRole, epo:accountExecutiveRole, epo:sponsorSignatoryRole))
                FILTER(?value IN (epo:domainExpertRole, epo:evaluationOperatorRole, epo:accountExecutiveRole, epo:sponsorSignatoryRole))
            }
        """ ] ;
    sh:targetClass prov:Person .

ogc:S3-PlanDeviation a sh:NodeShape ;
    sh:property [ sh:class epo:TestPlan ;
            sh:maxCount 1 ;
            sh:message "A deviation names the plan it departs from (sheet 10-16)." ;
            sh:minCount 1 ;
            sh:path epo:deviatesFrom ],
        [ sh:class epo:AcceptanceCriterion ;
            sh:maxCount 1 ;
            sh:message "A deviation names the criterion it concerns (sheet 10-16)." ;
            sh:minCount 1 ;
            sh:path epo:concerns ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A deviation states its reason (sheet 10-16)." ;
            sh:minCount 1 ;
            sh:path epo:reason ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path prov:generatedAtTime ] ;
    sh:sparql [ sh:message "S3: a plan deviation is the evaluation operator's, and is an item of the plan step or the report step (the step is derived through the model graph, sheet 10-33)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                { FILTER NOT EXISTS { $this prov:wasAttributedTo ?p . ?p epo:role epo:evaluationOperatorRole } }
                UNION { FILTER NOT EXISTS { $this a ?cls . ?kind ogm:realizes ?cls . ?p sysml:type ?kind ; sysml:direction "out" ; sysml:owner ?act . ?act ogm:realizes ?st . FILTER(?st IN (epo:plan, epo:report)) } }
            }
        """ ] ;
    sh:targetClass epo:PlanDeviation .

xw:auxiliary-assumption-contract a ogc:Crosswalk ;
    rdfs:label "auxiliary assumption, first layer (pinned at the contract)" ;
    ogc:also src:popper-1959 ;
    ogc:checkable "Pinned at the contract and timestamped before the requirement set; the evaluation takes them as given, documents them, and cannot change them." ;
    ogc:cites src:scipy-2026-bof ;
    ogc:locator "the definitions presented at the session" ;
    ogc:mapsTo term:contract,
        term:customer,
        term:mission,
        term:provider,
        term:stakeholder,
        term:statement-of-work,
        term:test-item ;
    ogc:order 2 ;
    ogc:quote "An (auxiliary) assumption is a background claim held fixed in deriving and testing a prediction. Because predictions normally follow from a hypothesis together with auxiliary assumptions and initial conditions, a failed prediction does not by logic alone identify which component is false." ;
    ogc:quoteStatus "authors" ;
    ogc:realizedBy ogc:S0-Access,
        ogc:S0-Layers,
        ogc:S0-Parties,
        ogc:S0-Population,
        ogc:S0-StatementOfWork,
        epo:Mission,
        epo:Population,
        epo:ServiceAgreement,
        epo:StatementOfWork,
        epo:TestItemAccess ;
    ogc:where "The sponsor's mission towards the affected populations, the service agreement with its statement of work, and the access to the test item: the counterparties, the object, the requirements' frame and the method, fixed before the evaluation begins." .

xw:auxiliary-assumption-evaluation a ogc:Crosswalk ;
    rdfs:label "auxiliary assumption, second layer (pinned within the evaluation)" ;
    ogc:also src:popper-1959 ;
    ogc:checkable "Declared and timestamped before testing; every attestation says whether that declared context was appropriate." ;
    ogc:cites src:scipy-2026-bof ;
    ogc:locator "the authors' definition for this specification (sheet 07-02); the slide read 'Context Matters!'" ;
    ogc:mapsTo term:domain-specific-ontology,
        term:operational-envelope,
        term:operational-environment ;
    ogc:order 3 ;
    ogc:quote "An auxiliary assumption of the second layer is a claim about the domain and the deployment setting, declared and approved before any test and held fixed while it runs." ;
    ogc:quoteStatus "authors" ;
    ogc:realizedBy ogc:S1-DsoRelease,
        ogc:S2-RequirementSet,
        epo:DsoRelease,
        epo:RequirementSet ;
    ogc:where "The requirement set declaring this test item in this environment, and the DSO release, both declared and approved before any session." .

xw:context a ogc:Crosswalk ;
    rdfs:label "context" ;
    ogc:also src:popper-1959 ;
    ogc:checkable "A failed prediction is attributed: the record says which named person judged the context inappropriate or the evidence insufficient, and why." ;
    ogc:cites src:scipy-2026-bof ;
    ogc:locator "the definitions presented at the session" ;
    ogc:mapsTo term:appropriateness,
        term:requirements-traceability,
        term:sufficiency ;
    ogc:order 7 ;
    ogc:quote "In practice, however, falsification also depends on auxiliary assumptions and methodological judgments." ;
    ogc:quoteStatus "authors" ;
    ogc:realizedBy ogc:S6-Attestation,
        ogc:S8-Recommendation ;
    ogc:where "The appropriateness and sufficiency judgments on every attestation, and the trace from each recommendation back to the requirement it answers." .

xw:evidence a ogc:Crosswalk ;
    rdfs:label "evidence" ;
    ogc:also src:popper-1959 ;
    ogc:checkable "Evidence derives from a recorded response at a recorded turn; a determination rules only on evidence that bears on the criterion it tests." ;
    ogc:cites src:scipy-2026-bof ;
    ogc:locator "the definitions presented at the session" ;
    ogc:mapsTo term:determination,
        term:objective-evidence,
        term:trajectory ;
    ogc:order 5 ;
    ogc:quote "Evidence is an accepted result of observation or experiment." ;
    ogc:quoteStatus "authors" ;
    ogc:realizedBy ogc:S5-Evidence,
        ogc:S6-Determination,
        epo:Determination,
        epo:Evidence ;
    ogc:where "The response or trajectory collected as evidence bearing on one criterion; the determination is the accepted result: passed, failed or cannot tell." .

xw:falsifiability a ogc:Crosswalk ;
    rdfs:label "falsifiability" ;
    ogc:also src:popper-1959 ;
    ogc:checkable "A failed outcome is a recorded falsifier; coverage is recomputed from the record, and a criterion with no attestation counts zero." ;
    ogc:cites src:scipy-2026-bof ;
    ogc:locator "the definitions presented at the session" ;
    ogc:mapsTo term:attestation,
        term:outcome,
        term:test-coverage ;
    ogc:order 6 ;
    ogc:quote "Falsifiability is the property of excluding at least one possible empirical outcome." ;
    ogc:quoteStatus "authors" ;
    ogc:realizedBy ogc:S6-Attestation,
        ogc:S7-Report,
        epo:Attestation,
        epo:Report ;
    ogc:where "The attestation's outcome for each criterion, and the report's coverage over all of them." .

xw:hypothesis a ogc:Crosswalk ;
    rdfs:label "hypothesis" ;
    ogc:also src:popper-1959 ;
    ogc:checkable "The expected result is written down before testing, so a determination can rule it not met." ;
    ogc:cites src:scipy-2026-bof ;
    ogc:locator "the definitions presented at the session" ;
    ogc:mapsTo term:acceptance-criteria,
        term:expected-results,
        term:requirement ;
    ogc:order 1 ;
    ogc:quote "A hypothesis is a conjectural claim that can be subjected to empirical tests and potentially falsified. Its empirical content lies partly in what it rules out: the more possible outcomes it excludes, the greater the risk it takes." ;
    ogc:quoteStatus "authors" ;
    ogc:realizedBy ogc:S2-AcceptanceCriterion,
        ogc:S2-Requirement,
        epo:AcceptanceCriterion ;
    ogc:where "An acceptance criterion derived from a requirement, stating the expected result a test could observe." .

xw:prediction a ogc:Crosswalk ;
    rdfs:label "prediction" ;
    ogc:also src:popper-1959 ;
    ogc:checkable "The plan names its objectives and means before any session; every probe names the criteria it exercises." ;
    ogc:cites src:scipy-2026-bof ;
    ogc:locator "the definitions presented at the session" ;
    ogc:mapsTo term:expected-results,
        term:probe,
        term:session,
        term:test-plan ;
    ogc:order 4 ;
    ogc:quote "A prediction is an observable consequence that should occur if the hypothesis and relevant auxiliary assumptions are true. An observation that should not occur under those conditions is a potential falsifier." ;
    ogc:quoteStatus "authors" ;
    ogc:realizedBy ogc:S3-Probe,
        ogc:S3-TestPlan,
        epo:Probe,
        epo:TestPlan,
        epo:Turn ;
    ogc:where "A probe applied at a turn of a session under the test plan, against the criterion's expected result." .

epo: a owl:Ontology ;
    rdfs:label "OG-CAIE Evaluation Process Ontology (EPO), minimal handles" ;
    rdfs:comment "Assembles PROV-O and EARL. A coined term (ruling R-09): the domain-independent standard operating procedure whose record, when it conforms to shapes/epo.shapes.ttl, shows the process was followed and lets coverage be computed." .

epo:actsOnBehalfOf a owl:ObjectProperty ;
    rdfs:comment "the sponsor commissions the evaluation on behalf of an affected population: one that is a customer of the test item, or one affected indirectly through others' use of it (Z, sheet 08); the sponsor's mission regards the same populations (R-37). A plain property, no longer a subproperty of prov:actedOnBehalfOf, whose direction of responsibility runs the other way (sheet 10-34, R-50)" ;
    rdfs:domain prov:Organization ;
    rdfs:range epo:Population .

epo:affectedAs a owl:ObjectProperty ;
    rdfs:comment "how the population is affected; a population may carry both values" ;
    rdfs:domain epo:Population ;
    rdfs:range epo:Affectedness .

epo:approvesRequirementSet a owl:ObjectProperty ;
    rdfs:comment "the requirement set the sponsor's signatory approved (sheet 10-01)" ;
    rdfs:domain epo:RequirementSetApproval ;
    rdfs:range epo:RequirementSet .

epo:decides a owl:ObjectProperty ;
    rdfs:domain epo:StatementOfWork ;
    rdfs:range epo:EngagementDecision .

epo:engagement a owl:ObjectProperty ;
    rdfs:comment "interview or representation (R-40)" ;
    rdfs:domain epo:EngagementDecision ;
    rdfs:range epo:Engagement .

epo:excludes a owl:ObjectProperty ;
    rdfs:comment "what a judgment left out on purpose, with epo:reason (sheets 10-11, 10-14, R-50): a determination the attestation did not use, an evidence item the determination did not use, an attestation the recommendation does not rest on. No cherry-picking: a judgment accounts for all relevant evidence in the record, or names what it left out and why" .

epo:gaps a owl:DatatypeProperty ;
    rdfs:comment "the gaps a draft report flags (sheet 10-41); required by S7 on a draft" ;
    rdfs:domain epo:Report ;
    rdfs:range xsd:string .

epo:hasUserInterest a owl:DatatypeProperty ;
    rdfs:comment "whether the sponsor has a user interest in the test item (ISO/IEC 17000 4.4, 4.5; sheet 10-07)" ;
    rdfs:domain epo:UserInterestDeclaration ;
    rdfs:range xsd:boolean .

epo:inSuite a owl:ObjectProperty ;
    rdfs:domain epo:Session ;
    rdfs:range epo:TestSuite .

epo:independentOf a owl:ObjectProperty ;
    rdfs:comment "the test item provider the testing organization declares itself independent of (sheet 10-07)" ;
    rdfs:domain epo:IndependenceDeclaration ;
    rdfs:range prov:Organization .

epo:population a owl:ObjectProperty ;
    rdfs:domain epo:EngagementDecision ;
    rdfs:range epo:Population .

epo:providesTestItem a owl:DatatypeProperty ;
    rdfs:label "provides the test item" ;
    rdfs:comment "true on the organization that provides the test item and is accountable for it as its provider (ISO/IEC 17000 first party; sheet 10-09, R-50, renaming epo:isAccountable): the sponsor may be that organization, and then holds the test item provider's role too (S0-Parties). The sponsor's obligation to the affected populations is its own and the contract does not transfer it" ;
    rdfs:domain prov:Organization ;
    rdfs:range xsd:boolean .

epo:representedBy a owl:ObjectProperty ;
    rdfs:comment "who speaks for the population: the team member whose stakeholder representation speaks on its behalf, whether or not it was interviewed; any team member may, since speaking for a population is not a judgment on the test item (sheet 10-13, R-50). Every population carries it; an interviewed population carries the responsible party too" ;
    rdfs:domain epo:Population ;
    rdfs:range prov:Person ;
    rdfs:subPropertyOf epo:responsibleParty .

epo:represents a owl:ObjectProperty ;
    rdfs:comment "the population spoken for" ;
    rdfs:domain epo:StakeholderRepresentation ;
    rdfs:range epo:Population .

epo:role a owl:ObjectProperty ;
    rdfs:comment "convenience handle: the role an agent fills in this record (the PROV form is a qualified association; one property keeps the shapes readable); an agent may hold several roles (the sponsor may also be the test item customer)" ;
    rdfs:domain prov:Agent ;
    rdfs:range epo:Role .

epo:signedBy a owl:ObjectProperty ;
    rdfs:comment "the two persons who sign, each acting on behalf of their organization (prov:actedOnBehalfOf): the sponsor's signatory and the authorized representative (sheet 10-06)" ;
    rdfs:domain epo:ServiceAgreement ;
    rdfs:range prov:Person ;
    rdfs:subPropertyOf prov:wasAttributedTo .

epo:step a owl:ObjectProperty ;
    rdfs:comment "the step an item was produced at: derived from the item's class through the model graph (ogm:realizes), never asserted in a record (sheet 10-33, R-50); see the note under epo:Step" ;
    rdfs:range epo:Step .

epo:targetsGuardrail a owl:DatatypeProperty ;
    rdfs:domain epo:Recommendation ;
    rdfs:range xsd:string .

epo:turns a owl:DatatypeProperty ;
    rdfs:domain epo:Trajectory ;
    rdfs:range xsd:integer .

epo:underMission a owl:ObjectProperty ;
    rdfs:domain epo:Need ;
    rdfs:range epo:Mission .

epo:versionIdentity a owl:DatatypeProperty ;
    rdfs:comment "the identity of the test item version access is granted to, as the provider names it (sheet 10-04)" ;
    rdfs:domain epo:TestItemAccess ;
    rdfs:range xsd:string .

ev:acceptance-1 a epo:Acceptance ;
    rdfs:label "the county health officer accepts the delivery on behalf of the county public-health office" ;
