elmt:OGCAIE__Response___400 a sysml:Documentation ;
    sysml:body " What the test item produced at one turn of a session. " ;
    sysml:owner elmt:OGCAIE__Response ;
    sysml:qualifiedName "OGCAIE::Response::@0" .

elmt:OGCAIE__Response__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__Response ;
    sysml:qualifiedName "OGCAIE::Response::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__ServiceAgreement___400 a sysml:Documentation ;
    sysml:body """ The contract (ISO 9000:2026 3.3.13) between the sponsor
           organization and the testing organization to perform OG-CAIE
           as a service, signed by the sponsor's signatory and by the testing
           organization's authorized representative, each acting on behalf
           of their organization (rulings R-21, R-23, R-50). It accepts the
           proposal; the statement of work, the access and the delivery are
           under it (sheet 10-05). """ ;
    sysml:owner elmt:OGCAIE__ServiceAgreement ;
    sysml:qualifiedName "OGCAIE::ServiceAgreement::@0" .

elmt:OGCAIE__ServiceAgreement__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__ServiceAgreement ;
    sysml:qualifiedName "OGCAIE::ServiceAgreement::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__Session___400 a sysml:Documentation ;
    sysml:body """ One operator paired with the test item; its ordered turns
           form a trajectory (NIST AI 700-2; IEC 60050-351; R-13). """ ;
    sysml:owner elmt:OGCAIE__Session ;
    sysml:qualifiedName "OGCAIE::Session::@0" .

elmt:OGCAIE__Session__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__Session ;
    sysml:qualifiedName "OGCAIE::Session::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__SponsorOrganization___400 a sysml:Documentation ;
    sysml:body """ The customer (ISO 9000:2026 3.9.1): states its mission and
           obligations towards the affected populations (R-37), states the need,
           receives the proposal, commissions the evaluation under the
           service agreement, receives the delivery through the authorized
           representative (R-32). Where a person signs, the port is the
           signatory's (sheet 10-06, R-50): the agreement, the acceptance,
           the requirement-set approval and the user-interest declaration.
           Whether it is also the test item provider, and whether it has a
           user interest in the test item, the record says by declaration. """ ;
    sysml:owner elmt:OGCAIE__SponsorOrganization ;
    sysml:qualifiedName "OGCAIE::SponsorOrganization::@0" .

elmt:OGCAIE__SponsorSignatory___400 a sysml:Documentation ;
    sysml:body """ The sponsor's signatory: a named person acting on behalf of the
           sponsor organization, the acquirer's authorized representative in
           SEVOCAB's acceptance (sheet 10-06, R-50). Signs the agreement,
           declares the sponsor's user interest, approves the requirement
           set, and accepts the delivery. The worked example's county health
           officer. """ ;
    sysml:owner elmt:OGCAIE__SponsorSignatory ;
    sysml:qualifiedName "OGCAIE::SponsorSignatory::@0" .

elmt:OGCAIE__StakeholderInputSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__StakeholderInputSeam ;
    sysml:qualifiedName "OGCAIE::StakeholderInputSeam::consumer" ;
    sysml:type elmt:OGCAIE__StakeholderInputWrite .

elmt:OGCAIE__StakeholderInputSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__StakeholderInputSeam ;
    sysml:qualifiedName "OGCAIE::StakeholderInputSeam::supplier" ;
    sysml:type elmt:OGCAIE__StakeholderInputWrite .

elmt:OGCAIE__StakeholderInputWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__StakeholderInputWrite ;
    sysml:qualifiedName "OGCAIE::StakeholderInputWrite::i" ;
    sysml:type elmt:OGCAIE__StakeholderInput .

elmt:OGCAIE__StakeholderInput___400 a sysml:Documentation ;
    sysml:body """ What an interviewed affected population said. Optional:
           populations not interviewed are represented by the domain
           expert, and the record names who represents them (R-21). """ ;
    sysml:owner elmt:OGCAIE__StakeholderInput ;
    sysml:qualifiedName "OGCAIE::StakeholderInput::@0" .

elmt:OGCAIE__StakeholderInput__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__StakeholderInput ;
    sysml:qualifiedName "OGCAIE::StakeholderInput::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__StakeholderRepresentation___400 a sysml:Documentation ;
    sysml:body """ What a representative says on behalf of an affected
           population, built from its interview when there was one:
           representation is always present for a named population, the
           interview layer is optional and feeds it (walkthrough B3, R-49).
           Pinned within the evaluation. """ ;
    sysml:owner elmt:OGCAIE__StakeholderRepresentation ;
    sysml:qualifiedName "OGCAIE::StakeholderRepresentation::@0" .

elmt:OGCAIE__StakeholderRepresentation__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__StakeholderRepresentation ;
    sysml:qualifiedName "OGCAIE::StakeholderRepresentation::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__StatementOfWorkSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__StatementOfWorkSeam ;
    sysml:qualifiedName "OGCAIE::StatementOfWorkSeam::consumer" ;
    sysml:type elmt:OGCAIE__StatementOfWorkWrite .

elmt:OGCAIE__StatementOfWorkSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__StatementOfWorkSeam ;
    sysml:qualifiedName "OGCAIE::StatementOfWorkSeam::supplier" ;
    sysml:type elmt:OGCAIE__StatementOfWorkWrite .

elmt:OGCAIE__StatementOfWorkWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__StatementOfWorkWrite ;
    sysml:qualifiedName "OGCAIE::StatementOfWorkWrite::i" ;
    sysml:type elmt:OGCAIE__StatementOfWork .

elmt:OGCAIE__StatementOfWork___400 a sysml:Documentation ;
    sysml:body """ The sponsor's scope-of-work decisions under the contract (SEVOCAB
           statement of work): for each affected population, interview or
           representation. A boundary item between the contract and its
           fulfilment (ruling R-40): decided with the agreement, consumed by
           the scope step. Pinned at the contract. """ ;
    sysml:owner elmt:OGCAIE__StatementOfWork ;
    sysml:qualifiedName "OGCAIE::StatementOfWork::@0" .

elmt:OGCAIE__StatementOfWork__engagement a sysml:AttributeUsage ;
    sysml:declaredName "engagement" ;
    sysml:lowerBound expr:OGCAIE__StatementOfWork__engagement_plowerBound ;
    sysml:owner elmt:OGCAIE__StatementOfWork ;
    sysml:qualifiedName "OGCAIE::StatementOfWork::engagement" ;
    sysml:type elmt:OGCAIE__Engagement ;
    sysml:upperBound expr:OGCAIE__StatementOfWork__engagement_pupperBound .

elmt:OGCAIE__StatementOfWork__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__StatementOfWork ;
    sysml:qualifiedName "OGCAIE::StatementOfWork::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__StatementOfWork__regards a sysml:PartUsage ;
    sysml:declaredName "regards" ;
    sysml:lowerBound expr:OGCAIE__StatementOfWork__regards_plowerBound ;
    sysml:owner elmt:OGCAIE__StatementOfWork ;
    sysml:qualifiedName "OGCAIE::StatementOfWork::regards" ;
    sysml:type elmt:OGCAIE__AffectedPopulation ;
    sysml:upperBound expr:OGCAIE__StatementOfWork__regards_pupperBound .

elmt:OGCAIE__Strategy___400 a sysml:Documentation ;
    sysml:body """ A test strategy: a state feedback policy choosing the next
           probe from the trajectory so far (R-13). Optional. """ ;
    sysml:owner elmt:OGCAIE__Strategy ;
    sysml:qualifiedName "OGCAIE::Strategy::@0" .

elmt:OGCAIE__Strategy__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__Strategy ;
    sysml:qualifiedName "OGCAIE::Strategy::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__Sufficiency___400 a sysml:Documentation ;
    sysml:body """ Hawkins et al. 2011, section 3.3; ISA 500 paragraph 5(f):
           the measure of the quantity of evidence. """ ;
    sysml:owner elmt:OGCAIE__Sufficiency ;
    sysml:qualifiedName "OGCAIE::Sufficiency::@0" .

elmt:OGCAIE__Sufficiency__insufficient a sysml:EnumerationUsage ;
    sysml:declaredName "insufficient" ;
    sysml:owner elmt:OGCAIE__Sufficiency ;
    sysml:qualifiedName "OGCAIE::Sufficiency::insufficient" .

elmt:OGCAIE__Sufficiency__sufficient a sysml:EnumerationUsage ;
    sysml:declaredName "sufficient" ;
    sysml:owner elmt:OGCAIE__Sufficiency ;
    sysml:qualifiedName "OGCAIE::Sufficiency::sufficient" .

elmt:OGCAIE__TestDriver___400 a sysml:Documentation ;
    sysml:body """ The machine part of administering the test plan (SEVOCAB test
           driver, walkthrough B8, R-49): derives the probes from the DSO
           release and the requirement set in the record; one output read
           by the operator and the recorder (an output wire may be shared,
           R-25). """ ;
    sysml:owner elmt:OGCAIE__TestDriver ;
    sysml:qualifiedName "OGCAIE::TestDriver::@0" .

elmt:OGCAIE__TestItemAccess___400 a sysml:Documentation ;
    sysml:body """ The test item provider's grant of access to the test item under
           the agreement: the version identity, the access period, the
           instrument outside this agreement under which the provider owes
           the access, and the environment (sheet 10-04, R-50). """ ;
    sysml:owner elmt:OGCAIE__TestItemAccess ;
    sysml:qualifiedName "OGCAIE::TestItemAccess::@0" .

elmt:OGCAIE__TestItemAccess__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__TestItemAccess ;
    sysml:qualifiedName "OGCAIE::TestItemAccess::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__TestItem___400 a sysml:Documentation ;
    sysml:body """ The test item (SEVOCAB; the prose says system under test,
           ruling R-19): a black box that is given probes and produces
           responses. Provided by the accountable organization, inside
           the record, outside the testing organization's responsibility. """ ;
    sysml:owner elmt:OGCAIE__TestItem ;
    sysml:qualifiedName "OGCAIE::TestItem::@0" .

elmt:OGCAIE__TestPlan___400 a sysml:Documentation ;
    sysml:body """ SEVOCAB test plan: objectives (criteria) and means (probes
           or a test strategy), fixed before any session (R-12, R-13). """ ;
    sysml:owner elmt:OGCAIE__TestPlan ;
    sysml:qualifiedName "OGCAIE::TestPlan::@0" .

elmt:OGCAIE__TestPlan__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__TestPlan ;
    sysml:qualifiedName "OGCAIE::TestPlan::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__TestingOrganization___400 a sysml:Documentation ;
    sysml:body """ The provider (ISO 9000:2026 3.1.9): performs the evaluation
           as a service. Holds exactly one authorized representative, one
           team of one or more domain experts and one or more operators (all
           three are roles within it, ruling R-23), and the four machines.
           Independent of the test item provider, with no user interest in
           the test item, its activity is third-party (ISO/IEC 17000 4.5);
           its independence declaration in the record says so (sheet
           10-07). """ ;
    sysml:owner elmt:OGCAIE__TestingOrganization ;
    sysml:qualifiedName "OGCAIE::TestingOrganization::@0" .

elmt:OGCAIE__TestingOrganization__team a sysml:PartUsage ;
    sysml:declaredName "team" ;
    sysml:owner elmt:OGCAIE__TestingOrganization ;
    sysml:qualifiedName "OGCAIE::TestingOrganization::team" ;
    sysml:type elmt:OGCAIE__EvaluationTeam ;
    sysml:upperBound expr:OGCAIE__TestingOrganization__team_pupperBound .

elmt:OGCAIE__UserInterestDeclarationSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__UserInterestDeclarationSeam ;
    sysml:qualifiedName "OGCAIE::UserInterestDeclarationSeam::consumer" ;
    sysml:type elmt:OGCAIE__UserInterestDeclarationWrite .

elmt:OGCAIE__UserInterestDeclarationSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__UserInterestDeclarationSeam ;
    sysml:qualifiedName "OGCAIE::UserInterestDeclarationSeam::supplier" ;
    sysml:type elmt:OGCAIE__UserInterestDeclarationWrite .

elmt:OGCAIE__UserInterestDeclarationWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__UserInterestDeclarationWrite ;
    sysml:qualifiedName "OGCAIE::UserInterestDeclarationWrite::i" ;
    sysml:type elmt:OGCAIE__UserInterestDeclaration .

elmt:OGCAIE__UserInterestDeclaration___400 a sysml:Documentation ;
    sysml:body """ The sponsor's declaration, made by its signatory and dated, of
           whether it has a user interest in the test item (ISO/IEC 17000
           4.4, 4.5). Replaces a bare boolean on the organization (sheet
           10-07, R-50). Pinned at the contract. """ ;
    sysml:owner elmt:OGCAIE__UserInterestDeclaration ;
    sysml:qualifiedName "OGCAIE::UserInterestDeclaration::@0" .

elmt:OGCAIE__UserInterestDeclaration__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__UserInterestDeclaration ;
    sysml:qualifiedName "OGCAIE::UserInterestDeclaration::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE___400 a sysml:Documentation ;
    sysml:body """ Ontology-Grounded Contextual AI Evaluation (OG-CAIE) as an
       executable specification. Scope: Concept Definition plus System
       Requirements Definition (SEBoK v2.14, ISO/IEC/IEEE 15288:2023),
       including the assessment of interactions across interfaces. No
       logical or physical architecture is modeled (ruling R-07).

       This file holds structure only (ruling R-22): the parties, the
       items that cross seams, the ports and interfaces, the six-step contracting lifecycle and the six-step
       Evaluation Process Ontology as an action def, and one assemblage
       that wires them. It is the authoring view. The canonical structure
       is its pruned RDF rendering, model/og-caie.model.ttl, produced by
       the pinned OpenSysML converter (designed for Flexo MMS) and checked
       by SHACL wiring shapes (shapes/model.shapes.ttl, M1 to M5). Value
       and provenance rules live in shapes over the evaluation record
       (shapes/epo.shapes.ttl, S0 to S9). The thirteen essentials SCI-01 to
       SCI-13 and the shapes that check each are in model/trace.ttl.

       Vocabulary: terms are used, not owned. Canonical definitions are
       cited in vocabulary/og-caie.ttl in this precedence: ISO 9000:2026,
       SEVOCAB (IEEE CS), NIST AI 700-2, then W3C/OMG for binding only.
       Coinage is exactly three: DSO, EPO, OG-CAIE. Rulings are recorded
       verbatim in rulings/adjudications.ttl. """ ;
    sysml:owner elmt:OGCAIE ;
    sysml:qualifiedName "OGCAIE::@0" .

ogc:M1-Obligation a sh:NodeShape ;
    sh:sparql [ sh:message "The assembly relates the sponsor to the affected populations by an obligation: a connection usage typed Obligation whose ends are the sponsor part and the affected part, a relation that carries no item (R-38)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            SELECT $this WHERE {
                $this sysml:declaredName "OgCaieEvaluation" .
                FILTER NOT EXISTS {
                    ?c a sysml:ConnectionUsage ; sysml:owner $this ; sysml:type ?t ; ogm:relatesFrom ?s ; ogm:relatesTo ?p .
                    ?t sysml:declaredName "Obligation" .
                    ?s sysml:type ?sd . ?sd sysml:declaredName "SponsorOrganization" .
                    ?p sysml:type ?pd . ?pd sysml:declaredName "AffectedPopulation" .
                }
            }
        """ ],
        [ sh:message "The mission regards one or more affected populations: the Mission item owns a reference part typed AffectedPopulation with lower bound one (R-37, R-38)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                $this sysml:declaredName "Mission" .
                FILTER NOT EXISTS {
                    ?r a sysml:PartUsage ; sysml:owner $this ; sysml:type ?t ; sysml:lowerBound ?lb .
                    ?t sysml:declaredName "AffectedPopulation" . ?lb sysml:value 1 .
                }
            }
        """ ] ;
    sh:targetClass sysml:ItemDefinition,
        sysml:PartDefinition .

ogc:M1-Parties a sh:NodeShape ;
    sh:sparql [ sh:message "The assembly owns exactly one part typed by each of SponsorOrganization, TestingOrganization and AccountableOrganization (R-21); a second sponsor part or a missing one fails (sheet 10)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this ?value WHERE {
                $this sysml:declaredName "OgCaieEvaluation" .
                {
                    SELECT $this ?value (COUNT(?u) AS ?n) WHERE {
                        { BIND("SponsorOrganization" AS ?value) } UNION { BIND("TestingOrganization" AS ?value) } UNION { BIND("AccountableOrganization" AS ?value) }
                        OPTIONAL { ?u a sysml:PartUsage ; sysml:owner $this ; sysml:type ?t . ?t sysml:declaredName ?value . }
                    } GROUP BY $this ?value
                }
                FILTER(?n != 1)
            }
        """ ],
        [ sh:message "The assembly owns a part typed AffectedPopulation with lower bound zero: populations are many and may be absent (R-21)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                $this sysml:declaredName "OgCaieEvaluation" .
                FILTER NOT EXISTS {
                    ?u a sysml:PartUsage ; sysml:owner $this ; sysml:type ?t ; sysml:lowerBound ?lb .
                    ?t sysml:declaredName "AffectedPopulation" . ?lb sysml:value 0 .
                }
            }
        """ ] ;
    sh:targetClass sysml:PartDefinition .

ogc:M2-Part a sh:NodeShape ;
    sh:sparql [ sh:message "At the part: every input port is present on exactly one wire (input wires are unique, R-25, R-26)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            SELECT $this ?value WHERE {
                ?value a sysml:PortUsage ; sysml:owner $this ; sysml:isConjugated true .
                { FILTER NOT EXISTS { ?e ogm:resolvesTo ?value } }
                UNION { ?e1 ogm:resolvesTo ?value . ?e2 ogm:resolvesTo ?value . FILTER(?e1 != ?e2) }
            }
        """ ],
        [ sh:message "At the part: every output port goes somewhere, on one wire or several, since what flows is information (R-25, R-26)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            SELECT $this ?value WHERE {
                ?value a sysml:PortUsage ; sysml:owner $this .
                FILTER NOT EXISTS { ?value sysml:isConjugated true } FILTER NOT EXISTS { ?value sysml:isEnd true }
                FILTER NOT EXISTS { ?e ogm:resolvesTo ?value }
            }
        """ ] ;
    sh:targetClass sysml:PartDefinition .

ogc:M2-Wire a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A wire comes from exactly one output port." ;
            sh:minCount 1 ;
            sh:path ogm:supplierPort ],
        [ sh:maxCount 1 ;
            sh:message "A wire goes to exactly one input port." ;
            sh:minCount 1 ;
            sh:path ogm:consumerPort ] ;
    sh:sparql [ sh:message "A wire runs from an output port on a part to an input port on a part: the output end is a plain port owned by a part definition, the input end a conjugated one (R-26)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            SELECT $this ?value WHERE {
                { $this ogm:supplierPort ?value . FILTER( EXISTS { ?value sysml:isConjugated true } || EXISTS { ?value sysml:isEnd true }
                    || NOT EXISTS { ?value sysml:owner ?d . ?d a sysml:PartDefinition } ) }
                UNION
                { $this ogm:consumerPort ?value . FILTER( NOT EXISTS { ?value sysml:isConjugated true } || EXISTS { ?value sysml:isEnd true }
                    || NOT EXISTS { ?value sysml:owner ?d . ?d a sysml:PartDefinition } ) }
            }
        """ ],
        [ sh:message "The output port's type is the wire's supplier end type: what flows is one item kind." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            SELECT $this ?value WHERE {
                $this sysml:type ?idef ; ogm:supplierPort ?sp .
                ?end a sysml:PortUsage ; sysml:owner ?idef ; sysml:isEnd true ; sysml:type ?t .
                FILTER NOT EXISTS { ?end sysml:isConjugated true }
                ?sp sysml:type ?value . FILTER(?value != ?t)
            }
        """ ],
        [ sh:message "The input port's type is the wire's consumer end type, conjugated: it receives the same item kind." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            SELECT $this ?value WHERE {
                $this sysml:type ?idef ; ogm:consumerPort ?cp .
                ?end a sysml:PortUsage ; sysml:owner ?idef ; sysml:isEnd true ; sysml:isConjugated true ; sysml:type ?t .
                ?cp sysml:type ?value . FILTER(?value != ?t)
            }
        """ ] ;
    sh:targetClass sysml:InterfaceUsage .

ogc:M3-RecordHub a sh:NodeShape ;
    sh:sparql [ sh:message "Every item kind that crosses a seam reaches the recorder: the recorder owns a conjugated port of this type (R-17)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this sysml:declaredName "RecordWrite" }
                FILTER NOT EXISTS {
                    ?p a sysml:PortUsage ; sysml:type $this ; sysml:isConjugated true ; sysml:owner ?rec .
                    ?rec sysml:declaredName "Recorder" .
                }
            }
        """ ] ;
    sh:targetClass sysml:PortDefinition .

ogc:M4-EveryItemProduced a sh:NodeShape ;
    sh:sparql [ sh:message "Every item kind is an out parameter of some step of the process, or the process's own result: nothing in the record appears from nowhere." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    ?r a sysml:ReferenceUsage ; sysml:direction "out" ; sysml:type $this ; sysml:owner ?o .
                    ?o sysml:owner* ?proc . ?proc a sysml:ActionDefinition .
                }
            }
        """ ] ;
    sh:targetClass sysml:ItemDefinition .

ogc:M4-ProcessDag a sh:NodeShape ;
    sh:sparql [ sh:message "The EPO is a process DAG (R-26): no step succeeds itself, directly or through other steps." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            SELECT $this ?value WHERE {
                $this ogm:first ?value .
                ?value (^ogm:first/ogm:then)+ ?value .
            }
        """ ] ;
    sh:targetClass sysml:SuccessionAsUsage .

ogc:M4-Steps a sh:NodeShape ;
    sh:sparql [ sh:message "The evaluation owns exactly six steps; the contracting lifecycle owns six of its own plus the nested fulfil step (R-21, R-32, R-33)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this (COUNT(?a) AS ?value) WHERE {
                $this sysml:declaredName ?n . FILTER(?n IN ("EvaluationProcess", "ContractingProcess"))
                ?a a sysml:ActionUsage ; sysml:owner $this .
            } GROUP BY $this ?n HAVING ((?n = "EvaluationProcess" && COUNT(?a) != 6) || (?n = "ContractingProcess" && COUNT(?a) != 7))
        """ ],
        [ sh:message "The steps succeed one another in the fixed order: scope, declareRequirements, plan, execute, determineAndAttest, report for the evaluation; need, propose, agree, access, fulfil, deliver, acceptDelivery for the contracting lifecycle." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            SELECT $this ?value WHERE {
                $this sysml:declaredName ?n .
                { FILTER(?n = "EvaluationProcess")
                  { { BIND("scope" AS ?a) BIND("declareRequirements" AS ?b) } UNION { BIND("declareRequirements" AS ?a) BIND("plan" AS ?b) }
                    UNION { BIND("plan" AS ?a) BIND("execute" AS ?b) } UNION { BIND("execute" AS ?a) BIND("determineAndAttest" AS ?b) }
                    UNION { BIND("determineAndAttest" AS ?a) BIND("report" AS ?b) } } }
                UNION
                { FILTER(?n = "ContractingProcess")
                  { { BIND("need" AS ?a) BIND("propose" AS ?b) } UNION { BIND("propose" AS ?a) BIND("agree" AS ?b) }
                    UNION { BIND("agree" AS ?a) BIND("access" AS ?b) } UNION { BIND("access" AS ?a) BIND("fulfil" AS ?b) }
                    UNION { BIND("fulfil" AS ?a) BIND("deliver" AS ?b) } UNION { BIND("deliver" AS ?a) BIND("acceptDelivery" AS ?b) } } }
                BIND(CONCAT(?a, " then ", ?b) AS ?value)
                FILTER NOT EXISTS {
                    ?s a sysml:SuccessionAsUsage ; sysml:owner $this ; ogm:first ?fa ; ogm:then ?tb .
                    ?fa sysml:declaredName ?a . ?tb sysml:declaredName ?b .
                }
            }
        """ ] ;
    sh:targetClass sysml:ActionDefinition .

ogc:M5-Cardinality a sh:NodeShape ;
    sh:sparql [ sh:message "The testing organization holds exactly one authorized representative (AccountExecutive) (R-23)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this (COUNT(?u) AS ?value) WHERE {
                $this sysml:declaredName "TestingOrganization" .
                OPTIONAL { ?u a sysml:PartUsage ; sysml:owner $this ; sysml:type ?t . ?t sysml:declaredName "AccountExecutive" . }
            } GROUP BY $this HAVING (COUNT(?u) != 1)
        """ ],
        [ sh:message "The sponsor organization holds exactly one signatory (SponsorSignatory), the named person who signs, approves the requirement set and accepts on its behalf (sheet 10-06, R-50)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this (COUNT(?u) AS ?value) WHERE {
                $this sysml:declaredName "SponsorOrganization" .
                OPTIONAL { ?u a sysml:PartUsage ; sysml:owner $this ; sysml:type ?t . ?t sysml:declaredName "SponsorSignatory" . }
            } GROUP BY $this HAVING (COUNT(?u) != 1)
        """ ],
        [ sh:message "The evaluation team allows one or more domain experts and one or more operators: lower bound one, upper bound unbounded (R-23)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this ?value WHERE {
                $this sysml:declaredName "EvaluationTeam" .
                { BIND("DomainExpert" AS ?value) } UNION { BIND("EvaluationOperator" AS ?value) }
                FILTER NOT EXISTS {
                    ?u a sysml:PartUsage ; sysml:owner $this ; sysml:type ?t ; sysml:lowerBound ?lb ; sysml:upperBound ?ub .
                    ?t sysml:declaredName ?value . ?lb sysml:value 1 . ?ub a sysml:LiteralInfinity .
                }
            }
        """ ] ;
    sh:targetClass sysml:PartDefinition .

ogc:M5-PortsBelongToRoles a sh:NodeShape ;
    sh:sparql [ sh:message "DSO, appropriateness assessment, plan approval, report approval and attestation are supplied only by the domain expert (R-10, R-21, R-49)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this ?value WHERE {
                FILTER NOT EXISTS { $this sysml:isEnd true } FILTER NOT EXISTS { $this sysml:isConjugated true }
                $this sysml:type ?t ; sysml:owner ?o . ?t sysml:declaredName ?tn . ?o sysml:declaredName ?value .
                FILTER(?tn IN ("DsoWrite", "AssessmentWrite", "PlanApprovalWrite", "ReportApprovalWrite", "AttestationWrite") && ?value != "DomainExpert")
            }
        """ ],
        [ sh:message "Evidence is supplied only by the evaluation operator, and a person applies probes to the test item only as the evaluation operator (R-12, R-23)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this ?value WHERE {
                FILTER NOT EXISTS { $this sysml:isEnd true } FILTER NOT EXISTS { $this sysml:isConjugated true }
                $this sysml:type ?t ; sysml:owner ?o . ?t sysml:declaredName ?tn . ?o sysml:declaredName ?value .
                OPTIONAL { ?o sysml:specializes ?k . ?k sysml:declaredName ?kind }
                FILTER( (?tn = "EvidenceWrite" && ?value != "EvaluationOperator")
                     || (?tn = "ProbeWrite" && ?kind = "Person" && ?value != "EvaluationOperator") )
            }
        """ ],
        [ sh:message "The service agreement is supplied only by the sponsor's signatory and the authorized representative (sheet 10-06); the authorized representative supplies nothing but the proposal, the countersigned agreement, its independence declaration (sheet 10-07) and the delivery, and never judges (R-23, R-24, R-32)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this ?value WHERE {
                FILTER NOT EXISTS { $this sysml:isEnd true }
                $this sysml:type ?t ; sysml:owner ?o . ?t sysml:declaredName ?tn . ?o sysml:declaredName ?value .
                OPTIONAL { $this sysml:isConjugated ?c }
                FILTER( (?tn = "AgreementWrite" && !BOUND(?c) && ?value NOT IN ("SponsorSignatory", "AccountExecutive"))
                     || (?value = "AccountExecutive" && !BOUND(?c) && ?tn NOT IN ("AgreementWrite", "DeliveryWrite", "ProposalWrite", "IndependenceDeclarationWrite"))
                     || (?value = "AccountExecutive" && ?tn IN ("EvidenceWrite", "DeterminationWrite", "AttestationWrite")) )
            }
        """ ],
        [ sh:message "Where the sponsor signs, the port is its signatory's (sheet 10-06): the acceptance, the requirement-set approval and the user-interest declaration are supplied only by SponsorSignatory, a Person, and the sponsor organization supplies none of them." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this ?value WHERE {
                FILTER NOT EXISTS { $this sysml:isEnd true } FILTER NOT EXISTS { $this sysml:isConjugated true }
                $this sysml:type ?t ; sysml:owner ?o . ?t sysml:declaredName ?tn . ?o sysml:declaredName ?value .
                FILTER( (?tn IN ("AcceptanceWrite", "RequirementSetApprovalWrite", "UserInterestDeclarationWrite") && ?value != "SponsorSignatory")
                     || (?value = "SponsorSignatory" && ?tn NOT IN ("AgreementWrite", "AcceptanceWrite", "RequirementSetApprovalWrite", "UserInterestDeclarationWrite")) )
            }
        """ ] ;
    sh:targetClass sysml:PortUsage .

ogc:M5-Roles a sh:NodeShape ;
    sh:sparql [ sh:message "The three actor categories are distinct part definitions of Person: DomainExpert, EvaluationOperator, AccountExecutive (R-10, R-23)." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this ?value WHERE {
                FILTER NOT EXISTS { $this sysml:owner ?parent }
                { BIND("DomainExpert" AS ?value) } UNION { BIND("EvaluationOperator" AS ?value) } UNION { BIND("AccountExecutive" AS ?value) }
                FILTER NOT EXISTS {
                    ?d a sysml:PartDefinition ; sysml:owner $this ; sysml:declaredName ?value ; sysml:specializes ?p .
                    ?p sysml:declaredName "Person" .
                }
            }
        """ ],
        [ sh:message "The testing organization holds an authorized representative (AccountExecutive) and a team of at least one domain expert and one evaluation operator." ;
            sh:select """
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this ?value WHERE {
                FILTER NOT EXISTS { $this sysml:owner ?parent }
                ?org a sysml:PartDefinition ; sysml:owner $this ; sysml:declaredName "TestingOrganization" .
                { BIND("AccountExecutive" AS ?value) } UNION { BIND("DomainExpert" AS ?value) } UNION { BIND("EvaluationOperator" AS ?value) }
                FILTER NOT EXISTS {
                    ?u a sysml:PartUsage ; sysml:type ?t ; sysml:owner ?holder . ?t sysml:declaredName ?value .
                    FILTER(?holder = ?org || EXISTS { ?tu a sysml:PartUsage ; sysml:owner ?org ; sysml:type ?holder })
                }
            }
        """ ] ;
    sh:targetClass sysml:Package .

ogc:S0-Mission a sh:NodeShape ;
    sh:property [ sh:class epo:Population ;
            sh:message "The mission names the affected populations it holds obligations towards (R-37)." ;
            sh:minCount 1 ;
            sh:path epo:regards ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path prov:generatedAtTime ] ;
    sh:sparql [ sh:message "S0: the mission is the sponsor organization's, the need is stated under it, and it is an item of the need step (the step is derived through the model graph, sheet 10-33)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                { FILTER NOT EXISTS { $this prov:wasAttributedTo ?o . ?o epo:role epo:sponsorRole } }
                UNION { FILTER NOT EXISTS { ?n a epo:Need ; epo:underMission $this } }
                UNION { FILTER NOT EXISTS { $this a ?cls . ?kind ogm:realizes ?cls . ?p sysml:type ?kind ; sysml:direction "out" ; sysml:owner ?act . ?act ogm:realizes epo:need } }
            }
        """ ] ;
    sh:targetClass epo:Mission .

ogc:S0-Need a sh:NodeShape ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path prov:generatedAtTime ] ;
    sh:sparql [ sh:message "S0: the need is stated by the sponsor organization, and is an item of the need step (the step is derived through the model graph, sheet 10-33)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                { FILTER NOT EXISTS { $this prov:wasAttributedTo ?o . ?o epo:role epo:sponsorRole } }
                UNION { FILTER NOT EXISTS { $this a ?cls . ?kind ogm:realizes ?cls . ?p sysml:type ?kind ; sysml:direction "out" ; sysml:owner ?act . ?act ogm:realizes epo:need } }
            }
        """ ] ;
    sh:targetClass epo:Need .

ogc:S0-Proposal a sh:NodeShape ;
    sh:property [ sh:class epo:Need ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path epo:respondsTo ] ;
    sh:sparql [ sh:message "S0: the proposal is the authorized representative's answer to the need, follows it, and is an item of the propose step (the step is derived through the model graph, sheet 10-33)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                { FILTER NOT EXISTS { $this prov:wasAttributedTo ?p . ?p epo:role epo:accountExecutiveRole } }
                UNION { $this epo:respondsTo ?n ; prov:generatedAtTime ?t1 . ?n prov:generatedAtTime ?t0 . FILTER(?t1 <= ?t0) }
                UNION { FILTER NOT EXISTS { $this a ?cls . ?kind ogm:realizes ?cls . ?p sysml:type ?kind ; sysml:direction "out" ; sysml:owner ?act . ?act ogm:realizes epo:propose } }
            }
        """ ] ;
    sh:targetClass epo:Proposal .

ogc:S3-PlanApproval a sh:NodeShape ;
    sh:property [ sh:class epo:TestPlan ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path epo:approves ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path prov:endedAtTime ] ;
    sh:sparql [ sh:message "S3: a test plan is approved by a domain expert (R-21)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this WHERE { FILTER NOT EXISTS { $this earl:assertedBy ?p . ?p epo:role epo:domainExpertRole } }
        """ ],
        [ sh:message "S3 order (sheet 10-19): the plan is approved before any session whose turns use the plan's probes starts." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this ?value WHERE {
                $this epo:approves ?plan ; prov:endedAtTime ?t1 .
                ?plan epo:means/(^prov:wasDerivedFrom)? ?probe . ?probe a epo:Probe .
                ?turn a epo:Turn ; prov:used ?probe ; epo:inSession ?value . ?value prov:startedAtTime ?t0 .
                FILTER(?t0 < ?t1)
            }
        """ ] ;
    sh:targetClass epo:PlanApproval .

ogc:S3-Strategy a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "A strategy states its policy: how the next probe is chosen from the trajectory so far (R-13)." ;
            sh:minCount 1 ;
            sh:path epo:policy ],
        [ sh:class epo:DsoRelease ;
            sh:message "A strategy is grounded in a DSO release." ;
            sh:minCount 1 ;
            sh:path epo:groundedIn ],
        [ sh:class prov:Person ;
            sh:minCount 1 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass epo:Strategy .

ogc:S4-TestSuite a sh:NodeShape ;
    sh:property [ sh:class prov:Person ;
            sh:minCount 1 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:sparql [ sh:message "S4: a test suite groups at least one session." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            SELECT $this WHERE { FILTER NOT EXISTS { ?s a epo:Session ; epo:inSuite $this } }
        """ ] ;
    sh:targetClass epo:TestSuite .

ogc:S4-Turn a sh:NodeShape ;
    sh:property [ sh:class epo:Session ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path epo:inSession ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path epo:turnIndex ],
        [ sh:class epo:Probe ;
            sh:maxCount 1 ;
            sh:message "A turn applies exactly one probe." ;
            sh:minCount 1 ;
            sh:path prov:used ] ;
    sh:targetClass epo:Turn .

ogc:S5-Response a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path epo:text ],
        [ sh:class prov:SoftwareAgent ;
            sh:minCount 1 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class epo:Turn ;
            sh:maxCount 1 ;
            sh:message "A response is generated by exactly one turn; a response from nowhere is not a record." ;
            sh:minCount 1 ;
            sh:path prov:wasGeneratedBy ] ;
    sh:targetClass epo:Response .

ogc:S8-Delivery a sh:NodeShape ;
    sh:property [ sh:class prov:Organization ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path epo:deliveredTo ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path prov:generatedAtTime ],
        [ sh:class epo:ServiceAgreement ;
            sh:maxCount 1 ;
            sh:message "The delivery is made under the service agreement (sheet 10-05)." ;
            sh:minCount 1 ;
            sh:path epo:underAgreement ] ;
    sh:sparql [ sh:message "S8: the delivery is an item of the deliver step (the step is derived through the model graph, sheet 10-33)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE { FILTER NOT EXISTS { $this a ?cls . ?kind ogm:realizes ?cls . ?p sysml:type ?kind ; sysml:direction "out" ; sysml:owner ?act . ?act ogm:realizes epo:deliver } }
        """ ],
        [ sh:message "S8: a delivery is made by the authorized representative to the sponsor and carries a final report (the record's delivered export, sheets 10-02, 10-41), its approval by a domain expert, and the recommendation (walkthrough, R-49)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                { FILTER NOT EXISTS { $this prov:wasAttributedTo ?p . ?p epo:role epo:accountExecutiveRole } }
                UNION { FILTER NOT EXISTS { $this epo:deliveredTo ?o . ?o epo:role epo:sponsorRole } }
                UNION { FILTER NOT EXISTS { $this prov:wasDerivedFrom ?r . ?r a epo:Report ; epo:draft false } }
                UNION { FILTER NOT EXISTS { $this prov:wasDerivedFrom ?c . ?c a epo:Recommendation } }
                UNION { FILTER NOT EXISTS { $this prov:wasDerivedFrom ?a . ?a a epo:ReportApproval } }
            }
        """ ],
        [ sh:message "S8 order (sheet 10-19): the delivery is made no earlier than the report approval it carries ended." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            SELECT $this ?value WHERE {
                $this prov:generatedAtTime ?t1 ; prov:wasDerivedFrom ?value . ?value a epo:ReportApproval ; prov:endedAtTime ?t0 .
                FILTER(?t0 > ?t1)
            }
        """ ] ;
    sh:targetClass epo:Delivery .

ogc:S9-Acceptance a sh:NodeShape ;
    sh:property [ sh:class epo:Delivery ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path epo:accepts ],
        [ sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path prov:generatedAtTime ] ;
    sh:sparql [ sh:message "S9: the acceptance is the sponsor's signatory's act on behalf of the sponsor, follows the delivery it accepts, and is an item of the accept step (the step is derived through the model graph, sheet 10-33)." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX ogm: <https://w3id.org/og-caie/model#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX sysml: <https://www.omg.org/spec/SysML#>
            SELECT $this WHERE {
                { FILTER NOT EXISTS { $this prov:wasAttributedTo ?p . ?p a prov:Person ; epo:role epo:sponsorSignatoryRole ; prov:actedOnBehalfOf ?o . ?o epo:role epo:sponsorRole } }
                UNION { $this epo:accepts ?d ; prov:generatedAtTime ?t1 . ?d prov:generatedAtTime ?t0 . FILTER(?t1 <= ?t0) }
                UNION { FILTER NOT EXISTS { $this a ?cls . ?kind ogm:realizes ?cls . ?p sysml:type ?kind ; sysml:direction "out" ; sysml:owner ?act . ?act ogm:realizes epo:acceptDelivery } }
            }
        """ ],
        [ sh:message "S9 (sheet 10-03): acceptance recognizes completion of the contract's obligations; a correctly constructed record is necessary and not sufficient for it. The accepted delivery carries a final report that used a passed verdict on the record, and that report's approval." ;
            sh:select """
            PREFIX epo: <https://w3id.org/og-caie/epo#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this epo:accepts ?d .
                FILTER NOT EXISTS {
                    ?d prov:wasDerivedFrom ?r . ?r a epo:Report ; epo:draft false ; prov:used ?v . ?v a epo:ConformanceVerdict ; earl:result ?res . ?res earl:outcome earl:passed .
                    ?d prov:wasDerivedFrom ?ap . ?ap a epo:ReportApproval ; epo:approvesReport ?r .
                }
            }
        """ ] ;
    sh:targetClass epo:Acceptance .

epo:ConsistencyCheck a owl:Class ;
    rdfs:label "automatic consistency check of a probe" ;
    rdfs:subClassOf earl:Assertion,
        prov:Activity ;
    ogc:term term:conformance .

epo:DomainExpertRole a owl:Class ;
    rdfs:label "domain expert: expert in the Domain-Specific Ontology (an alternative label of technical expert, R-10)" ;
    rdfs:subClassOf epo:TechnicalExpertRole ;
    owl:disjointWith epo:AuthorizedRepresentativeRole,
        epo:EvaluationOperatorRole ;
    ogc:term term:technical-expert .

epo:EvaluationCustomerRole a owl:Class ;
    rdfs:label "evaluation customer (the sponsor): receives the evaluation as a service, signs the agreement, decides the statement of work, accepts the delivery" ;
    rdfs:subClassOf epo:CustomerRole ;
    ogc:term term:evaluation-customer .

epo:EvaluationServiceProviderRole a owl:Class ;
    rdfs:label "evaluation service provider (the testing organization): provides the evaluation as a service; ISO/IEC 17000 third party when independent of the test item provider and without a user interest" ;
    rdfs:subClassOf epo:ProviderRole ;
    ogc:term term:evaluation-service-provider .

epo:ProbeDerivation a owl:Class ;
    rdfs:label "probe derivation" ;
    rdfs:comment "no term: the machine activity that derives probes from the DSO release and the requirement set (term probe names its output)" ;
    rdfs:subClassOf prov:Activity .

epo:SponsorSignatoryRole a owl:Class ;
    rdfs:label "sponsor signatory: a named person acting on behalf of the sponsor organization, who signs the agreement, declares the sponsor's user interest, approves the requirement set and accepts the delivery (sheet 10-06, R-50)" ;
    rdfs:comment "no term: the sponsor's counterpart of the authorized representative, the acquirer's side of SEVOCAB's acceptance; neither a party role (held by an organization) nor an actor category (within the testing organization), so a sibling of both" ;
    rdfs:subClassOf epo:Role .

epo:TestItemCustomerRole a owl:Class ;
    rdfs:label "test item customer: receives the AI system under test as a product or a service; the sponsor may be one, and an affected population is one when it uses the system" ;
    rdfs:comment "not disjoint with epo:EvaluationCustomerRole on purpose: the sponsor may also be the customer of the AI system it commissions the evaluation of (Z, sheet 08)" ;
    rdfs:subClassOf epo:CustomerRole ;
    ogc:term term:test-item-customer .

epo:TestItemProviderRole a owl:Class ;
    rdfs:label "test item provider (the accountable organization): provides, and is accountable for, the AI system under test; ISO/IEC 17000 first party; grants access to the test item (C4)" ;
    rdfs:subClassOf epo:ProviderRole ;
    ogc:term term:test-item-provider .

epo:acceptDelivery a epo:ContractingStep ;
    rdfs:label "C6 accept: the sponsor accepts the delivery as performance of the agreement" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "acceptance, p. 4 (ISO/IEC/IEEE 24748-5:2017, 3.1)" ;
            ogc:pdfPage 4 ;
            ogc:quote "action by an authorized representative of the acquirer by which the acquirer assumes ownership of products as partial or complete performance of an agreement" ;
            ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-09): ISO/IEC 17000 9.6 acceptance is the recognition of a result between bodies, not the sponsor accepting performance; it left this step." ;
    ogc:seeAlso [ ogc:cites src:sebok-2-14 ;
            ogc:locator "Acceptance Criteria (glossary), p. 1437 (INCOSE 2011, Section 6.1.15)" ;
            ogc:pdfPage 1437 ;
            ogc:quote "The procurement specification, in the context of the overall agreement, should clearly state the criteria by which the acquirer will accept delivery from the supplier." ;
            ogc:quoteStatus "machine" ] .

epo:access a epo:ContractingStep ;
    rdfs:label "C4 access: the test item provider (the accountable organization) provides the test item and the test environment" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "test environment and data management process, p. 434 (ISO/IEC/IEEE 29119-2:2021, 3.37)" ;
            ogc:pdfPage 434 ;
            ogc:quote "test process for establishing and maintaining a required test environment and corresponding test data" ;
            ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-09) and R-48 (sheet 07-06): the accountable organization, the party that provides the test item, must provide access to it; the step is its duty, and the 29119-2 process names what that access establishes. The environment itself is a thing and stays a neighbour; ISO/IEC 17000 4.10 access is the applicant's side of the same fact." ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "test environment, p. 434 (ISO/IEC/IEEE 29119-2:2021, 3.34)" ;
            ogc:pdfPage 434 ;
            ogc:quote "environment containing facilities, hardware, software, firmware, and procedures needed to conduct a test" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:sevocab ;
            ogc:locator "test item transmittal report, p. 435 (ISO/IEC/IEEE 24765:2017)" ;
            ogc:pdfPage 435 ;
            ogc:quote "document identifying test items" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.2 object of conformity assessment" ;
            ogc:quote "entity to which specified requirements apply" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.10 access" ;
            ogc:quote "opportunity for an applicant to obtain a conformity assessment service from a body under a conformity assessment scheme" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

epo:accessFrom a owl:DatatypeProperty ;
    rdfs:comment "the start of the access period (sheet 10-04); required by S0-Access" ;
    rdfs:domain epo:TestItemAccess ;
    rdfs:range xsd:dateTime .

epo:accessUntil a owl:DatatypeProperty ;
    rdfs:comment "the end of the access period (sheet 10-04); required by S0-Access" ;
    rdfs:domain epo:TestItemAccess ;
    rdfs:range xsd:dateTime .

epo:accountExecutiveRole a epo:AuthorizedRepresentativeRole ;
    rdfs:label "authorized representative (formerly account executive): signs the agreement for the testing organization, declares its independence, and delivers the report; the organization's interface with its contractual counterparties, not responsible for the determinations in the report" .

epo:accountableOrganizationRole a epo:TestItemProviderRole ;
    rdfs:label "test item provider (accountable organization, ISO/IEC 17000 first party): provides the test item and access to it" .

epo:agree a epo:ContractingStep ;
    rdfs:label "C3 agree: the service agreement fixes the counterparties, the test item, the requirements' frame and the method" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ;
            ogc:locator "Acquisition and Supply, p. 353 (INCOSE 2012, the acquisition process)" ;
            ogc:pdfPage 353 ;
            ogc:quote "The acquisition process includes activities to identify, select, and reach commercial agreements with a product or service supplier." ;
            ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-38.png" ;
            ogc:locator "3.3.13" ;
            ogc:quote "binding agreement" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.9 conformity assessment scheme" ;
            ogc:quote "set of rules and procedures that describes the objects of conformity assessment, identifies the specified requirements and provides the methodology for performing conformity assessment" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

epo:appropriateness a owl:ObjectProperty ;
    rdfs:comment "on an attestation (the declared context) or an appropriateness assessment (the requirement set)" ;
    rdfs:range epo:AppropriatenessValue .

epo:approvedBy a owl:ObjectProperty ;
    rdfs:domain epo:DsoRelease ;
    rdfs:range prov:Person ;
    rdfs:subPropertyOf prov:wasAttributedTo .

epo:approves a owl:ObjectProperty ;
    rdfs:domain epo:PlanApproval ;
    rdfs:range epo:TestPlan .

epo:approvesReport a owl:ObjectProperty ;
    rdfs:domain epo:ReportApproval ;
    rdfs:range epo:Report .

epo:bearsOn a owl:ObjectProperty ;
    rdfs:comment "the criterion whose expected result this evidence item bears on (R-18, R-20)" ;
    rdfs:domain epo:Evidence ;
    rdfs:range epo:AcceptanceCriterion .

epo:cantTellRate a owl:DatatypeProperty ;
    rdfs:domain epo:Report ;
    rdfs:range xsd:decimal .

epo:concerns a owl:ObjectProperty ;
    rdfs:comment "the criterion left unplanned, or the plan objective left without an attestation (sheet 10-16)" ;
    rdfs:domain epo:PlanDeviation ;
    rdfs:range epo:AcceptanceCriterion .

epo:coverage a owl:DatatypeProperty ;
    rdfs:domain epo:Report ;
    rdfs:range xsd:decimal .

epo:declareRequirements a epo:EpoStep ;
    rdfs:label "2 declare the requirement set (operational envelope): requirements, acceptance criteria, weights; the domain expert assesses its appropriateness" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ;
            ogc:locator "System Requirements Definition, Process for Generating System Requirements, p. 558" ;
            ogc:pdfPage 558 ;
            ogc:quote "The System Requirement Definition activities begin with the transformation of the integrated set of needs into a set of requirements for the SoI. These requirements must be appropriate to the level that the SoI exists within the system architecture and communicate \"what\" the SoI must do to meet the needs, avoiding requirements that state implementation of \"how\" to achieve the design realization of the physical SoI." ;
            ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-09): the requirement set is what the test item must do, never how; SEBoK's own first activity of System Requirements Definition, the needs of step 1 transformed into requirements with measurable criteria." ;
    ogc:seeAlso [ ogc:cites src:sebok-2-14 ;
            ogc:locator "System Requirements Definition, p. 559" ;
            ogc:pdfPage 559 ;
            ogc:quote "A detailed analysis of a single need statement may result in multiple requirements expressing what the system must do to meet it, including definition of measurable performance criteria (INCOSE NRM 2022)." ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:sevocab ;
            ogc:locator "system requirements specification (SyRS), p. 422 (ISO/IEC/IEEE 29148:2018, 4.1.29)" ;
            ogc:pdfPage 422 ;
            ogc:quote "structured collection of the requirements (functions, performance, design constraints, and attributes) of the system and its operational environments and external interfaces" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "5.1 specified requirement" ;
            ogc:quote "need or expectation that is stated" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

epo:deliver a epo:ContractingStep ;
    rdfs:label "C5 deliver: the authorized representative delivers the report and the recommendation to the sponsor" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "test completion report, p. 433 (ISO/IEC/IEEE 29119-2:2021, 3.26)" ;
            ogc:pdfPage 433 ;
            ogc:quote "report that provides a summary of the testing that was performed" ;
            ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "delivery, p. 120 (ISO/IEC/IEEE 24765:2017)" ;
            ogc:pdfPage 120 ;
            ogc:quote "release of a system or component to its customer or intended user" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "7.3 attestation, Note 1 (fragment of the note)" ;
            ogc:quote "is intended to convey the assurance that the specified requirements have been fulfilled" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

epo:deliveredTo a owl:ObjectProperty ;
    rdfs:domain epo:Delivery ;
    rdfs:range prov:Organization .

epo:department a epo:IndependenceLevel ;
    rdfs:label "independence at the department level: the determiner and the operator, and the assessor and the author, act on behalf of different units" .

epo:derivedFromDso a owl:ObjectProperty ;
    rdfs:domain epo:Probe ;
    rdfs:range epo:DsoRelease ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

epo:determineAndAttest a epo:EpoStep ;
    rdfs:label "5 determine and attest: determinations on evidence; attestations by the domain expert" ;
    ogc:canonical [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "7.2 decision" ;
            ogc:quote "conclusion, based on the results of review, that fulfilment of specified requirements has or has not been demonstrated" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "7.3 attestation" ;
            ogc:quote "issue of a statement, based on a decision, that fulfilment of specified requirements has been demonstrated" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "7.1 review" ;
            ogc:quote "consideration of the suitability, adequacy and effectiveness of selection and determination activities, and the results of these activities, with regard to fulfilment of specified requirements by an object of conformity assessment" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:sevocab ;
            ogc:locator "evaluation, p. 155 (ISO/IEC 25001:2014, 4.1)" ;
            ogc:pdfPage 155 ;
            ogc:quote "systematic determination of the extent to which an entity meets its specified criteria" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "Annex A, A.4 Review, decision and attestation (the functional approach)" ] .

epo:deviatesFrom a owl:ObjectProperty ;
    rdfs:comment "the test plan the deviation departs from (sheet 10-16)" ;
    rdfs:domain epo:PlanDeviation ;
    rdfs:range epo:TestPlan .

epo:domainExpertRole a epo:DomainExpertRole ;
    rdfs:label "domain expert: DSO, appropriateness, plan approval, determinations, attestations; represents populations not interviewed" .

epo:draft a owl:DatatypeProperty ;
    rdfs:comment "true for a draft report, which may carry gaps in traceability or coverage flagged in epo:gaps; false for a final report, which rests on a passed conformance verdict on the record (sheet 10-41, R-50)" ;
    rdfs:domain epo:Report ;
    rdfs:range xsd:boolean .

epo:environment a owl:DatatypeProperty ;
    rdfs:comment "the operational environment (SEVOCAB), stated: on the requirement set the environment the envelope binds, on the access grant the test environment provided (sheet 10-04); no domain, since both carry it" ;
    rdfs:range xsd:string .

epo:evaluationOperatorRole a epo:EvaluationOperatorRole ;
    rdfs:label "evaluation operator: requirement set, plan, sessions, evidence, determinations, recommendation" .

epo:execute a epo:EpoStep ;
    rdfs:label "4 execute: sessions of turns against the test item; responses; evidence collected under the plan" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "test execution process, p. 435 (ISO/IEC/IEEE 29119-2:2021, 3.40)" ;
            ogc:pdfPage 435 ;
            ogc:quote "dynamic test process for executing test procedures created in the test design and implementation process in the prepared test environment and recording the results" ;
            ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "6.2 testing" ;
            ogc:quote "determination of one or more characteristics of an object of conformity assessment, according to a procedure" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "Annex A, A.3 Determination (the functional approach)" ] .

epo:exercises a owl:ObjectProperty ;
    rdfs:domain epo:Probe ;
    rdfs:range epo:AcceptanceCriterion .

epo:expectedResult a owl:DatatypeProperty ;
    rdfs:comment "SEVOCAB expected results: the observable predicted behavior that would show the criterion met (ruling R-12)" ;
    rdfs:domain epo:AcceptanceCriterion ;
    rdfs:range xsd:string .

epo:failRate a owl:DatatypeProperty ;
    rdfs:domain epo:Report ;
    rdfs:range xsd:decimal .

epo:grantsAccessTo a owl:ObjectProperty ;
    rdfs:domain epo:TestItemAccess ;
    rdfs:range earl:TestSubject .

epo:groundedIn a owl:ObjectProperty ;
    rdfs:domain epo:Strategy ;
    rdfs:range epo:DsoRelease .

epo:inSession a owl:ObjectProperty ;
    rdfs:domain epo:Turn ;
    rdfs:range epo:Session .

epo:inappropriate a epo:AppropriatenessValue .

epo:independenceLevel a owl:ObjectProperty ;
    rdfs:comment "on the record: the level at which independence is required and checked (sheet 10-15)" ;
    rdfs:domain prov:Bundle ;
    rdfs:range epo:IndependenceLevel .

epo:indirectly a epo:Affectedness ;
    rdfs:label "affected indirectly: through other stakeholders' use of the AI system under test" .

epo:insufficient a epo:SufficiencyValue .

epo:interview a epo:Engagement ;
    rdfs:label "interviewed: its stakeholder needs documented as input" .

epo:means a owl:ObjectProperty ;
    rdfs:comment "SEVOCAB test plan: the means for achieving them; a Probe or a Strategy (R-13)" ;
    rdfs:domain epo:TestPlan .

epo:need a epo:ContractingStep ;
    rdfs:label "C1 need: the sponsor states its mission and obligations towards the affected populations, the problem, and what success would look like" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ;
            ogc:locator "Business or Mission Analysis, p. 543" ;
            ogc:pdfPage 543 ;
            ogc:quote "The purpose of Business or Mission Analysis is to understand a mission or market problem, threat, or opportunity, and to establish the goals, objectives and measures of success of a potential solution class." ;
            ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-11.png" ;
            ogc:locator "3.5.1 requirement" ;
            ogc:quote "need or expectation that is stated, generally implied or obligatory" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

epo:objective a owl:ObjectProperty ;
    rdfs:comment "SEVOCAB test plan: the test objectives to be achieved" ;
    rdfs:domain epo:TestPlan ;
    rdfs:range epo:AcceptanceCriterion .

epo:ontologyDigest a owl:DatatypeProperty ;
    rdfs:comment "sha256 of vocabulary/epo.ttl as the checker ran it (sheet 10-18)" ;
    rdfs:range xsd:string .

epo:organization a epo:IndependenceLevel ;
    rdfs:label "independence at the organization level: the determiner and the operator, and the assessor and the author, act on behalf of different organizations" .

epo:partOf a owl:ObjectProperty ;
    rdfs:domain epo:Requirement ;
    rdfs:range epo:RequirementSet .

epo:passRate a owl:DatatypeProperty ;
    rdfs:domain epo:Report ;
    rdfs:range xsd:decimal .

epo:plan a epo:EpoStep ;
    rdfs:label "3 plan: the test plan, its probes or strategy, consistency-checked and approved" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "test strategy and planning process, p. 439 (ISO/IEC/IEEE 29119-2:2021, 3.51)" ;
            ogc:pdfPage 439 ;
            ogc:quote "test management process used to design the test strategy, complete test planning, and create and maintain test plans" ;
            ogc:quoteStatus "machine" ] ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "test design and implementation process, p. 433 (ISO/IEC/IEEE 29119-2:2021, 3.32)" ;
            ogc:pdfPage 433 ;
            ogc:quote "test process for deriving and specifying test cases and test procedures" ;
            ogc:quoteStatus "machine" ] .

epo:policy a owl:DatatypeProperty ;
    rdfs:comment "the rule that maps the trajectory so far to the next probe; may name a person's exploratory testing" ;
    rdfs:domain epo:Strategy ;
    rdfs:range xsd:string .

epo:propose a epo:ContractingStep ;
    rdfs:label "C2 propose: the sponsor seeks the service and the testing organization responds" ;
    ogc:canonical [ ogc:cites src:sebok-2-14 ;
            ogc:locator "Enterprise Systems Engineering, contract products and services, p. 935" ;
            ogc:pdfPage 935 ;
            ogc:quote "Contract products and services often demand tailor-made system/service solutions which are typically specified by a single customer to whom the solution is provided. The supplier responds with proposed solutions." ;
            ogc:quoteStatus "machine" ] ;
    ogc:scopeNote "Ruling R-47 (sheet 06-09): the customer specifies, the supplier responds with a proposal; the supplier's definition (SEBoK p. 352) backs the testing organization's role, not this step." ;
    ogc:seeAlso [ ogc:cites src:sevocab ;
            ogc:locator "proposal, p. 329 (ISO/IEC/IEEE 24765:2014, SEVOCAB tag 24765c)" ;
            ogc:pdfPage 329 ;
            ogc:quote "supplier's offer to provide a system or service, usually including benefits, costs, risks, opportunities, and other factors applicable to decisions" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:sevocab ;
            ogc:locator "request for proposal (RFP), p. 350 (ISO/IEC/IEEE 24765:2017)" ;
            ogc:pdfPage 350 ;
            ogc:quote "document used by the acquirer as the means to announce its intention to potential bidders to acquire a specified system, software product, or software service" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "4.10 access" ;
            ogc:quote "opportunity for an applicant to obtain a conformity assessment service from a body under a conformity assessment scheme" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

epo:queryDigest a owl:DatatypeProperty ;
    rdfs:comment "sha256 of queries/coverage.rq as the assembler ran it (sheet 10-18)" ;
    rdfs:range xsd:string .

epo:reason a owl:DatatypeProperty ;
    rdfs:comment "why: the reason for an exclusion or a plan deviation (sheets 10-11, 10-14, 10-16)" ;
    rdfs:range xsd:string .

epo:regards a owl:ObjectProperty ;
    rdfs:comment "the affected populations the mission holds obligations towards (R-37)" ;
    rdfs:domain epo:Mission ;
    rdfs:range epo:Population .

epo:report a epo:EpoStep ;
