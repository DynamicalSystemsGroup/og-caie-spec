    rdfs:label "SCI-02 EnvelopeDeclaredBeforeSessions" ;
    rdfs:comment "The service agreement, the operational environment, the test item and the requirement set are declared, in that order, before any session runs: this system in this environment under this contract." ;
    ogc:checkedBy ogc:S0-Access,
        ogc:S0-Parties,
        ogc:S2-RequirementSet ;
    ogc:page "evaluation" ;
    ogc:restsOn rul:R-02,
