    ogc:page "evaluation" ;
    ogc:restsOn rul:R-09,
        src:iso-9000-2026 ;
    ogc:tag "machine" ;
    ogc:usesTerm term:domain-specific-ontology,
        term:probe,
        term:technical-expert .

