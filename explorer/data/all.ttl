tr:SCI-11 a ogc:Trace ;
    rdfs:label "SCI-11 EndStateGuaranteed" ;
    rdfs:comment "The wiring guarantees the end state, checked locally over kinds of parts and ports: every wire runs from an output port on a part to an input port on a part carrying one item kind; at every part every input is present once and every output goes somewhere; every item kind reaches the recorder; the seven contracting steps (C1 to C6 with fulfil between access and delivery) and the six evaluation steps form process DAGs that produce every item kind; a conformant record then yields traceability in both directions and coverage, and answers why." ;
    ogc:checkedBy ogc:M2-Part,
        ogc:M2-Wire,
        ogc:M3-RecordHub,
        ogc:M4-EveryItemProduced,
        ogc:M4-Nesting,
        ogc:M4-ProcessDag,
        ogc:M4-Steps ;
    ogc:page "guarantees" ;
    ogc:restsOn rul:R-17,
        rul:R-21,
        rul:R-22,
        rul:R-25,
        rul:R-26,
        src:w3c-shacl ;
    ogc:tag "machine" ;
    ogc:usesTerm term:evaluation-process-ontology,
        term:evaluation-record,
        term:evaluation-team,
        term:requirements-traceability,
        term:test-coverage .

tr:SCI-12 a ogc:Trace ;
    rdfs:label "SCI-12 RolesDistinct" ;
    rdfs:comment "The domain expert who approves the DSO, assesses appropriateness and attests is not the evaluation operator who administers tests and collects evidence, and neither is the authorized representative who signs the agreement; one authorized representative, one or more of each expert." ;
    ogc:checkedBy ogc:M5-Cardinality,
        ogc:M5-PortsBelongToRoles,
        ogc:M5-Roles,
        ogc:S1-DsoRelease,
        ogc:S4-Session,
        ogc:S6-Attestation,
        ogc:S6-Determination ;
    ogc:page "contracting" ;
    ogc:restsOn rul:R-10,
        rul:R-23,
        src:iso-9000-2026,
        src:sevocab ;
    ogc:tag "machine" ;
    ogc:usesTerm term:account-executive,
        term:evaluation-operator,
        term:evaluation-team,
        term:technical-expert .

tr:SCI-13 a ogc:Trace ;
    rdfs:label "SCI-13 TwoLayersOfAssumptions" ;
    rdfs:comment "What the contract pins (the counterparties, the test item, the requirements' frame, the method) is recorded and closed before what the evaluation pins (the environment, the requirement set, the DSO release, the plan) is declared; the evaluation documents the first layer and cannot change it." ;
    ogc:checkedBy ogc:M4-Nesting,
        ogc:S0-Layers ;
    ogc:page "contracting" ;
    ogc:restsOn rul:R-32,
        rul:R-33,
        src:iso-iec-17000-2020,
        src:scipy-2026-bof,
        src:sebok-2-14 ;
    ogc:tag "machine" ;
    ogc:usesTerm term:contract,
        term:domain-specific-ontology,
        term:evaluation-process-ontology,
        term:operational-envelope,
        term:operational-environment .

elmt:OGCAIE__AcceptanceCriterion___400 a sysml:Documentation ;
    sysml:body """ Derived from a requirement; states its expected result
           (SEVOCAB) and its weight, the deployment sensitivity (R-05,
           which specializes risk-based testing). The coverage item (R-01). """ ;
    sysml:owner elmt:OGCAIE__AcceptanceCriterion ;
    sysml:qualifiedName "OGCAIE::AcceptanceCriterion::@0" .

elmt:OGCAIE__AcceptanceCriterion__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__AcceptanceCriterion ;
    sysml:qualifiedName "OGCAIE::AcceptanceCriterion::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__AcceptanceSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__AcceptanceSeam ;
    sysml:qualifiedName "OGCAIE::AcceptanceSeam::consumer" ;
    sysml:type elmt:OGCAIE__AcceptanceWrite .

elmt:OGCAIE__AcceptanceSeam__supplier a sysml:PortUsage ;
