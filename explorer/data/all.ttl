    sysml:qualifiedName "OGCAIE::ConformanceVerdictSeam::consumer" ;
    sysml:type elmt:OGCAIE__ConformanceVerdictWrite .

elmt:OGCAIE__ConformanceVerdictSeam__supplier a sysml:PortUsage ;
    sysml:declaredName "supplier" ;
    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__ConformanceVerdictSeam ;
    sysml:qualifiedName "OGCAIE::ConformanceVerdictSeam::supplier" ;
    sysml:type elmt:OGCAIE__ConformanceVerdictWrite .

elmt:OGCAIE__ConformanceVerdictWrite__i a sysml:ItemUsage ;
    sysml:declaredName "i" ;
    sysml:direction "out" ;
    sysml:owner elmt:OGCAIE__ConformanceVerdictWrite ;
    sysml:qualifiedName "OGCAIE::ConformanceVerdictWrite::i" ;
    sysml:type elmt:OGCAIE__ConformanceVerdict .

elmt:OGCAIE__ConformanceVerdict___400 a sysml:Documentation ;
    sysml:body """ The conformance checker's verdict on the record: correctly
           constructed to the shapes, traceable in both directions and
           covered (walkthrough, R-49; sheet 10-41, R-50). Conformance is a
           prerequisite for compiling the final report. Pinned within the
           evaluation. """ ;
    sysml:owner elmt:OGCAIE__ConformanceVerdict ;
    sysml:qualifiedName "OGCAIE::ConformanceVerdict::@0" .

elmt:OGCAIE__ConformanceVerdict__id a sysml:AttributeUsage ;
    sysml:declaredName "id" ;
    sysml:owner elmt:OGCAIE__ConformanceVerdict ;
    sysml:qualifiedName "OGCAIE::ConformanceVerdict::id" ;
    sysml:type "ScalarValues::String" .

elmt:OGCAIE__ContractingProcess___400 a sysml:Documentation ;
    sysml:body """ The contracting lifecycle: the ISO/IEC/IEEE 15288 agreement
           processes as SEBoK describes them, ISO/IEC 17000's access,
           scheme and acceptance, ISO 9000's contract (ruling R-32). One
           nested model (ruling R-33): the fulfil step is a black box typed
           by the EvaluationProcess, whose inputs are what the contract
           pinned and whose outputs are what the delivery carries; its
           definition below is the drill-down, and it conforms to that
           interface by typing. The flows say which item goes where. """ ;
    sysml:owner elmt:OGCAIE__ContractingProcess ;
    sysml:qualifiedName "OGCAIE::ContractingProcess::@0" .

