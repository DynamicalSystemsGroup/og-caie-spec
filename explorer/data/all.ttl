elmt:OGCAIE__EpoStep___400 a sysml:Documentation ;
    sysml:body """ The six steps of the Evaluation Process Ontology (ruling
           R-21 split the paper's five; R-32 moved agree out to the
           contracting lifecycle, ContractingStep). Every attestation and
           every recommendation names its step. """ ;
    sysml:owner elmt:OGCAIE__EpoStep ;
    sysml:qualifiedName "OGCAIE::EpoStep::@0" .

