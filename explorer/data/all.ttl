term:authoritative-reference a skos:Concept ;
    skos:altLabel "knowledge graph (as the reference for one evaluation)"@en,
        "source of truth"@en ;
    skos:broader term:knowledge-graph ;
    skos:closeMatch src:hogan-2021_section-1 ;
    skos:definition "The knowledge graph, populated with the facts of the situation and conforming to the Domain-Specific Ontology, against which responses are judged."@en ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "authoritative reference"@en ;
    skos:related term:domain-specific-ontology ;
    ogc:anchorRelation "corresponds" ;
    ogc:binding "an RDF data graph that conforms to the DSO release" ;
    ogc:canonical [ ogc:cites src:hogan-2021 ;
            ogc:locator "Section 1, p. 2 (arXiv v3) (fragment of the entry)" ;
            ogc:pdfPage 2 ;
            ogc:quote "a graph of data intended to accumulate and convey knowledge of the real world" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "refined" .

term:knowledge-graph a skos:Concept ;
    skos:definition "The body of domain facts, expressed in an ontology's vocabulary, that answers are judged against. It conforms to the ontology and may hold more context than the ontology alone."@en ;
    skos:exactMatch src:hogan-2021_section-1 ;
    skos:inScheme ogc:Glossary ;
    skos:narrower term:authoritative-reference ;
    skos:prefLabel "knowledge graph"@en ;
    skos:related term:ontology ;
    ogc:binding "an RDF data graph conforming to the DSO" ;
    ogc:canonical [ ogc:cites src:hogan-2021 ;
            ogc:locator "Section 1, p. 2 (arXiv v3)" ;
            ogc:pdfPage 2 ;
            ogc:quote "a graph of data intended to accumulate and convey knowledge of the real world, whose nodes represent entities of interest and whose edges represent relations between these entities" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" .

term:monitoring a skos:Concept ;
    skos:altLabel "re-evaluation"@en,
        "surveillance (ISO/IEC 17000 8.1)"@en ;
    skos:definition "Determining the status of a system at different stages or times. After an evaluation, a sponsor may require the test item provider to change the system per the findings and then require new testing to certify that the flagged issues were addressed; in conformity assessment that repeat is called surveillance. Observed in practice; not a step of the contracting lifecycle."@en ;
    skos:exactMatch src:iso-9000-2026_3.11.3 ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "monitoring"@en ;
    skos:related term:evaluation ;
    prov:wasDerivedFrom rul:R-36 ;
    ogc:binding "narration in docs/contracting.md; no node of the record" ;
    ogc:canonical [ ogc:cites src:iso-9000-2026 ;
            ogc:file "sources/local/iso-9000-2026/iso-9000-2026-obp-30.png" ;
            ogc:locator "3.11.3" ;
            ogc:quote "determining the status of a system, a process or an activity" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] ;
    ogc:class "adopted" ;
    ogc:scopeNote "Ruling R-36: the headword is ISO 9000's monitoring, the doctrine is ISO/IEC 17000's surveillance, kept as the alternative label with its clause so the concept stays mapped. Ruling R-35: narration in the Contracting chapter, outside the lifecycle." ;
    ogc:seeAlso [ ogc:cites src:iso-iec-17000-2020 ;
            ogc:locator "8.1 surveillance" ;
            ogc:quote "systematic iteration of conformity assessment activities as a basis for maintaining the validity of the statement of conformity" ;
            ogc:quoteStatus "human" ;
            ogc:verifiedBy rul:Z ;
            ogc:verifiedOn "2026-09-06"^^xsd:date ] .

term:reproducibility a skos:Concept ;
    skos:definition "How closely results agree when the measurement is repeated under changed conditions: different operators, different sessions, a different evaluation team. Two evaluations that share a requirement set and a DSO release are comparable to the extent their results reproduce."@en ;
    skos:exactMatch src:jcgm-200-2012_2.25 ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "reproducibility"@en ;
    skos:related term:repeatability ;
    prov:wasDerivedFrom rul:R-13 ;
    ogc:binding "the record's fixed frame: requirement set, DSO release, test plan, session protocol" ;
    ogc:canonical [ ogc:cites src:jcgm-200-2012 ;
            ogc:locator "2.25 measurement reproducibility, p. 41" ;
            ogc:pdfPage 41 ;
            ogc:quote "measurement precision under reproducibility conditions of measurement" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" ;
    ogc:seeAlso [ ogc:cites src:jcgm-200-2012 ;
            ogc:locator "2.24 reproducibility condition of measurement, p. 40" ;
            ogc:pdfPage 40 ;
            ogc:quote "condition of measurement, out of a set of conditions that includes different locations, operators, measuring systems, and replicate measurements on the same or similar objects" ;
            ogc:quoteStatus "machine" ],
        [ ogc:cites src:nist-tn-1297 ;
            ogc:locator "Appendix D.1.1.3, p. 14" ;
            ogc:pdfPage 19 ;
            ogc:quote "closeness of the agreement between the results of measurements of the same measurand carried out under changed conditions of measurement" ;
            ogc:quoteStatus "machine" ] .

term:risk-based-testing a skos:Concept ;
    skos:definition "Testing in which what is tested, and how much, is chosen according to analyzed risk. Deployment sensitivity is the weight that makes coverage reflect consequence."@en ;
    skos:exactMatch src:sevocab_risk-based-testing ;
    skos:inScheme ogc:Glossary ;
    skos:prefLabel "risk-based testing"@en ;
    skos:related term:deployment-sensitivity,
        term:test-coverage ;
    ogc:binding "epo:weight on AcceptanceCriterion" ;
    ogc:canonical [ ogc:cites src:sevocab ;
            ogc:locator "risk-based testing, p. 362" ;
            ogc:pdfPage 362 ;
            ogc:quote "testing in which the management, selection, prioritization, and use of testing activities and resources are consciously based on corresponding types and levels of analyzed risk" ;
            ogc:quoteStatus "machine" ] ;
    ogc:class "adopted" .

