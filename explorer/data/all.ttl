    sysml:type "ScalarValues::String" .

elmt:OGCAIE__Appropriateness___400 a sysml:Documentation ;
    sysml:body """ Hawkins, Kelly, Knight and Graydon 2011, section 3.2: the
           asserted context is appropriate for the elements it applies
           to. Ruling R-08 replaces the earlier label. """ ;
    sysml:owner elmt:OGCAIE__Appropriateness ;
    sysml:qualifiedName "OGCAIE::Appropriateness::@0" .

