elmt:OGCAIE__ConformanceChecker___400 a sysml:Documentation ;
    sysml:body """ Machine verification, called conformance (ruling R-16): the
           record is correctly constructed to the EPO shapes, traceable in
           both directions and covered; its verdict on the record is
           recorded and read by the assembler (walkthrough, R-49; sheet
           10-41, R-50). One output, read by two (R-25). """ ;
    sysml:owner elmt:OGCAIE__ConformanceChecker ;
    sysml:qualifiedName "OGCAIE::ConformanceChecker::@0" .

elmt:OGCAIE__ConformanceVerdictSeam__consumer a sysml:PortUsage ;
    sysml:declaredName "consumer" ;
    sysml:isConjugated true ;
