tr:SCI-04 a ogc:Trace ;
    rdfs:label "SCI-04 PlanBeforeRuns" ;
    rdfs:comment "A test plan states its objectives and its means; every probe belongs to a plan, derives from the DSO release and passes a consistency check before any session." ;
