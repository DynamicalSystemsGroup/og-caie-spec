    sysml:isEnd true ;
    sysml:owner elmt:OGCAIE__AgreementSeam ;
    sysml:qualifiedName "OGCAIE::AgreementSeam::supplier" ;
    sysml:type elmt:OGCAIE__AgreementWrite .

elmt:OGCAIE__AgreementWrite__i a sysml:ItemUsage ;
