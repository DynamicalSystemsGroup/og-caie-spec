@prefix cx:   <https://w3id.org/og-caie/run/counterexample#> .
@prefix epo:  <https://w3id.org/og-caie/epo#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Counterexample for the S6 chain rule in a two-turn session driven by a
# strategy (R-13). Turn 1 runs probe-1 (exercises a); the strategy then
# chooses probe-2 (exercises b) from the trajectory so far, and turn 2 runs
# it. The attestation about b aggregates determination-1, the ruling made at
# turn 1 on evidence bearing on a, instead of a determination on evidence-2. Sessions are
# stateful: the response at turn 1 cannot bear on what probe-2 asked, and the
# evidence item says so by answering a, not b. Must fail on ogc:S6-Attestation
# and nothing else.

cx:person a prov:Agent, prov:Person .
cx:expert a prov:Agent, prov:Person .
cx:sut a prov:Agent, prov:SoftwareAgent, earl:TestSubject ; epo:version "v1" .
cx:checker a prov:Agent, prov:SoftwareAgent ; epo:version "0.27" .
cx:dso a epo:DsoRelease ; epo:version "r1" ; epo:approvedBy cx:expert ; prov:generatedAtTime "2026-08-01T00:00:00Z"^^xsd:dateTime .
cx:reqs a epo:RequirementSet ; epo:environment "stated" ; epo:systemUnderTest cx:sut ; prov:wasAttributedTo cx:person ; prov:generatedAtTime "2026-08-02T00:00:00Z"^^xsd:dateTime .
cx:R a epo:Requirement ; epo:partOf cx:reqs ; epo:text "r" .
cx:a a epo:AcceptanceCriterion ; prov:wasDerivedFrom cx:R ; epo:text "criterion a" ; epo:expectedResult "a shown" ; epo:weight 1 ; epo:minPassRate 0.9 .
cx:b a epo:AcceptanceCriterion ; prov:wasDerivedFrom cx:R ; epo:text "criterion b" ; epo:expectedResult "b shown" ; epo:weight 1 ; epo:minPassRate 0.9 .

cx:strategy a epo:Strategy ;
    epo:policy "escalate: after a response that names no precaution, ask about the setting the user named" ;
    epo:groundedIn cx:dso ; prov:wasAttributedTo cx:person .
cx:plan a epo:TestPlan ; epo:objective cx:a ; epo:objective cx:b ; epo:means cx:strategy ; prov:wasDerivedFrom cx:reqs ; prov:wasDerivedFrom cx:dso ;
    prov:wasAttributedTo cx:person ; prov:generatedAtTime "2026-08-03T00:00:00Z"^^xsd:dateTime .

cx:probe-1 a epo:Probe ; epo:exercises cx:a ; epo:derivedFromDso cx:dso ; prov:wasDerivedFrom cx:strategy ; prov:generatedAtTime "2026-08-03T00:00:00Z"^^xsd:dateTime .
cx:probe-2 a epo:Probe ; epo:exercises cx:b ; epo:derivedFromDso cx:dso ; prov:wasDerivedFrom cx:strategy ; prov:generatedAtTime "2026-08-10T00:01:00Z"^^xsd:dateTime .
cx:check-1 a epo:ConsistencyCheck ; earl:subject cx:probe-1 ; earl:mode earl:automatic ; earl:assertedBy cx:checker ; earl:result [ a earl:TestResult ; earl:outcome earl:passed ] .
cx:check-2 a epo:ConsistencyCheck ; earl:subject cx:probe-2 ; earl:mode earl:automatic ; earl:assertedBy cx:checker ; earl:result [ a earl:TestResult ; earl:outcome earl:passed ] .

cx:session a epo:Session ; prov:wasAssociatedWith cx:sut ; prov:wasAssociatedWith cx:person ; prov:startedAtTime "2026-08-10T00:00:00Z"^^xsd:dateTime .
cx:turn-1 a epo:Turn ; epo:inSession cx:session ; epo:turnIndex 1 ; prov:used cx:probe-1 .
cx:turn-2 a epo:Turn ; epo:inSession cx:session ; epo:turnIndex 2 ; prov:used cx:probe-2 .
cx:response-1 a epo:Response ; epo:text "response at turn 1" ; prov:wasGeneratedBy cx:turn-1 ; prov:wasAttributedTo cx:sut .
cx:response-2 a epo:Response ; epo:text "response at turn 2" ; prov:wasGeneratedBy cx:turn-2 ; prov:wasAttributedTo cx:sut .
cx:evidence-1 a epo:Evidence ; epo:bearsOn cx:a ; prov:wasDerivedFrom cx:response-1 ; epo:underPlan cx:plan ; prov:wasAttributedTo cx:person .
cx:evidence-2 a epo:Evidence ; epo:bearsOn cx:b ; prov:wasDerivedFrom cx:response-2 ; epo:underPlan cx:plan ; prov:wasAttributedTo cx:person .
cx:determination-1 a epo:Determination ; earl:test cx:a ; earl:subject cx:sut ; earl:mode earl:manual ; earl:assertedBy cx:expert ; prov:used cx:evidence-1 ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] .

cx:attestation a epo:Attestation ;
    earl:test cx:b ; earl:subject cx:sut ; earl:mode earl:manual ; earl:assertedBy cx:expert ;
    prov:used cx:determination-1 ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ;
    epo:appropriateness epo:appropriate ; epo:sufficiency epo:sufficient ;
    epo:step epo:runAndAttest ;
    prov:endedAtTime "2026-08-11T09:00:00Z"^^xsd:dateTime .
