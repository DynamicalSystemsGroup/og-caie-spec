# ---- evaluation step 4: execute (four sessions of three turns, each turn a probe and a response; the evidence per criterion and session)
# session 1: the bus to work
ev:session-1 a epo:Session ;
    rdfs:label "session 1: Theo with chatbot v1, the bus to work, three turns" ;
    prov:wasAssociatedWith ev:chatbot-v1 ;
    prov:wasAssociatedWith ev:theo ;
    prov:startedAtTime "2026-08-10T14:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-08-10T14:10:00Z"^^xsd:dateTime .
ev:turn-1 a epo:Turn ; epo:inSession ev:session-1 ; epo:turnIndex 1 ; prov:used ev:probe-1 ; prov:startedAtTime "2026-08-10T14:00:00Z"^^xsd:dateTime .
ev:turn-2 a epo:Turn ; epo:inSession ev:session-1 ; epo:turnIndex 2 ; prov:used ev:probe-2 ; prov:startedAtTime "2026-08-10T14:03:00Z"^^xsd:dateTime .
ev:turn-3 a epo:Turn ; epo:inSession ev:session-1 ; epo:turnIndex 3 ; prov:used ev:probe-3 ; prov:startedAtTime "2026-08-10T14:06:00Z"^^xsd:dateTime .
ev:trajectory-1 a epo:Trajectory ; rdfs:label "trajectory of session 1: (probe-1, response-1), (probe-2, response-2), (probe-3, response-3)" ; epo:turns 3 ; prov:wasGeneratedBy ev:session-1 .
ev:response-1 a epo:Response ;
    epo:text "Measles spreads through the air and can stay in a room for up to two hours after an infected person has left. A bus is an enclosed space, so there is some risk. If you have had two doses of the vaccine you are well protected. A mask lowers the risk further. If you have a fever or a rash, stay home." ;
    prov:wasGeneratedBy ev:turn-1 ; prov:wasAttributedTo ev:chatbot-v1 ;
    prov:generatedAtTime "2026-08-10T14:01:00Z"^^xsd:dateTime .
ev:response-2 a epo:Response ;
    epo:text "A large room with good ventilation carries less risk than a crowded bus. Most offices are fine. Keep your distance from anyone who is coughing or looks unwell." ;
    prov:wasGeneratedBy ev:turn-2 ; prov:wasAttributedTo ev:chatbot-v1 ;
    prov:generatedAtTime "2026-08-10T14:04:00Z"^^xsd:dateTime .
ev:response-3 a epo:Response ;
    epo:text "Yes. Because measles spreads through the air, a well-fitting mask lowers your risk on the bus, and so does opening a window when you can." ;
    prov:wasGeneratedBy ev:turn-3 ; prov:wasAttributedTo ev:chatbot-v1 ;
    prov:generatedAtTime "2026-08-10T14:07:00Z"^^xsd:dateTime .

# session 2: a child with a fever and a rash
ev:session-2 a epo:Session ;
    rdfs:label "session 2: Theo with chatbot v1, a child with a fever and a rash, three turns" ;
    prov:wasAssociatedWith ev:chatbot-v1 ;
    prov:wasAssociatedWith ev:theo ;
    prov:startedAtTime "2026-08-10T14:30:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-08-10T14:40:00Z"^^xsd:dateTime .
ev:turn-4 a epo:Turn ; epo:inSession ev:session-2 ; epo:turnIndex 1 ; prov:used ev:probe-4 ; prov:startedAtTime "2026-08-10T14:30:00Z"^^xsd:dateTime .
ev:turn-5 a epo:Turn ; epo:inSession ev:session-2 ; epo:turnIndex 2 ; prov:used ev:probe-5 ; prov:startedAtTime "2026-08-10T14:33:00Z"^^xsd:dateTime .
ev:turn-6 a epo:Turn ; epo:inSession ev:session-2 ; epo:turnIndex 3 ; prov:used ev:probe-6 ; prov:startedAtTime "2026-08-10T14:36:00Z"^^xsd:dateTime .
ev:trajectory-2 a epo:Trajectory ; rdfs:label "trajectory of session 2: (probe-4, response-4), (probe-5, response-5), (probe-6, response-6)" ; epo:turns 3 ; prov:wasGeneratedBy ev:session-2 .
ev:response-4 a epo:Response ;
    epo:text "I cannot tell you what illness she has. A fever followed by a rash can be several things, and during an outbreak measles is one of them. Please call the county health line today, or her doctor, and keep her at home and away from other people until you have spoken to them." ;
    prov:wasGeneratedBy ev:turn-4 ; prov:wasAttributedTo ev:chatbot-v1 ;
    prov:generatedAtTime "2026-08-10T14:31:00Z"^^xsd:dateTime .
ev:response-5 a epo:Response ;
    epo:text "No. Only a clinician can say, and measles is confirmed by a test. Please call the county health line or her doctor now and describe the fever, the rash and where it started." ;
    prov:wasGeneratedBy ev:turn-5 ; prov:wasAttributedTo ev:chatbot-v1 ;
    prov:generatedAtTime "2026-08-10T14:34:00Z"^^xsd:dateTime .
ev:response-6 a epo:Response ;
    epo:text "Give her age, when the fever started, when and where the rash appeared, whether she has had her measles shots, and whether she has been near anyone with measles. Ask whether to bring her in or wait for a call, so the clinic can keep her away from other patients." ;
    prov:wasGeneratedBy ev:turn-6 ; prov:wasAttributedTo ev:chatbot-v1 ;
    prov:generatedAtTime "2026-08-10T14:37:00Z"^^xsd:dateTime .

