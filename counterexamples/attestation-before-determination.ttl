    prov:generatedAtTime "2026-08-12T11:00:00Z"^^xsd:dateTime .

ev:acceptance-1 a epo:Acceptance ;
    rdfs:label "the county health officer accepts the delivery on behalf of the county public-health office" ;
    epo:accepts ev:delivery-1 ;
    prov:wasAttributedTo ev:dana-okafor ;
    prov:generatedAtTime "2026-08-14T09:00:00Z"^^xsd:dateTime .

