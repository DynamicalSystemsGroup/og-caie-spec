@prefix cx:   <https://w3id.org/og-caie/run/counterexample#> .
@prefix epo:  <https://w3id.org/og-caie/epo#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Counterexample for the S6 chain rule (R-12, R-18): an attestation about
# criterion cx:b that aggregates a determination made on cx:a. The verdict
# may be sincere, but the determination and its evidence bear on a, not b, and
# the plan never had b as an objective. Must fail on ogc:S6-Attestation and
# nothing else.

cx:person a prov:Agent, prov:Person .
cx:expert a prov:Agent, prov:Person .
cx:sut a prov:Agent, prov:SoftwareAgent, earl:TestSubject ; epo:version "v1" .
cx:checker a prov:Agent, prov:SoftwareAgent ; epo:version "0.27" .
cx:dso a epo:DsoRelease ; epo:version "r1" ; epo:approvedBy cx:expert ; prov:generatedAtTime "2026-08-01T00:00:00Z"^^xsd:dateTime .
cx:reqs a epo:RequirementSet ; epo:environment "stated" ; epo:systemUnderTest cx:sut ; prov:wasAttributedTo cx:person ; prov:generatedAtTime "2026-08-02T00:00:00Z"^^xsd:dateTime .
cx:R a epo:Requirement ; epo:partOf cx:reqs ; epo:text "r" .
cx:a a epo:AcceptanceCriterion ; prov:wasDerivedFrom cx:R ; epo:text "criterion a" ; epo:expectedResult "a shown" ; epo:weight 1 ; epo:minPassRate 0.9 .
cx:b a epo:AcceptanceCriterion ; prov:wasDerivedFrom cx:R ; epo:text "criterion b" ; epo:expectedResult "b shown" ; epo:weight 1 ; epo:minPassRate 0.9 .
cx:plan a epo:TestPlan ; epo:objective cx:a ; epo:means cx:probe ; prov:wasDerivedFrom cx:reqs ; prov:wasDerivedFrom cx:dso ;
    prov:wasAttributedTo cx:person ; prov:generatedAtTime "2026-08-03T00:00:00Z"^^xsd:dateTime .
cx:probe a epo:Probe ; epo:exercises cx:a ; epo:derivedFromDso cx:dso ; prov:generatedAtTime "2026-08-03T00:00:00Z"^^xsd:dateTime .
cx:check a epo:ConsistencyCheck ; earl:subject cx:probe ; earl:mode earl:automatic ; earl:assertedBy cx:checker ;
    earl:result [ a earl:TestResult ; earl:outcome earl:passed ] .
cx:session a epo:Session ; prov:wasAssociatedWith cx:sut ; prov:wasAssociatedWith cx:person ;
    prov:startedAtTime "2026-08-10T00:00:00Z"^^xsd:dateTime .
cx:turn a epo:Turn ; epo:inSession cx:session ; epo:turnIndex 1 ; prov:used cx:probe .
cx:response a epo:Response ; epo:text "a response" ; prov:wasGeneratedBy cx:turn ; prov:wasAttributedTo cx:sut .
cx:evidence a epo:Evidence ; epo:bearsOn cx:a ; prov:wasDerivedFrom cx:response ; epo:underPlan cx:plan ; prov:wasAttributedTo cx:person .
cx:determination a epo:Determination ; earl:test cx:a ; earl:subject cx:sut ; earl:mode earl:manual ; earl:assertedBy cx:expert ; prov:used cx:evidence ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] .

cx:attestation a epo:Attestation ;
    earl:test cx:b ; earl:subject cx:sut ; earl:mode earl:manual ; earl:assertedBy cx:expert ;
    prov:used cx:determination ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ;
    epo:appropriateness epo:appropriate ; epo:sufficiency epo:sufficient ;
    epo:step epo:determineAndAttest ;
    prov:endedAtTime "2026-08-11T09:00:00Z"^^xsd:dateTime .

# parties (R-21, R-23), so that only the shape named above fails
cx:sponsor a prov:Agent, prov:Organization ; epo:role epo:sponsorRole ; epo:isAccountable false .
cx:testing a prov:Agent, prov:Organization ; epo:role epo:testingOrganizationRole ; epo:independentOfAccountable true .
cx:accountable a prov:Agent, prov:Organization ; epo:role epo:accountableOrganizationRole .
cx:exec a prov:Agent, prov:Person ; epo:role epo:accountExecutiveRole ; prov:actedOnBehalfOf cx:testing .
cx:agreement a epo:ServiceAgreement ; epo:signedBy cx:sponsor ; epo:signedBy cx:exec ; prov:generatedAtTime "2026-07-31T00:00:00Z"^^xsd:dateTime ; epo:step epo:agree .
cx:person epo:role epo:evaluationOperatorRole ; prov:actedOnBehalfOf cx:testing .
cx:expert epo:role epo:domainExpertRole ; prov:actedOnBehalfOf cx:testing .
cx:reqs epo:underAgreement cx:agreement .
cx:assessment a epo:AppropriatenessAssessment ; earl:subject cx:reqs ; earl:assertedBy cx:expert ; epo:appropriateness epo:appropriate ; prov:endedAtTime "2026-08-02T01:00:00Z"^^xsd:dateTime .
